+
+pub(crate) fn diagnostic_closure(checker:&TypeChecker<'_>, c:&Closure, d:usize)->String {
+ if let Some(n)=c.literal(){return format!("{n:?}");}
+ let Some(id)=c.expression() else {return "?".into();};
+ if d==0 {return format!("E{}@{}",id.0,c.env.id());}
+ let sub=|i|diagnostic_closure(checker,&c.sibling(i,c.env.clone()),d-1);
+ match checker.expression(id) {
+ Some(Expr::BVar(i))=>match c.env.lookup(*i) {Some(EnvBinding::Closure(b))=>diagnostic_closure(checker,&b,d-1),Some(EnvBinding::Free(f))=>format!("FREE{}",f.0),v=>format!("BVAR{i}:{v:?}")},
+ Some(Expr::Const{name,levels})=>format!("C{}{:?}",name.0,levels),
+ Some(Expr::App{fun,arg})=>format!("({} {})",sub(*fun),sub(*arg)),
+ Some(Expr::Proj{type_name,index,structure})=>format!("PROJ{}.{}({})",type_name.0,index,sub(*structure)),
+ v=>format!("E{}@{}:{v:?}",id.0,c.env.id())
+ }
+}
