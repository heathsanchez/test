+
+fn diagnostic_closure(checker:&TypeChecker<'_>,c:&Closure,d:usize)->String {
+ if d==0 {return format!("E{}@{}",c.expr.0,c.env.id());}
+ match checker.expression(c.expr) {
+ Some(Expr::BVar(i))=>match c.env.lookup(*i) {Some(EnvBinding::Closure(b))=>diagnostic_closure(checker,&b,d-1),Some(EnvBinding::Free(f))=>format!("FREE{}",f.0),v=>format!("BVAR{i}:{v:?}")},
+ Some(Expr::Const{name,levels})=>format!("C{}{:?}",name.0,levels),
+ Some(Expr::App{fun,arg})=>format!("({} {})",diagnostic_closure(checker,&c.sibling(*fun,c.env.clone()),d-1),diagnostic_closure(checker,&c.sibling(*arg,c.env.clone()),d-1)),
+ Some(Expr::Proj{type_name,index,structure})=>format!("PROJ{}.{}({})",type_name.0,index,diagnostic_closure(checker,&c.sibling(*structure,c.env.clone()),d-1)),
+ v=>format!("E{}@{}:{v:?}",c.expr.0,c.env.id())
+ }
+}
+
+fn positive_projection_congruence(checker:&TypeChecker<'_>,l:&Neutral,r:&Neutral,budget:usize,depth:usize,context:&[TypeValue],cd:usize,attempts:&mut usize)->bool {
+ if *attempts==0||cd>=16||l.spine.len()!=r.spine.len(){return false;}
+ *attempts-=1;
+ let heads=match (&l.head,&r.head){
+ (NeutralHead::Projection{type_name:a,index:i,structure:s},NeutralHead::Projection{type_name:b,index:j,structure:t})=>a==b&&i==j&&positive_projection_congruence(checker,s,t,budget,depth,context,cd+1,attempts),
+ _=>compare_neutral_heads(checker,l,r,budget).is_proven(),
+ };
+ heads&&l.spine.iter().zip(&r.spine).all(|(a,b)|convert_in_context_with_congruence(checker,&TypeValue::Term(a.clone()),&TypeValue::Term(b.clone()),budget.min(1024),DeltaPolicy::GuardedSemanticFallback,depth,context,cd+1,attempts).is_proven())
+}
