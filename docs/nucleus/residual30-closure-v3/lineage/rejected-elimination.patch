+    let heads=match (&left.head,&right.head) {
+        (NeutralHead::Projection{type_name:lt,index:li,structure:ls},NeutralHead::Projection{type_name:rt,index:ri,structure:rs}) =>
+            lt==rt && li==ri && positive_neutral_congruence(checker,ls,rs,budget,depth,context,congruence_depth+1,attempts),
+        _=>compare_neutral_heads(checker,left,right,budget).is_proven(),
+    };
+    heads && left.spine.iter().zip(&right.spine).all(|(l,r)|
+        convert_in_context_with_congruence(checker,&TypeValue::Term(l.clone()),&TypeValue::Term(r.clone()),
+            budget.min(256),DeltaPolicy::GuardedSemanticFallback,depth,context,congruence_depth+1,attempts).is_proven())
+}
