import Submission

namespace Wide256Bench

open Submission

def laneOnes : Nat := 
def laneIndex : Nat := 
def mask32x256 : Nat := 
def low254 : Nat := 2 ^ 254 - 1

def wideProgression (x : Nat) : Nat :=
  x * laneOnes + stepConst * laneIndex

def compact256 (q0 : Nat) : Nat :=
  let q1 := (q0 ||| (q0 >>> 63)) &&& 
  let q2 := (q1 ||| (q1 >>> 126)) &&& 
  let q3 := (q2 ||| (q2 >>> 252)) &&& 
  let q4 := (q3 ||| (q3 >>> 504)) &&& 
  let q5 := (q4 ||| (q4 >>> 1008)) &&& 
  let q6 := (q5 ||| (q5 >>> 2016)) &&& 
  let q7 := (q6 ||| (q6 >>> 4032)) &&& 
  let q8 := (q7 ||| (q7 >>> 8064)) &&& 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
  q8

def wideInit (seed : Nat) : Nat :=
  let x := seed + 3 * stepConst
  let p := wideProgression x
  let u := (p ^^^ (p >>> 16)) &&& mask32x256
  let y := (u * 0x7feb352d) &&& mask32x256
  let v := (y ^^^ (y >>> 15)) &&& mask32x256
  let z := v * 0x846ca68b
  let sparse := (z >>> 31) &&& laneOnes
  1 + 4 * (compact256 sparse &&& low254)

def seeds : List Nat :=
  (List.range 400).map fun i => (i * 2654435761) &&& 0xffffffff

def runMany (f : Nat → Nat) : Nat :=
  seeds.foldl (fun acc s => acc ^^^ f s) 0

def main : IO Unit := do
  let t0 ← IO.monoNanosNow
  let a := runMany initPackedOctProgression
  let t1 ← IO.monoNanosNow
  let b := runMany wideInit
  let t2 ← IO.monoNanosNow
  IO.println s!"v25_ns={t1 - t0}"
  IO.println s!"wide256_ns={t2 - t1}"
  IO.println s!"checksum_v25={a}"
  IO.println s!"checksum_wide={b}"
  IO.println s!"equal_checksum={a == b}"

end Wide256Bench
