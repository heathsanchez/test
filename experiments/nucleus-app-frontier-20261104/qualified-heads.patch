+#[cfg(feature = "diagnostics")]
+thread_local! {
+    static TRACE_TARGET_CONVERSION: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+#[cfg(feature = "diagnostics")]
+pub(crate) struct TargetConversionTraceScope(Option<bool>);
+
+#[cfg(feature = "diagnostics")]
+impl Drop for TargetConversionTraceScope {
+    fn drop(&mut self) {
+        if let Some(previous) = self.0 {
+            TRACE_TARGET_CONVERSION.with(|flag| flag.set(previous));
+        }
+    }
+}
+
+#[cfg(feature = "diagnostics")]
+pub(crate) fn scoped_target_conversion_trace(enabled: bool) -> TargetConversionTraceScope {
+    if !enabled { return TargetConversionTraceScope(None); }
+    let previous = TRACE_TARGET_CONVERSION.with(|flag| flag.replace(true));
+    TargetConversionTraceScope(Some(previous))
+}
