+// Release immutable environment DAGs without recursively dropping every
+// parent or captured closure on the thread stack. Shared nodes keep their
+// existing Rc ownership; only uniquely owned nodes are opened and drained.
+impl Drop for EnvNode {
+    fn drop(&mut self) {
+        let EnvNode::Extend { parent, value, .. } = self else { return; };
+        if matches!(parent.0.as_ref(), EnvNode::Empty)
+            && matches!(value, EnvBinding::Free(_) | EnvBinding::NatLit(_)) {
+            return;
+        }
+        let empty = Rc::new(EnvNode::Empty);
+        let mut pending = Vec::new();
+        fn frame(frame: &mut EnvFrame, empty: &Rc<EnvNode>, pending: &mut Vec<Rc<EnvNode>>) {
+            if !matches!(frame.0.as_ref(), EnvNode::Empty) {
+                pending.push(std::mem::replace(&mut frame.0, empty.clone()));
+            }
+        }
+        fn neutral(mut value: Neutral, empty: &Rc<EnvNode>, pending: &mut Vec<Rc<EnvNode>>) {
+            loop {
+                for mut capture in value.spine {
+                    frame(&mut capture.env, empty, pending);
+                }
+                match value.head {
+                    NeutralHead::Projection { structure, .. } => value = *structure,
+                    NeutralHead::Free(_) | NeutralHead::Const { .. } => break,
+                }
+            }
+        }
+        fn drain(node: &mut EnvNode, empty: &Rc<EnvNode>, pending: &mut Vec<Rc<EnvNode>>) {
+            if let EnvNode::Extend { parent, value, .. } = node {
+                frame(parent, empty, pending);
+                match std::mem::replace(value, EnvBinding::Free(FreeId(0))) {
+                    EnvBinding::Closure(mut capture) => frame(&mut capture.env, empty, pending),
+                    EnvBinding::Neutral(value) => neutral(value, empty, pending),
+                    EnvBinding::Free(_) | EnvBinding::NatLit(_) => {}
+                }
+            }
+        }
+        drain(self, &empty, &mut pending);
+        while let Some(owner) = pending.pop() {
+            if let Ok(mut node) = Rc::try_unwrap(owner) {
+                drain(&mut node, &empty, &mut pending);
+            }
+        }
+    }
 }
 
