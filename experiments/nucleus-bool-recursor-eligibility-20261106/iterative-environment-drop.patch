+#[cfg(test)]
+mod deep_capture_cleanup_controls {
+    use super::*;
+    #[test]
+    fn nested_captured_closures_and_projection_owners_are_released_iteratively() {
+        std::thread::Builder::new().stack_size(128*1024).spawn(|| {
+            let mut captured=EnvFrame::empty();let mut witnesses=Vec::new();
+            for i in 0..20_000 {
+                captured=EnvFrame::empty().extend(Closure::new(ExprId(0),captured));
+                if i%1000==0 {witnesses.push(Rc::downgrade(&captured.0));}
+            }
+            let mut value=Neutral{head:NeutralHead::Free(FreeId(0)),spine:vec![Closure::new(ExprId(0),captured)]};
+            for _ in 0..20_000 {value=Neutral{head:NeutralHead::Projection{type_name:NameId(1),index:0,structure:Box::new(value)},spine:vec![]};}
+            let owner=EnvFrame::empty().extend_neutral(value);
+            drop(owner);
+            assert!(witnesses.iter().all(|weak|weak.upgrade().is_none()));
+        }).unwrap().join().unwrap();
+    }
