+#[cfg(test)]
+mod deep_environment_cleanup_regression {
+    use super::*;
+    #[test]
+    fn deep_captured_environment_graph_drops_on_a_small_stack() {
+        std::thread::Builder::new().stack_size(128*1024).spawn(|| {
+            let mut frame=EnvFrame::empty();
+            for i in 0..50_000 { frame=frame.extend_free(FreeId(i)); }
+            let retained=frame.clone();
+            let weak=Rc::downgrade(&frame.0);
+            drop(frame);assert!(weak.upgrade().is_some());
+            drop(retained);assert!(weak.upgrade().is_none());
+        }).unwrap().join().unwrap();
+    }
+}
