+            c.exact(b"},\"ie\":")?;HotRecord::Expr(c.number()?,Expr::Const{name,levels})
+        }
+        b'f' if numeric=>{
+            c.exact(b"{\"forallE\":")?;let(domain,body)=c.binder()?;
+            c.exact(b",\"ie\":")?;HotRecord::Expr(c.number()?,Expr::Pi{domain:ExprId(domain),body:ExprId(body)})
+        }
+        b'i'=>match *b.get(3)?{
+            b'e' if numeric=>{
+                c.exact(b"{\"ie\":")?;let id=c.number()?;
+                let expression=if c.take(b",\"sort\":") {Expr::Sort(LevelId(c.number()?))}
+                else if c.take(b",\"lam\":") {let(domain,body)=c.binder()?;Expr::Lam{domain:ExprId(domain),body:ExprId(body)}}
