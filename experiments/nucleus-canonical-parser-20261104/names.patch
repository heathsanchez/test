+            HotRecord::Expr(id,Expr::App{fun:ExprId(fun),arg:ExprId(arg)})
+        }
+        b'b' if numeric=>{
+            c.exact(b"{\"bvar\":")?;let value=c.number()?;c.exact(b",\"ie\":")?;
+            HotRecord::Expr(c.number()?,Expr::BVar(value))
+        }
