+//! Attribute actual non-Term alias memo hits to a source obligation.
+//! This metadata never supplies a typing/equality premise.
+use std::cell::RefCell;
+struct State{owner:String,stage:&'static str,sort:u64,pi:u64,samples:Vec<(u64,usize,&'static str)>}
+thread_local!{static CURRENT:RefCell<Option<State>>=const{RefCell::new(None)};}
+pub(crate)struct Scope{previous:Option<State>}
+impl Scope{pub(crate)fn enter(owner:String,stage:&'static str)->Self{let previous=CURRENT.with(|slot|slot.replace(Some(State{owner,stage,sort:0,pi:0,samples:vec![]})));Self{previous}}}
+impl Drop for Scope{fn drop(&mut self){let state=CURRENT.with(|slot|slot.replace(self.previous.take()));if let Some(s)=state{if s.sort+s.pi>0{eprintln!("NUCLEUS_ALIAS_RESULT_REUSE:{}",serde_json::json!({"diagnostic_only":true,"acceptance_authority":false,"owner":s.owner,"stage":s.stage,"sort_hits":s.sort,"pi_hits":s.pi,"samples":s.samples,"interpretation":"actual cache activation within owner; nested alternatives may not support final outcome"}));}}}}
+pub(crate)fn hit(expr:u64,depth:usize,kind:&'static str){CURRENT.with(|slot|{if let Some(s)=slot.borrow_mut().as_mut(){if kind=="Pi"{s.pi+=1}else{s.sort+=1};if s.samples.len()<8{s.samples.push((expr,depth,kind));}}});}
