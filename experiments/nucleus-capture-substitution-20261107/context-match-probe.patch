+//! Observation-only, stratified same-key context samples. No cache admission.
+use std::cell::RefCell;
+struct State{owner:String,stage:&'static str,events:u64,same_len:u64,extension:u64,contraction:u64,claims:usize,rows:Vec<serde_json::Value>}
+thread_local!{static CURRENT:RefCell<Option<State>>=const{RefCell::new(None)};}
+pub(crate)struct Scope{previous:Option<State>,active:bool}
+impl Scope{pub(crate)fn enter(owner:String,stage:&'static str)->Self{match CURRENT.try_with(|s|s.replace(Some(State{owner,stage,events:0,same_len:0,extension:0,contraction:0,claims:0,rows:vec![]}))){Ok(previous)=>Self{previous,active:true},Err(_)=>Self{previous:None,active:false}}}}
+impl Drop for Scope{fn drop(&mut self){if !self.active{return;}let previous=self.previous.take();if let Ok(Some(s))=CURRENT.try_with(|slot|slot.replace(previous)){eprintln!("NUCLEUS_CONTEXT_MATCH:{}",serde_json::json!({"diagnostic_only":true,"acceptance_authority":false,"owner":s.owner,"stage":s.stage,"events":s.events,"same_length_events":s.same_len,"extension_events":s.extension,"contraction_events":s.contraction,"claimed_samples":s.claims,"sampling":"first8 then every8192th same-key/context-mismatch slot event; at most128; 512 independent diagnostic steps/sample; no population estimate","rows":s.rows}));}}}
+pub(crate)fn active()->bool{CURRENT.try_with(|s|s.borrow().is_some()).unwrap_or(false)}
+pub(crate)fn claim(old:usize,new:usize)->Option<u64>{CURRENT.try_with(|slot|{let mut s=slot.borrow_mut();let s=s.as_mut()?;s.events=s.events.saturating_add(1);match old.cmp(&new){std::cmp::Ordering::Equal=>s.same_len+=1,std::cmp::Ordering::Less=>s.extension+=1,std::cmp::Ordering::Greater=>s.contraction+=1};if s.claims<128&&(s.events<=8||s.events%8192==0){s.claims+=1;Some(s.events)}else{None}}).ok().flatten()}
+pub(crate)fn record(value:serde_json::Value){let _=CURRENT.try_with(|slot|{if let Some(s)=slot.borrow_mut().as_mut(){if s.rows.len()<128{s.rows.push(value);}}});}
