+//! Fixed-size observation only. Counts overlap; none authorizes acceptance or measures fuel savings.
+use std::cell::RefCell;
+const NAMES:[&str;28]=["request", "depth_limit", "fuel_empty", "eligible", "ineligible", "context_over_64", "context_non_term", "source_grammar_excluded", "no_captured_policy", "slot_empty", "slot_key_mismatch", "slot_context_mismatch", "key_expr_mismatch", "key_env_mismatch", "key_levels_mismatch", "key_epoch_mismatch", "key_policy_mismatch", "hit_term", "hit_pi", "hit_sort", "completed_none", "completed_term", "completed_pi", "completed_sort", "payload_over_bound", "completion_epoch_or_policy_changed", "inserted", "no_reclaimable_slot"];
+struct State{owner:String,stage:&'static str,counts:[u64;28]}
+thread_local!{static CURRENT:RefCell<Option<State>>=const{RefCell::new(None)};}
+pub(crate)struct Scope{previous:Option<State>,active:bool}
+impl Scope{pub(crate)fn enter(owner:String,stage:&'static str)->Self{match CURRENT.try_with(|s|s.replace(Some(State{owner,stage,counts:[0;28]}))){Ok(previous)=>Self{previous,active:true},Err(_)=>Self{previous:None,active:false}}}}
+impl Drop for Scope{fn drop(&mut self){if !self.active{return;}let previous=self.previous.take();if let Ok(Some(s))=CURRENT.try_with(|slot|slot.replace(previous)){let counts=NAMES.iter().zip(s.counts).collect::<std::collections::BTreeMap<_,_>>();eprintln!("NUCLEUS_MEMO_PATH:{}",serde_json::json!({"owner":s.owner,"stage":s.stage,"diagnostic_only":true,"acceptance_authority":false,"counts":counts,"boundary":"overlapping request/slot/retention events; no work or saving conservation claim"}));}}}
+#[inline]pub(crate)fn event(index:usize){let _=CURRENT.try_with(|slot|{if let Some(s)=slot.borrow_mut().as_mut(){s.counts[index]=s.counts[index].saturating_add(1);}});}
