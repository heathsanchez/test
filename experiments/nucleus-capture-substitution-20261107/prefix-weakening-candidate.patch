+//! Actual exact-prefix Term reuse, diagnostic only.
+use std::cell::RefCell;
+struct State{owner:String,stage:&'static str,hits:u64,samples:Vec<(u64,usize,usize,bool)>}
+thread_local!{static CURRENT:RefCell<Option<State>>=const{RefCell::new(None)};}
+pub(crate)struct Scope{previous:Option<State>,active:bool}
+impl Scope{pub(crate)fn enter(owner:String,stage:&'static str)->Self{match CURRENT.try_with(|s|s.replace(Some(State{owner,stage,hits:0,samples:vec![]}))){Ok(previous)=>Self{previous,active:true},Err(_)=>Self{previous:None,active:false}}}}
+impl Drop for Scope{fn drop(&mut self){if !self.active{return;}let previous=self.previous.take();if let Ok(Some(s))=CURRENT.try_with(|slot|slot.replace(previous)){if s.hits>0{eprintln!("NUCLEUS_PREFIX_REUSE:{}",serde_json::json!({"owner":s.owner,"stage":s.stage,"hits":s.hits,"samples":s.samples,"acceptance_authority":false,"boundary":"actual cache activation; nested alternatives need not support final outcome"}));}}}}
+pub(crate)fn hit(expr:u64,old:usize,new:usize,strict:bool){let _=CURRENT.try_with(|slot|{if let Some(s)=slot.borrow_mut().as_mut(){s.hits=s.hits.saturating_add(1);if s.samples.len()<8{s.samples.push((expr,old,new,strict));}}});}
