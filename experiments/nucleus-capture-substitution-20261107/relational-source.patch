+#[cfg(test)]
+mod relational_source_substitution_tests {
+ use super::*;
+ fn fixture()->(IdTable<ExprId,Expr>,IdTable<LevelId,Level>,Environment){
+  let mut e=IdTable::default();let mut l=IdTable::default();l.insert(LevelId(0),Level::Zero).unwrap();
+  for(id,x)in[(0,Expr::Sort(LevelId(0))),(1,Expr::Const{name:NameId(1),levels:vec![]}),(2,Expr::BVar(0)),(3,Expr::BVar(1)),(4,Expr::Lam{domain:ExprId(0),body:ExprId(3)}),(5,Expr::Lam{domain:ExprId(0),body:ExprId(1)}),(6,Expr::Lam{domain:ExprId(0),body:ExprId(2)})]{e.insert(ExprId(id),x).unwrap();}(e,l,Environment::empty())
+ }
+ #[test]fn a_captured_constant_matches_direct_syntax_under_a_binder(){let(e,l,env)=fixture();let c=TypeChecker::new(&e,&l,&env);let a=c.closure(ExprId(4),EnvFrame::empty().extend(c.closure(ExprId(1),EnvFrame::empty())));let b=c.closure(ExprId(5),EnvFrame::empty());assert!(!c.instantiated_source_capture_congruence(&a,&b,&mut 4096));assert!(c.relational_source_substitution(&a,&b,&mut 4096));}
+ #[test]fn a_concrete_free_never_matches_a_new_virtual_binder(){let(e,l,env)=fixture();let c=TypeChecker::new(&e,&l,&env);let a=c.closure(ExprId(4),EnvFrame::empty().extend_free(FreeId(0)));let b=c.closure(ExprId(6),EnvFrame::empty());assert!(!c.relational_source_substitution(&a,&b,&mut 4096));}
+ #[test]fn captured_and_direct_lambdas_keep_distinct_lexical_scopes(){
+  let(mut e,l,env)=fixture();
+  e.insert(ExprId(10),Expr::Lam{domain:ExprId(0),body:ExprId(3)}).unwrap();
+  e.insert(ExprId(11),Expr::Lam{domain:ExprId(0),body:ExprId(6)}).unwrap();
+  e.insert(ExprId(12),Expr::Lam{domain:ExprId(0),body:ExprId(4)}).unwrap();
+  let c=TypeChecker::new(&e,&l,&env);
+  let captured=c.closure(ExprId(10),EnvFrame::empty().extend(c.closure(ExprId(6),EnvFrame::empty())));
+  assert!(c.relational_source_substitution(&captured,&c.closure(ExprId(11),EnvFrame::empty()),&mut 4096));
+  assert!(!c.relational_source_substitution(&captured,&c.closure(ExprId(12),EnvFrame::empty()),&mut 4096),"outer and inner tokens are distinct after asymmetric reclosure");
+ }
+ #[test]fn cyclic_source_exhausts_instead_of_receiving_a_coinductive_fact(){let(mut e,l,env)=fixture();e.insert(ExprId(99),Expr::App{fun:ExprId(99),arg:ExprId(1)}).unwrap();let c=TypeChecker::new(&e,&l,&env);let a=c.closure(ExprId(99),EnvFrame::empty());assert!(!c.relational_source_substitution(&a,&a,&mut 64));}
+ #[test]fn actual_universe_maps_are_compared_after_reclosure(){
+  let(mut e,mut l,env)=fixture();l.insert(LevelId(2),Level::Param(NameId(9))).unwrap();e.insert(ExprId(20),Expr::Const{name:NameId(2),levels:vec![LevelId(2)]}).unwrap();
+  let c=TypeChecker::new(&e,&l,&env);let a=Closure::with_levels(ExprId(20),EnvFrame::empty(),LevelSubstitution::new(vec![(NameId(9),LevelTerm::Zero)]));
+  let b=Closure::with_levels(ExprId(20),EnvFrame::empty(),LevelSubstitution::new(vec![(NameId(9),LevelTerm::Succ(Box::new(LevelTerm::Zero)))]));
+  assert!(!c.relational_source_substitution(&a,&b,&mut 4096));assert!(c.relational_source_substitution(&a,&a,&mut 4096));
+ }
