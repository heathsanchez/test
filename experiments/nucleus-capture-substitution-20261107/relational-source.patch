+    // Pure simultaneous substitution, with virtual AST binders represented
+    // by tokens distinct from every concrete FreeId in a captured closure.
+    // A stored capture owns its scope: crossing into it clears virtual slots.
+    pub(crate) fn relational_source_substitution(&self,left:&Closure,right:&Closure,remaining:&mut usize)->bool {
+        enum Subject { Term(Closure,Vec<u64>),Bound(u64),Free(FreeId),Nat(crate::nat::BigNat) }
+        fn resolve(c:&TypeChecker<'_>,mut subject:Subject,work:&mut usize)->Option<Subject>{
+            loop {
+                if !take_step(work){return None;}
+                let Subject::Term(term,slots)=subject else{return Some(subject);};
+                match c.expressions.get(term.expr)? {
+                    Expr::BVar(index)=>{
+                        let depth=u64::try_from(slots.len()).ok()?;
+                        if *index<depth{return Some(Subject::Bound(slots[slots.len()-1-usize::try_from(*index).ok()?]));}
+                        let index=*index-depth;let cost=usize::try_from(index).ok()?.checked_add(1)?;
+                        if *work<cost{return None;}*work-=cost;
+                        subject=match term.env.lookup_binding_ref(index)? {
+                            EnvBinding::Closure(value)=>Subject::Term(value.clone(),vec![]),
+                            EnvBinding::Free(free)=>Subject::Free(*free),
+                            EnvBinding::Neutral(Neutral{head:NeutralHead::Free(free),spine})if spine.is_empty()=>Subject::Free(*free),
+                            EnvBinding::NatLit(value)=>{let cost=value.limb_count();if *work<cost{return None;}*work-=cost;Subject::Nat(value.clone())},
+                            _=>return None,
+                        };
+                    }
+                    Expr::NatLit(value)=>{let cost=value.limb_count();if *work<cost{return None;}*work-=cost;return Some(Subject::Nat(value.clone()));}
+                    _=>return Some(Subject::Term(term,slots)),
+                }
+            }
+        }
+        fn push(work:&mut Vec<(Subject,Subject)>,a:&Closure,x:&[u64],ae:ExprId,b:&Closure,y:&[u64],be:ExprId,binder:Option<u64>,fuel:&mut usize)->bool {
+            let cost=1usize.saturating_add(x.len()).saturating_add(y.len()).saturating_add(usize::from(binder.is_some())*2);
+            if *fuel<cost{return false;}*fuel-=cost;
+            let(mut x,mut y)=(x.to_vec(),y.to_vec());if let Some(token)=binder{x.push(token);y.push(token);}
+            work.push((Subject::Term(a.sibling(ae,a.env.clone()),x),Subject::Term(b.sibling(be,b.env.clone()),y)));true
+        }
+        let mut work=vec![(Subject::Term(left.clone(),vec![]),Subject::Term(right.clone(),vec![]))];let mut next=0u64;
+        while let Some((a,b))=work.pop(){
+            let(Some(a),Some(b))=(resolve(self,a,remaining),resolve(self,b,remaining))else{return false;};
+            match(a,b){
+                (Subject::Bound(a),Subject::Bound(b))if a==b=>{},
+                (Subject::Free(a),Subject::Free(b))if a==b=>{},
+                (Subject::Nat(a),Subject::Nat(b))=>{let cost=a.limb_count().max(b.limb_count());if *remaining<cost{return false;}*remaining-=cost;if a!=b{return false;}},
+                (Subject::Term(a,x),Subject::Term(b,y))=>{
+                    let(Some(lhs),Some(rhs))=(self.expressions.get(a.expr),self.expressions.get(b.expr))else{return false;};
+                    match(lhs,rhs){
+                        (Expr::Sort(u),Expr::Sort(v))=>if !self.exact_instantiated_source_level(*u,&a.levels,*v,&b.levels,remaining){return false;},
+                        (Expr::Const{name:u,levels:p},Expr::Const{name:v,levels:q})if u==v&&p.len()==q.len()=>{
+                            for(u,v)in p.iter().zip(q){if !self.exact_instantiated_source_level(*u,&a.levels,*v,&b.levels,remaining){return false;}}
+                        },
+                        (Expr::App{fun:u,arg:p},Expr::App{fun:v,arg:q})=>{
+                            if !push(&mut work,&a,&x,*p,&b,&y,*q,None,remaining)||!push(&mut work,&a,&x,*u,&b,&y,*v,None,remaining){return false;}
+                        },
+                        (Expr::Lam{domain:u,body:p},Expr::Lam{domain:v,body:q})|(Expr::Pi{domain:u,body:p},Expr::Pi{domain:v,body:q})=>{
+                            let token=next;let Some(n)=next.checked_add(1)else{return false;};next=n;
+                            if !push(&mut work,&a,&x,*p,&b,&y,*q,Some(token),remaining)||!push(&mut work,&a,&x,*u,&b,&y,*v,None,remaining){return false;}
+                        },
+                        (Expr::Let{ty:u,value:p,body:m}|Expr::LetNondep{ty:u,value:p,body:m},Expr::Let{ty:v,value:q,body:n}|Expr::LetNondep{ty:v,value:q,body:n})=>{
+                            let token=next;let Some(next_token)=next.checked_add(1)else{return false;};next=next_token;
+                            if !push(&mut work,&a,&x,*m,&b,&y,*n,Some(token),remaining)||!push(&mut work,&a,&x,*p,&b,&y,*q,None,remaining)||!push(&mut work,&a,&x,*u,&b,&y,*v,None,remaining){return false;}
+                        },
+                        (Expr::Proj{type_name:u,index:i,structure:p},Expr::Proj{type_name:v,index:j,structure:q})if u==v&&i==j=>if !push(&mut work,&a,&x,*p,&b,&y,*q,None,remaining){return false;},
+                        (Expr::StrLit(u),Expr::StrLit(v))=>{let cost=u.len().max(v.len());if *remaining<cost{return false;}*remaining-=cost;if u!=v{return false;}},
+                        _=>return false,
+                    }
+                },
+                _=>return false,
+            }
+        }
+        true
     }
 
