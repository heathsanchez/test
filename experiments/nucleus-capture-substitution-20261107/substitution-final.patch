+        let mut probe=Self::with_level_substitution(self.expressions,self.levels,self.environment,self.level_substitution.clone()).with_delta_policy(self.delta_policy);
+        probe.strict_origin_probe=true;
+        probe.inherited_binding_lineage=Some(InheritedBindings{ledger:self.checked_binding_lineage.clone(),epoch:self.binding_revocation_epoch.clone(),captured_epoch:epoch});
+        probe.binding_revocation_epoch.set(epoch);
+        // These stores contain pure source support/freshness or checked
+        // operational reductions under the identical immutable authority.
+        // Context-dependent typing/conversion caches remain isolated.
+        probe.source_support=self.source_support.clone();
+        probe.source_opening_proofs=self.source_opening_proofs.clone();
