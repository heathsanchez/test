+        #[cfg(feature="diagnostics")]
+        let _trace_scope=trace.then(CaptureSourceFailureScope::enter);
+        let note=|stage:&str,budget:usize|{
+            #[cfg(feature="diagnostics")]
+            if trace{eprintln!("NUCLEUS_CHECKED_CAPTURE_PREMISE:source={}:stage={stage}:context={}:remaining={budget}:ledger={}:first={:?}",left.expr.0,context.len(),self.checked_binding_lineage.borrow().len(),CaptureSourceFailureScope::first());}
+        };
+        note("begin",*remaining);
