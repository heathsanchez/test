+ #[test]fn an_already_checked_capture_binding_supplies_its_actual_type(){
+  let(mut e,l,env)=fixture();e.insert(ExprId(11),Expr::App{fun:ExprId(5),arg:ExprId(4)}).unwrap();let c=TypeChecker::new(&e,&l,&env);let a=TypeValue::Term(c.closure(ExprId(1),EnvFrame::empty()));let ctx=vec![a.clone()];let inner=EnvFrame::empty().extend_free(FreeId(0));
+  let left=c.closure(ExprId(8),EnvFrame::empty().extend(c.closure(ExprId(11),inner.clone())));let right=c.closure(ExprId(8),EnvFrame::empty().extend(c.closure(ExprId(4),inner.clone())));
+  assert!(!c.checked_capture_substitution(&left,&right,&ctx,&mut 8192));
+  assert!(c.infer_in(ExprId(11),&ctx,&inner,&mut 8192,&mut HashMap::new()).is_proven());
+  c.retain_checked_binding(&left.env,a.clone(),&ctx);c.retain_checked_binding(&right.env,a,&ctx);
+  assert!(c.checked_capture_substitution(&left,&right,&ctx,&mut 8192),"actual node witnesses avoid recreating an unavailable inner origin");
+ }
