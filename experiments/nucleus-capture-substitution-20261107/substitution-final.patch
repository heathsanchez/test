+                    if a.expr==b.expr&&a.env.id()==b.env.id()&&a.levels.identity()==b.levels.identity(){continue;}
+                    // The actual immutable binding may already carry its
+                    // checked argument type in this protected Γ. Reuse that
+                    // source judgment before rebuilding the value's typing.
+                    if *remaining<cost{return false;}*remaining-=cost;
+                    note(&format!("capture-{index}-typing-begin"),*remaining);
