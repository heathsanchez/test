+#[cfg(test)]
+mod typed_capture_substitution_tests {
+ use super::*;
+ use crate::environment::ConstantDecl;
+ fn fixture()->(IdTable<ExprId,Expr>,IdTable<LevelId,Level>,Environment){
+  let mut e=IdTable::default();let mut l=IdTable::default();l.insert(LevelId(0),Level::Zero).unwrap();l.insert(LevelId(1),Level::Succ(LevelId(0))).unwrap();
+  for(id,x)in[(0,Expr::Sort(LevelId(1))),(1,Expr::Const{name:NameId(1),levels:vec![]}),(2,Expr::Const{name:NameId(2),levels:vec![]}),(3,Expr::Const{name:NameId(3),levels:vec![]}),(4,Expr::BVar(0)),(5,Expr::Lam{domain:ExprId(1),body:ExprId(4)}),(6,Expr::App{fun:ExprId(5),arg:ExprId(2)}),(7,Expr::Const{name:NameId(4),levels:vec![]}),(8,Expr::App{fun:ExprId(7),arg:ExprId(4)}),(9,Expr::Pi{domain:ExprId(1),body:ExprId(1)})]{e.insert(ExprId(id),x).unwrap();}
+  let env=Environment::empty().extend(NameId(1),ConstantDecl::axiom(vec![],ExprId(0))).unwrap().extend(NameId(2),ConstantDecl::axiom(vec![],ExprId(1))).unwrap().extend(NameId(3),ConstantDecl::axiom(vec![],ExprId(1))).unwrap().extend(NameId(4),ConstantDecl::axiom(vec![],ExprId(9))).unwrap();(e,l,env)
+ }
+ #[test]fn substitution_uses_checked_value_equality_not_capture_allocation(){let(e,l,env)=fixture();let c=TypeChecker::new(&e,&l,&env);let wrap=|id|c.closure(ExprId(8),EnvFrame::empty().extend(c.closure(ExprId(id),EnvFrame::empty())));let mut fuel=8192;let proven=c.checked_capture_substitution(&wrap(6),&wrap(2),&[],&mut fuel);assert!(proven,"fuel={fuel}");}
+ #[test]fn unequal_data_captures_cannot_supply_substitution_congruence(){let(e,l,env)=fixture();let c=TypeChecker::new(&e,&l,&env);let wrap=|id|c.closure(ExprId(8),EnvFrame::empty().extend(c.closure(ExprId(id),EnvFrame::empty())));assert!(!c.checked_capture_substitution(&wrap(2),&wrap(3),&[],&mut 8192));}
+ #[test]fn missing_origin_type_or_work_remains_unproved(){let(e,l,env)=fixture();let c=TypeChecker::new(&e,&l,&env);let open=c.closure(ExprId(4),EnvFrame::empty().extend_free(FreeId(9)));let wrap=|v|c.closure(ExprId(8),EnvFrame::empty().extend(v));let a=wrap(open);let b=wrap(c.closure(ExprId(2),EnvFrame::empty()));assert!(!c.checked_capture_substitution(&a,&b,&[],&mut 8192));assert!(!c.checked_capture_substitution(&b,&b,&[],&mut 0));}
+ #[test]fn checked_origin_context_and_revocation_are_preserved(){
+  let(mut e,l,env)=fixture();e.insert(ExprId(10),Expr::Const{name:NameId(5),levels:vec![]}).unwrap();e.insert(ExprId(11),Expr::App{fun:ExprId(5),arg:ExprId(4)}).unwrap();
+  let env=env.extend(NameId(5),ConstantDecl::axiom(vec![],ExprId(0))).unwrap();let c=TypeChecker::new(&e,&l,&env);
+  let a=TypeValue::Term(c.closure(ExprId(1),EnvFrame::empty()));let b=TypeValue::Term(c.closure(ExprId(10),EnvFrame::empty()));let ctx=vec![a.clone()];let frame=EnvFrame::empty().extend_free(FreeId(0));
+  c.retain_checked_binding(&frame,a.clone(),&ctx);
+  let wrap=|id|c.closure(ExprId(8),EnvFrame::empty().extend(c.closure(ExprId(id),frame.clone())));let left=wrap(11);let right=wrap(4);
+  assert!(c.checked_capture_substitution(&left,&right,&ctx,&mut 16384));
+  assert!(!c.checked_capture_substitution(&left,&right,&[b.clone()],&mut 16384));
+  assert!(c.checked_capture_substitution(&left,&right,&ctx,&mut 16384),"failed calls restore the non-reentry guard");
+  c.retain_checked_binding(&frame,b,&ctx);
+  assert!(!c.checked_capture_substitution(&left,&right,&ctx,&mut 16384),"revoked origin cannot inherit earlier equality");
+ }
+ #[test]fn changed_actual_universe_maps_do_not_supply_substitution(){let(e,l,env)=fixture();let c=TypeChecker::new(&e,&l,&env);let frame=EnvFrame::empty().extend(c.closure(ExprId(2),EnvFrame::empty()));let a=Closure::with_levels(ExprId(8),frame.clone(),LevelSubstitution::new(vec![(NameId(9),LevelTerm::Zero)]));let b=Closure::with_levels(ExprId(8),frame,LevelSubstitution::new(vec![(NameId(9),LevelTerm::Succ(Box::new(LevelTerm::Zero)))]));assert!(!c.checked_capture_substitution(&a,&b,&[],&mut 8192));}
+
+ #[test]fn authority_view_is_read_only_and_stale_views_decline(){
+  let(mut e,l,env)=fixture();e.insert(ExprId(10),Expr::Const{name:NameId(5),levels:vec![]}).unwrap();let env=env.extend(NameId(5),ConstantDecl::axiom(vec![],ExprId(0))).unwrap();
+  let c=TypeChecker::new(&e,&l,&env);let a=TypeValue::Term(c.closure(ExprId(1),EnvFrame::empty()));let b=TypeValue::Term(c.closure(ExprId(10),EnvFrame::empty()));let ctx=vec![a.clone()];let frame=EnvFrame::empty().extend_free(FreeId(0));c.retain_checked_binding(&frame,a.clone(),&ctx);
+  let mut probe=TypeChecker::new(&e,&l,&env);probe.strict_origin_probe=true;probe.inherited_binding_lineage=Some(InheritedBindings{ledger:c.checked_binding_lineage.clone(),epoch:c.binding_revocation_epoch.clone(),captured_epoch:c.binding_revocation_epoch.get()});
+  assert_eq!(probe.checked_type_of_bound_source(&frame,0,&ctx),Some(a.clone()));assert!(probe.checked_binding_lineage.borrow().is_empty());
+  probe.retain_checked_binding(&frame,b.clone(),&ctx);assert!(probe.checked_type_of_bound_source(&frame,0,&ctx).is_none());assert_eq!(c.checked_type_of_bound_source(&frame,0,&ctx),Some(a.clone()));assert_eq!(c.binding_revocation_epoch.get(),Some(0));
+  let local=EnvFrame::empty().extend_free(FreeId(1));probe.retain_checked_binding(&local,a.clone(),&ctx);assert_eq!(probe.checked_type_of_bound_source(&local,0,&ctx),Some(a));assert!(!c.checked_binding_lineage.borrow().contains_key(&local.id()));
+  c.retain_checked_binding(&frame,b,&ctx);assert!(probe.checked_type_of_bound_source(&local,0,&ctx).is_none(),"base epoch changes invalidate the entire borrowed view");
+ }
