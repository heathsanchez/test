+    /// Immediate same-source substitution congruence. Every nonidentical
+    /// captured value is independently typed and converted in this exact Γ.
+    /// No result enters the context-free literal-identity certificate table.
+    pub(crate) fn checked_capture_substitution(&self,left:&Closure,right:&Closure,context:&[TypeValue],remaining:&mut usize)->bool{
+        thread_local!{static ACTIVE:Cell<bool>=const{Cell::new(false)};}
+        if ACTIVE.with(|active|active.replace(true)){return false;}
+        struct Reset;impl Drop for Reset{fn drop(&mut self){ACTIVE.with(|active|active.set(false));}}
+        let _reset=Reset;
