+#[cfg(test)]
+mod captured_source_opening_budget_tests {
+ use super::*;
+ fn tree(e:&mut IdTable<ExprId,Expr>,next:&mut u64,height:usize)->ExprId{
+  if height==0{return ExprId(0);}
+  let domain=tree(e,next,height-1);let body=tree(e,next,height-1);let id=ExprId(*next);*next+=1;e.insert(id,Expr::Pi{domain,body}).unwrap();id
+ }
+ #[test]fn captured_lambda_can_establish_complete_support_with_its_supplied_budget(){
+  let mut e=IdTable::default();let mut l=IdTable::default();l.insert(LevelId(0),Level::Zero).unwrap();e.insert(ExprId(0),Expr::Sort(LevelId(0))).unwrap();
+  let root=tree(&mut e,&mut 1,10);e.insert(ExprId(5000),Expr::BVar(1)).unwrap();e.insert(ExprId(5001),Expr::Lam{domain:ExprId(0),body:ExprId(5000)}).unwrap();
+  let env=Environment::empty();let checker=TypeChecker::new(&e,&l,&env);let capture=checker.closure(root,EnvFrame::empty());let term=checker.closure(ExprId(5001),EnvFrame::empty().extend(capture));
+  let result=checker.infer_exact_closure_in_context(&term,&[],&mut 131072,0);assert!(result.is_some(),"closed captured source is safe; complete its mandatory support proof within the supplied allowance");
+ }
+}
