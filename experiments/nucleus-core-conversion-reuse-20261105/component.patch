+// Ordinary conversion evidence is scope-indexed VALUE equality only. It
+// grants neither term formation nor context-free source-capture authority.
+#[derive(Clone,Eq,PartialEq,Hash)]
+pub(crate)struct CompletedCoreConversionKey{
+ left:(ExprId,u64,usize),right:(ExprId,u64,usize),context_len:usize,depth:usize,congruence_depth:usize,
+ strict:bool,flags:[u64;2],epoch:u64,conversion_fallback:bool,inference_fallback:bool,
+}
+impl CompletedCoreConversionKey{fn set(&self)->usize{use std::hash::{Hash,Hasher};let mut h=std::collections::hash_map::DefaultHasher::new();self.hash(&mut h);(h.finish()as usize)%128}}
+struct CompletedCoreConversionFact{key:CompletedCoreConversionKey,left:Closure,right:Closure,context:Vec<Closure>}
+impl CompletedCoreConversionFact{
+ fn same_context(&self,context:&[TypeValue])->bool{self.context.len()==context.len()&&self.context.iter().zip(context).all(|(a,b)|matches!(b,TypeValue::Term(b)if(a.expr,a.env.id(),a.levels.identity())==(b.expr,b.env.id(),b.levels.identity())))}
+ fn relinquishable(&self)->bool{crate::value::captures_reclaimable(std::iter::once(&self.left).chain(std::iter::once(&self.right)).chain(self.context.iter()))}
+}
+struct CompletedCoreConversionMemo{slots:Box<[Option<CompletedCoreConversionFact>]>,hand:[u8;128]}
+impl Default for CompletedCoreConversionMemo{fn default()->Self{Self{slots:std::iter::repeat_with(||None).take(512).collect::<Vec<_>>().into_boxed_slice(),hand:[0;128]}}}
