+                            left_structure.env.id(),right_structure.env.id(),
+                            left_spine.len(),right_spine.len(),
+                        );
+                    }
+                }
                 let source_typed_pair =
                     crate::run_flags::present(crate::run_flags::Flag::ExperimentalSourcePairDepth8)
