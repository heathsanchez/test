+                                            }
+                                            None => {
+                                                path.push(format!("MISSING:bvar({index})@{}",current.env.id()));
+                                                break;
+                                            }
+                                        }
+                                    }
+                                    other => {
+                                        path.push(format!("TERMINAL:expr{}:frame{}:{other:?}",
+                                            current.expr.0,current.env.id()));
+                                        break;
+                                    }
+                                }
+                            }
+                            path
+                        };
+                        let left_path=capture_path(left_structure);
+                        let right_path=capture_path(right_structure);
