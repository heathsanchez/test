+                            c.env.lookup_with_node_id(*index)
+                        };
+                        let left_inner=deref_bvar(&left_binding);
+                        let right_inner=deref_bvar(&right_binding);
+                        let capture_path=|root:&Closure| {
+                            let mut current=root.clone();
