+                        );
+                        let right_formed=checker.checked_source_conversion(
+                            right_structure,right_structure,context,512,
+                        );
+                        let receiver_relation=checker.checked_source_conversion(
+                            left_structure,right_structure,context,2048,
+                        );
+                        let spine_relation=same_closure_spine_congruence_in_context(
+                            checker,left_spine,right_spine,512,depth,context,512,
+                        );
+                        eprintln!(
