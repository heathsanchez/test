+    /// Positive-only congruence of captured *values*, including different
+    /// source expressions already independently convertible in the SAME real
+    /// context. Identical source syntax is substituted only after every used
+    /// free capture and every referenced universe level has been accounted for.
+    ///
+    /// Unlike `source_capture_relation`, this can discharge a captured pair
+    /// by a checked, typed definitional-equality proof instead of requiring
+    /// identical source trees. Failed or unfinished subproofs never succeed.
+    pub(crate) fn checked_semantic_capture_congruence(
+        &self, left: &Closure, right: &Closure, context: &[TypeValue], budget: usize,
+    ) -> Judgment<()> {
+        let mut remaining=budget.min(16384);
+        type Key=(ExprId,u64,usize,ExprId,u64,usize);
+        let key=|a:&Closure,b:&Closure|->Key{
+            (a.expr,a.env.id(),a.levels.identity(),b.expr,b.env.id(),b.levels.identity())
+        };
+        let mut pending=vec![(left.clone(),right.clone(),false)];
+        let mut active=std::collections::HashSet::<Key>::new();
+        let mut complete=std::collections::HashSet::<Key>::new();
+        while let Some((a,b,finish))=pending.pop(){
+            if !take_step(&mut remaining) {
+                return Judgment::unknown("semantic-capture-work-budget");
+            }
+            if a==b {continue}
+            let pair=key(&a,&b);
+            if finish {
+                active.remove(&pair);
+                complete.insert(pair);
+                continue;
+            }
+            if complete.contains(&pair) {continue}
+            if !active.insert(pair) {
+                return Judgment::unknown("semantic-capture-active-cycle");
+            }
+            if let Some(support)=self.instantiated_source_support(&a,&b,&mut remaining) {
+                pending.push((a.clone(),b.clone(),true));
+                for (li,ri) in support {
+                    if !take_step(&mut remaining){
+                        return Judgment::unknown("semantic-capture-support-budget");
+                    }
+                    match (a.env.lookup_binding_ref(li),b.env.lookup_binding_ref(ri)) {
+                        (Some(EnvBinding::Free(x)),Some(EnvBinding::Free(y))) if x==y=>{},
+                        (Some(EnvBinding::Neutral(x)),Some(EnvBinding::Neutral(y))) if x==y=>{},
+                        (Some(EnvBinding::Neutral(Neutral{head:NeutralHead::Free(x),spine})),Some(EnvBinding::Free(y)))
+                            if spine.is_empty() && x==y=>{},
+                        (Some(EnvBinding::Free(x)),Some(EnvBinding::Neutral(Neutral{head:NeutralHead::Free(y),spine})))
+                            if spine.is_empty() && x==y=>{},
+                        (Some(EnvBinding::NatLit(x)),Some(EnvBinding::NatLit(y))) if x==y=>{},
+                        (Some(EnvBinding::Closure(x)),Some(EnvBinding::Closure(y)))=>
+                            pending.push((x.clone(),y.clone(),false)),
+                        _=>return Judgment::unknown("semantic-capture-unmatched-binding"),
+                    }
+                }
+                continue;
+            }
+            // Only a positive independently typed conversion permits
+            // crossing a real source-shape boundary. Budget is fully reserved
+            // and consumed even if the inner checker happens to be cheaper.
+            let grant=remaining.min(4096);
