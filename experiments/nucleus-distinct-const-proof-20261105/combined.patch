+    /// Independently checked Lean proof irrelevance for two *different*
+    /// constant-headed applications. Different theorem names are not
+    /// themselves equality evidence: both actual dependent application
+    /// telescopes must check, both result types must inhabit Prop, and those
+    /// instantiated proposition types must convert in the caller's context.
+    /// Any incomplete premise declines the trial.
+    pub(crate) fn certified_distinct_const_proof_irrelevance(
+        &self,
+        left: &Neutral,
+        right: &Neutral,
+        context: &[TypeValue],
+        budget: usize,
+        depth: usize,
+    ) -> bool {
+        if !crate::run_flags::present(crate::run_flags::Flag::ExperimentalDistinctConstProofIrrel)
+            || depth != context.len() || !(1..=16).contains(&depth)
+            || budget < 1024 || left.spine.len() > 12 || right.spine.len() > 12
+            || left.head == right.head
+            || !matches!(&left.head, NeutralHead::Const { .. })
+            || !matches!(&right.head, NeutralHead::Const { .. })
+        { return false; }
+        thread_local! {
+            static ACTIVE: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+        }
+        if ACTIVE.with(|active| active.replace(true)) { return false; }
+        struct TrialGuard;
+        impl Drop for TrialGuard {
+            fn drop(&mut self) { ACTIVE.with(|active| active.set(false)); }
+        }
+        let _guard = TrialGuard;
+        let probe = budget.min(4096);
+        let checked_type = |neutral: &Neutral| -> Option<TypeValue> {
+            let NeutralHead::Const { name, levels } = &neutral.head else { return None; };
+            let decl = self.environment.get(*name)?;
+            if decl.level_params.len() != levels.len() { return None; }
+            let substitution = decl.level_params.iter().copied()
+                .zip(levels.iter().cloned()).collect();
+            let mut current = TypeValue::Term(Closure::with_levels(
+                decl.ty, EnvFrame::empty(), LevelSubstitution::new(substitution),
+            ));
+            for argument in &neutral.spine {
+                let (domain, body) = self.pi_view(
+                    Judgment::proven(current, "distinct-proof-source-Pi"),
+                    probe.min(2048),
+                )?;
+                let mut remaining = probe.min(2048);
+                let actual = self.infer_exact_closure_in_context(
+                    argument, context, &mut remaining, 0,
+                )?;
+                if !crate::convert::convert_with_policy_in_context(
+                    self, &actual, &domain, remaining.min(1024),
+                    crate::convert::DeltaPolicy::GuardedSemanticFallback,
+                    depth, context,
+                ).is_proven() { return None; }
+                current = match body {
+                    PiBody::Fixed(binder, body) => {
+                        let mut fuel = probe.min(1024);
+                        self.instantiate_fixed_pi_body(&body, binder, argument, &mut fuel)?
+                    }
+                    PiBody::Closure(body) => TypeValue::Term(Closure::with_levels(
+                        body.expr, body.env.extend(argument.clone()), body.levels,
+                    )),
+                };
+            }
+            Some(current)
+        };
+        let Some(left_type) = checked_type(left) else { return false; };
+        let Some(right_type) = checked_type(right) else { return false; };
+        let formed_proposition = |ty: &TypeValue| -> bool {
+            let TypeValue::Term(proposition) = ty else { return false; };
+            self.checked_captured_prop_type_in_context(
+                proposition, context, probe.min(2048),
+            ).is_proven()
+        };
+        if !formed_proposition(&left_type) || !formed_proposition(&right_type) {
+            return false;
+        }
+        crate::convert::convert_with_policy_in_context(
+            self, &left_type, &right_type, probe.min(2048),
+            crate::convert::DeltaPolicy::GuardedSemanticFallback,
+            depth, context,
+        ).is_proven()
+    }
