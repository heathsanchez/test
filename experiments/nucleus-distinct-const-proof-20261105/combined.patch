+// Sufficient, source-owned projection congruence for long chains of stuck
+// receivers. Repeated structure projections are followed iteratively, but
+// different fields/owners, failed normalization, or an unproved base return
+// false. The caller may then try its existing iota path or return UNKNOWN;
+// a failed sufficient equality proof is never an inequality certificate.
+fn prove_projection_chain_congruence(
+    checker: &TypeChecker<'_>,
+    left_structure: &Closure,
+    right_structure: &Closure,
+    left_spine: &[Closure],
+    right_spine: &[Closure],
+    budget: usize,
+    depth: usize,
+    context: &[TypeValue],
+) -> bool {
+    if left_spine.len() != right_spine.len() || budget < 256 { return false; }
+    let mut remaining = budget;
+    let mut pending: Vec<(Closure, Closure)> = left_spine.iter().zip(right_spine)
+        .map(|(lhs, rhs)| (lhs.clone(), rhs.clone())).collect();
+    pending.push((left_structure.clone(), right_structure.clone()));
+    let mut visited = HashSet::new();
+    let machine = checker.machine();
+    while let Some((lhs, rhs)) = pending.pop() {
+        if lhs == rhs { continue; }
+        // Do not use coinductive equality for cyclic or repeatedly exposed
+        // source captures. A complete finite proof is required.
+        if !visited.insert((lhs.clone(), rhs.clone())) { return false; }
+        let probe = remaining.min(64);
+        if probe < 16 || remaining < 2 * probe { return false; }
+        remaining -= 2 * probe;
+        let lhs_value = machine.expose_for_conversion(
+            lhs.clone(), Transparency::Reducible, probe,
+        );
+        let rhs_value = machine.expose_for_conversion(
+            rhs.clone(), Transparency::Reducible, probe,
+        );
+        if let (
+            Some(Value::StuckProjection {
+                type_name: lhs_type, index: lhs_index,
+                structure: lhs_receiver, spine: lhs_args,
+            }),
+            Some(Value::StuckProjection {
+                type_name: rhs_type, index: rhs_index,
+                structure: rhs_receiver, spine: rhs_args,
+            }),
+        ) = (lhs_value.proven_value(), rhs_value.proven_value())
+        {
+            if lhs_type != rhs_type || lhs_index != rhs_index
+                || lhs_args.len() != rhs_args.len() { return false; }
+            pending.extend(lhs_args.iter().zip(rhs_args).map(|(a,b)| (a.clone(),b.clone())));
+            pending.push((lhs_receiver.clone(), rhs_receiver.clone()));
+            continue;
+        }
+        // A stuck projection against a different shape is not an immediate
+        // source congruence. Keep the original fallback authoritative.
+        if lhs_value.proven_value().is_none() || rhs_value.proven_value().is_none()
+            || matches!(lhs_value.proven_value(), Some(Value::StuckProjection { .. }))
+            || matches!(rhs_value.proven_value(), Some(Value::StuckProjection { .. }))
+        { return false; }
+        let allowance = remaining.min(4096);
+        if allowance < 16 { return false; }
+        remaining -= allowance;
+        if !convert_with_policy_in_context(
+            checker, &TypeValue::Term(lhs), &TypeValue::Term(rhs), allowance,
+            DeltaPolicy::GuardedSemanticFallback, depth, context,
+        ).is_proven() { return false; }
+    }
+    true
+}
