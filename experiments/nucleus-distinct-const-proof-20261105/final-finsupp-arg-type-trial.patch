+        assert!(checker.certified_distinct_const_proof_irrelevance(&p, &q, &context, 8, 1), "a completed exact-context witness may be reused");
+        assert!(!checker.certified_distinct_const_proof_irrelevance(&p, &head(5), &context, 8, 1), "another proposition may not inherit the warrant");
+        assert!(!checker.certified_distinct_const_proof_irrelevance(&p, &q, &[TypeValue::Sort(LevelTerm::Succ(Box::new(LevelTerm::Zero)))], 8, 1), "a changed context is not the same witness");
+    }
