+    fn only_completed_source_typed_proofs_can_be_reused_at_lower_budget() {
+        let _capture = crate::run_flags::enter();
+        let mut bits = crate::run_flags::captured_configuration().unwrap();
+        let index = crate::run_flags::Flag::ExperimentalDistinctConstProofIrrel as usize;
+        bits[index / 64] |= 1u64 << (index % 64);
+        let _flags = crate::run_flags::test_scope(bits);
+        let (expressions, levels, environment) = fixture();
+        let checker = TypeChecker::new(&expressions, &levels, &environment);
+        let context = vec![TypeValue::Sort(LevelTerm::Zero)];
+        let p = head(2);
