// Dogwood temporal guard for one exact Nucleus developmental lineage.
// This policy does NOT establish a Lean-kernel semantic gain. It only governs
// whether a candidate may cross the promotion boundary after the required
// evidence-bearing history has occurred in order.
@id("nucleus_application_promotion_guard_v1")
permit (
    principal,
    action == Nucleus::Action::"Admit",
    resource
)
when {
    context.input.campaign == "nucleus"
    && context.input.residual == "application-function-type"
    && context.input.authority == "98f87d9e66fb97987427d68180f51a653d626fdb"
    && context.input.corpus == "arena-193:10712869614"
    && context.input.originEvidence == "11065053909:15313a7fc30156ad75e090866a6d72510cc5194bd5dabc882110aaa182b0ff5e"
}
when temporal {
    formerly within 24h (
        Nucleus::Action::"FullReclosureGreen"::response{
            input.campaign: context.input.campaign,
            input.residual: context.input.residual,
            input.candidate: context.input.candidate,
            input.authority: context.input.authority,
            input.corpus: context.input.corpus,
            input.originEvidence: context.input.originEvidence
        }
        && formerly within 24h (
            Nucleus::Action::"ControlsGreen"::response{
                input.campaign: context.input.campaign,
                input.residual: context.input.residual,
                input.candidate: context.input.candidate,
                input.authority: context.input.authority,
                input.corpus: context.input.corpus,
                input.originEvidence: context.input.originEvidence
            }
            && formerly within 24h (
                Nucleus::Action::"CandidateDerived"::response{
                    input.campaign: context.input.campaign,
                    input.residual: context.input.residual,
                    input.candidate: context.input.candidate,
                    input.authority: context.input.authority,
                    input.corpus: context.input.corpus,
                    input.originEvidence: context.input.originEvidence
                }
                && formerly within 24h
                    Nucleus::Action::"ResidualObserved"::response{
                        input.campaign: context.input.campaign,
                        input.residual: context.input.residual,
                        input.authority: context.input.authority,
                        input.corpus: context.input.corpus,
                        input.originEvidence: context.input.originEvidence
                    }
            )
        )
    )
}
unless temporal {
    formerly within 24h
        Nucleus::Action::"CandidateRejected"::response{
            input.campaign: context.input.campaign,
            input.residual: context.input.residual,
            input.candidate: context.input.candidate,
            input.authority: context.input.authority,
            input.corpus: context.input.corpus,
            input.originEvidence: context.input.originEvidence
        }
};
