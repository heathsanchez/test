+// A staged derivation shares the checked prefix and owns only its delta.
+// The prefix is mutated only after every older snapshot has been dropped.
+#[derive(Clone, Debug)]
+struct ForkedConstants {
+    base: Rc<HashMap<NameId, ConstantDecl>>,
+    delta: HashMap<NameId, ConstantDecl>,
+}
+impl ForkedConstants {
+    fn new() -> Self {
+        Self {base:Rc::new(HashMap::new()),delta:HashMap::new()}
+    }
+    fn get(&self,name:&NameId)->Option<&ConstantDecl> {
+        self.delta.get(name).or_else(||self.base.get(name))
+    }
+    fn contains_key(&self,name:&NameId)->bool {self.get(name).is_some()}
+    fn insert(&mut self,name:NameId,declaration:ConstantDecl) {
+        if let Some(base)=Rc::get_mut(&mut self.base) {
+            base.extend(self.delta.drain());
+            base.insert(name,declaration);
+        } else {
+            self.delta.insert(name,declaration);
+        }
+    }
+    fn compact(&mut self) {
+        if let Some(base)=Rc::get_mut(&mut self.base) {
+            base.extend(self.delta.drain());
+        }
+    }
+    #[cfg(test)]
+    fn len(&self)->usize {self.base.len()+self.delta.len()}
+}
+
