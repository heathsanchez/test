+struct ExactTypingFact{_source:Closure,_context:Vec<Closure>,result:Closure}
+#[derive(Default)]
+struct ExactTypingMemo{
+ positive:HashMap<ExactTypingKey,ExactTypingFact>,
+ order:std::collections::VecDeque<ExactTypingKey>,
