+// C27 observer: sufficient, immutable-source syntactic/substitution equality
+// of an entire neutral spine. It deliberately uses only the pure relational
+// source substitution checker, not congruence caches or source-equality
+// retention. This returns diagnostic data, never a conversion judgment.
+#[cfg(feature="diagnostics")]
+#[cold]
+#[inline(never)]
+fn diagnostic_pre_iota_source_congruence(
+    checker:&TypeChecker<'_>, left:&Neutral, right:&Neutral, budget:usize,
+) -> (bool,usize,Option<usize>) {
+    if left.head!=right.head || left.spine.len()!=right.spine.len() {
+        return (false,0,None);
+    }
+    let mut remaining=budget;
+    for (index,(a,b)) in left.spine.iter().zip(&right.spine).enumerate() {
+        if a==b {continue;}
+        if !checker.relational_source_substitution(a,b,&mut remaining) {
+            return (false,budget-remaining,Some(index));
+        }
+    }
+    (true,budget-remaining,None)
+}
