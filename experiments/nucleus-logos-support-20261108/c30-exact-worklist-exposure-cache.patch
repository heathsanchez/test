+ #[test]fn source_major_cache_is_exact_and_mode_isolated(){
+  let es=expressions();let ls=IdTable::default();
+  let mut m=Machine::new(AuthorityId(1),&es,&ls,HashMap::new())
+   .with_nat_primitives(Some(primitives())).with_exposure_cache(new_exposure_cache());
+  m.source_major_cache_enabled=true;
+  m.native_completion.set(false);
+  m.worklist_major_probe.set(true);
+  m.exposure_fuel.set(Some(2048));
+  let original=Closure::new(ExprId(3),EnvFrame::empty());
+  let other=Closure::new(ExprId(4),EnvFrame::empty());
+  assert_eq!(m.expose_for_conversion(original.clone(),Transparency::Full,64).proven_value(),Some(&Value::NatLit(number("5"))));
+  assert_eq!(m.source_major_exposures.borrow().len(),1);
+  assert_eq!(m.expose_for_conversion(original.clone(),Transparency::Full,64).proven_value(),Some(&Value::NatLit(number("5"))));
+  assert_eq!(m.source_major_cache_hits.get(),1);
+  assert_eq!(m.expose_for_conversion(other,Transparency::Full,64).proven_value(),Some(&Value::NatLit(number("2"))));
+  assert_eq!(m.source_major_cache_hits.get(),1);
+  let different_capture=Closure::new(ExprId(3),EnvFrame::empty().extend_free(FreeId(99)));
+  assert_eq!(m.expose_for_conversion(different_capture,Transparency::Full,64).proven_value(),Some(&Value::NatLit(number("5"))));
+  assert_eq!(m.source_major_cache_hits.get(),1);
+  assert_eq!(m.source_major_exposures.borrow().len(),3);
+  m.native_completion.set(true);
+  assert_eq!(m.expose_for_conversion(original.clone(),Transparency::Full,64).proven_value(),Some(&Value::NatLit(number("5"))));
+  assert_eq!(m.source_major_cache_hits.get(),1);
+  m.native_completion.set(false);
+  m.worklist_major_probe.set(false);
+  assert_eq!(m.expose_for_conversion(original,Transparency::Full,64).proven_value(),Some(&Value::NatLit(number("5"))));
+  assert_eq!(m.source_major_cache_hits.get(),1);
+  m.exposure_fuel.set(Some(0));
+  assert!(m.expose_for_conversion(Closure::new(ExprId(3),EnvFrame::empty()),Transparency::Full,64).is_unknown());
+ }
  #[test]fn captured_subtraction_resumes_before_predecessor(){
   let es=expressions();let ls=IdTable::default();let m=Machine::new(AuthorityId(1),&es,&ls,HashMap::new()).with_nat_primitives(Some(primitives())).with_exposure_cache(new_exposure_cache());
   for(a,b,want)in[(1,1,"0"),(3,4,"2"),(4,3,"0")]{let result=m.expose(captured(a,b),Transparency::Reducible,128);assert_eq!(result.proven_value(),Some(&Value::NatLit(number(want))),"{result:?}");}
