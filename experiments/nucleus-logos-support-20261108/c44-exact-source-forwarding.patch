+#[cfg(test)]
+mod source_binding_forwarding_regression {
+    use super::*;
+
+    #[test]
+    fn exact_captured_bvar_chain_reuses_only_completed_source_forwarding() {
+        let mut expressions = IdTable::default();
+        expressions.insert(ExprId(0), Expr::BVar(0)).unwrap();
+        expressions.insert(ExprId(1), Expr::Const { name: NameId(101), levels: vec![] }).unwrap();
+        expressions.insert(ExprId(2), Expr::Const { name: NameId(102), levels: vec![] }).unwrap();
+        let levels = IdTable::default();
+        let cache = new_exposure_cache();
+        let mut machine = Machine::new(AuthorityId(881), &expressions, &levels, HashMap::new())
+            .with_exposure_cache(cache.clone());
+        machine.source_forwarding_enabled = true;
+        let chain = |constructor| {
+            let mut captured = Closure::new(constructor, EnvFrame::empty());
+            for _ in 0..90 {
+                captured = Closure::new(ExprId(0), EnvFrame::empty().extend(captured));
+            }
+            captured
+        };
+        let source = chain(ExprId(1));
+        let expected = Value::Neutral(Neutral {
+            head: NeutralHead::Const { name: NameId(101), levels: vec![] },
+            spine: vec![],
+        });
+        assert_eq!(
+            machine.expose_for_conversion(source.clone(), Transparency::Opaque, 512).proven_value(),
+            Some(&expected),
+            "source chain must be independently evaluable before any saved shortcut",
+        );
+        assert!(machine.source_forwarded.borrow().len() <= 16,
+            "the memo must retain a bounded number of path checkpoints, not every binder");
+        // Exclude the existing value cache: the new operation must retain
+        // only a fully traversed immutable source forwarding path, even if
+        // the later value itself remains an unfinished recursor.
+        cache.borrow_mut().values.clear();
+        assert_eq!(
+            machine.expose_for_conversion(source, Transparency::Opaque, 4).proven_value(),
+            Some(&expected),
+            "exact source forwarding should avoid replaying all 90 bindings",
+        );
+        assert!(machine.source_forward_hits.get()>0);
+        cache.borrow_mut().values.clear();
+        let different = chain(ExprId(2));
+        assert!(machine.expose_for_conversion(different.clone(), Transparency::Opaque, 4).is_unknown(),
+            "a distinct immutable capture must not inherit an earlier constructor");
+        assert!(matches!(machine.expose_for_conversion(different, Transparency::Opaque, 512).proven_value(),
+            Some(Value::Neutral(Neutral { head: NeutralHead::Const { name: NameId(102), .. }, spine })) if spine.is_empty()));
+        let trivial = Closure::new(ExprId(0), EnvFrame::empty().extend(
+            Closure::new(ExprId(1), EnvFrame::empty())));
+        assert_eq!(machine.expose_for_conversion(trivial.clone(), Transparency::Opaque, 16).proven_value(),Some(&expected));
+        assert!(!machine.source_forwarded.borrow().contains_key(&trivial),
+            "short binder substitutions must not consume the expensive cache");
+    }
