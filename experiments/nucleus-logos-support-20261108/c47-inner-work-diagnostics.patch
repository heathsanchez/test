+
+// Observation only: none of these counters is consulted to admit a proof,
+// allocate fuel, produce a constructor or shortcut a conversion.
+pub(crate) fn c47_reset() {
+    C47_EXPOSURE_TRANSITIONS.set(0);
+    C47_REPLAY_RESERVATIONS.set(0);
+    C47_RECURSOR_WORKLIST_STEPS.set(0);
+    C47_CONVERSION_PAIRS.set(0);
+    C47_EXPOSURE_SAMPLES.with(|samples|samples.borrow_mut().clear());
+}
+
+pub(crate) fn c47_exposure_transition(expression: u64) {
+    let n=C47_EXPOSURE_TRANSITIONS.get().saturating_add(1);
+    C47_EXPOSURE_TRANSITIONS.set(n);
+    if n%64==0 {
+        C47_EXPOSURE_SAMPLES.with(|samples| {
+            let mut saved=samples.borrow_mut();
+            if saved.len()<8192 || saved.contains_key(&expression) {
+                *saved.entry(expression).or_default()+=1;
+            }
+        });
+    }
+}
+
+pub(crate) fn c47_replay_reservation(count: usize) {
+    C47_REPLAY_RESERVATIONS.set(C47_REPLAY_RESERVATIONS.get().saturating_add(count as u64));
+}
+
+pub(crate) fn c47_recursor_worklist_step() {
+    C47_RECURSOR_WORKLIST_STEPS.set(C47_RECURSOR_WORKLIST_STEPS.get().saturating_add(1));
+}
+
+pub(crate) fn c47_conversion_pair() {
+    C47_CONVERSION_PAIRS.set(C47_CONVERSION_PAIRS.get().saturating_add(1));
+}
+
+pub(crate) fn c47_work_snapshot() -> (u64, u64, u64, u64) {
+    (
+        C47_EXPOSURE_TRANSITIONS.get(),
+        C47_REPLAY_RESERVATIONS.get(),
+        C47_RECURSOR_WORKLIST_STEPS.get(),
+        C47_CONVERSION_PAIRS.get(),
+    )
+}
+
+pub(crate) fn c47_top_source_exposures() -> Vec<(u64,u64)> {
+    let mut top=C47_EXPOSURE_SAMPLES.with(|samples|samples.borrow().iter()
+        .map(|(expr,hits)|(*expr,*hits)).collect::<Vec<_>>());
+    top.sort_unstable_by(|a,b|b.1.cmp(&a.1).then(a.0.cmp(&b.0)));
+    top.truncate(16);
+    top
 }
 
