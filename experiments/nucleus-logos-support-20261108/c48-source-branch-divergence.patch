+// Observer-only: this sequence never enters a proof, reduction, cache or fuel
+// branch. It is not a source-constructor certificate by itself.
+pub(crate) fn c48_start() {
+    C48_EVENTS.set(0);
+    C48_ACTIVE.set(true);
+}
+
+pub(crate) fn c48_stop() {
+    C48_ACTIVE.set(false);
+}
+
+pub(crate) fn c48_enabled() -> bool {
+    C48_ACTIVE.get() && C48_EVENTS.get() < 512
+}
+
+pub(crate) fn c48_ticket() -> Option<u64> {
+    if !c48_enabled() { return None; }
+    let seq = C48_EVENTS.get();
+    C48_EVENTS.set(seq + 1);
+    Some(seq)
+}
