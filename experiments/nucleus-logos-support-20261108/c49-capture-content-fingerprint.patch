+#[cfg(all(test, feature = "diagnostics"))]
+mod c49_diagnostic_content_fingerprint_controls {
+    use super::*;
+
+    #[test]
+    fn identical_rebuilt_captures_share_only_a_diagnostic_fingerprint() {
+        let first = EnvFrame::empty().extend(Closure::new(ExprId(5), EnvFrame::empty()));
+        let second = EnvFrame::empty().extend(Closure::new(ExprId(5), EnvFrame::empty()));
+        assert_ne!(first.id(), second.id());
+        assert_ne!(first, second, "binder-origin identities must remain distinct");
+        assert_eq!(first.diagnostic_content_fingerprint(), second.diagnostic_content_fingerprint());
+        let altered = EnvFrame::empty().extend(Closure::new(ExprId(6), EnvFrame::empty()));
+        assert_ne!(first.diagnostic_content_fingerprint(), altered.diagnostic_content_fingerprint());
+    }
+
+    #[test]
+    fn distinct_lexical_frees_and_native_numbers_do_not_merge() {
+        let left = EnvFrame::empty().extend_free(FreeId(3));
+        let right = EnvFrame::empty().extend_free(FreeId(4));
+        assert_ne!(left.diagnostic_content_fingerprint(), right.diagnostic_content_fingerprint());
+        let one = EnvFrame::empty().extend_nat_literal(BigNat::parse_decimal("1").unwrap());
+        let two = EnvFrame::empty().extend_nat_literal(BigNat::parse_decimal("2").unwrap());
+        assert_ne!(one.diagnostic_content_fingerprint(), two.diagnostic_content_fingerprint());
+    }
