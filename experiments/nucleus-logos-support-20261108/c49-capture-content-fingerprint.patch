+    /// C49 observer only. Hash the *contents* of a captured environment,
+    /// recursively including closures, neutrals, universes, and free names.
+    /// This fingerprint is a diagnostic grouping hint, NEVER an equality or
+    /// binder-origin certificate. It is deliberately bounded and fail-closed.
+    #[cfg(feature = "diagnostics")]
+    pub(crate) fn diagnostic_content_fingerprint(&self) -> Option<u64> {
+        use std::collections::hash_map::DefaultHasher;
+        enum Node<'a> {
+            Frame(&'a EnvFrame),
+            Binding(&'a EnvBinding),
+            Closure(&'a Closure),
+            Neutral(&'a Neutral),
+        }
+        let mut hasher = DefaultHasher::new();
+        let mut pending = vec![Node::Frame(self)];
+        let mut inspected = 0usize;
+        while let Some(node) = pending.pop() {
+            inspected += 1;
+            if inspected > 8192 { return None; }
+            match node {
+                Node::Frame(frame) => match frame.0.as_ref() {
+                    EnvNode::Empty => 0u8.hash(&mut hasher),
+                    EnvNode::Extend { parent, value, .. } => {
+                        1u8.hash(&mut hasher);
+                        pending.push(Node::Frame(parent));
+                        pending.push(Node::Binding(value));
+                    }
+                },
+                Node::Binding(binding) => match binding {
+                    EnvBinding::Closure(capture) => {
+                        2u8.hash(&mut hasher);
+                        pending.push(Node::Closure(capture));
+                    }
+                    EnvBinding::Neutral(neutral) => {
+                        3u8.hash(&mut hasher);
+                        pending.push(Node::Neutral(neutral));
+                    }
+                    EnvBinding::Free(free) => {
+                        4u8.hash(&mut hasher);
+                        free.hash(&mut hasher);
+                    }
+                    EnvBinding::NatLit(number) => {
+                        5u8.hash(&mut hasher);
+                        number.hash(&mut hasher);
+                    }
+                },
+                Node::Closure(capture) => {
+                    6u8.hash(&mut hasher);
+                    capture.expr.hash(&mut hasher);
+                    // Hash of a substitution is its structural-entry digest,
+                    // not its Rc address (never used as checker authority).
+                    capture.levels.hash(&mut hasher);
+                    pending.push(Node::Frame(&capture.env));
+                }
+                Node::Neutral(neutral) => {
+                    7u8.hash(&mut hasher);
+                    match &neutral.head {
+                        NeutralHead::Free(free) => {
+                            8u8.hash(&mut hasher);
+                            free.hash(&mut hasher);
+                        }
+                        NeutralHead::Const { name, levels } => {
+                            9u8.hash(&mut hasher);
+                            name.hash(&mut hasher);
+                            levels.hash(&mut hasher);
+                        }
+                        NeutralHead::Projection { type_name, index, structure } => {
+                            10u8.hash(&mut hasher);
+                            type_name.hash(&mut hasher);
+                            index.hash(&mut hasher);
+                            pending.push(Node::Neutral(structure));
+                        }
+                    }
+                    neutral.spine.len().hash(&mut hasher);
+                    for capture in neutral.spine.iter().rev() {
+                        pending.push(Node::Closure(capture));
+                    }
+                }
+            }
+        }
+        Some(hasher.finish())
+    }
 }
 
