+// Independent from C48's first-512 source-transition limit: failures at the
+// very end of the root judgment must remain observable. No kernel result or
+// fuel branch is permitted to read these counters.
+pub(crate) fn c50_loss_ticket() -> Option<u64> {
+    if !C48_ACTIVE.get() || C50_LOSS_EVENTS.get() >= 256 { return None; }
+    let seq = C50_LOSS_EVENTS.get();
+    C50_LOSS_EVENTS.set(seq + 1);
+    Some(seq)
+}
