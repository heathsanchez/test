+    #[test]
+    fn completed_exact_result_is_observed_across_different_full_frames() {
+        let mut shadow=LogosProjectionShadow::default();
+        let k=key(10,vec![sort()]);
+        assert!(!shadow.observe(k.clone(),31,Some(&sort()),|_,_|None));
+        assert!(shadow.observe(k,32,Some(&sort()),|_,_|None));
+        assert_eq!(shadow.cross_frame_same_result,1);
+    }
+    #[test]
+    fn changed_binding_or_context_never_counts_as_safe_reuse() {
+        let mut shadow=LogosProjectionShadow::default();
+        assert!(!shadow.observe(key(10,vec![sort()]),31,Some(&sort()),|_,_|None));
+        assert!(!shadow.observe(key(11,vec![sort()]),32,Some(&sort()),|_,_|None));
+        assert!(!shadow.observe(key(10,vec![TypeValue::Sort(crate::level::succ(LevelTerm::Zero))]),33,Some(&sort()),|_,_|None));
+        assert_eq!(shadow.cross_frame_same_result,0);
+    }
+    #[test]
+    fn failed_derivations_and_changed_results_do_not_authorize_same_result() {
+        let mut shadow=LogosProjectionShadow::default();
+        let k=key(10,vec![sort()]);
+        assert!(!shadow.observe(k.clone(),31,None,|_,_|None));
+        assert!(!shadow.observe(k.clone(),32,Some(&sort()),|_,_|None));
+        let other=TypeValue::Sort(crate::level::succ(LevelTerm::Zero));
