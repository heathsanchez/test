+#[cfg(feature="diagnostics")]
+#[derive(Clone,Debug,Eq,Hash,PartialEq)]
+struct LogosProjectionKey{
+    checker:u64,source:ExprId,binding_nodes:Vec<u64>,context:Vec<TypeValue>,
+    flags:Option<[u64;2]>,epoch:Option<u64>,
+}
+#[cfg(feature="diagnostics")]
+struct LogosProjectionFact{frame:u64,result:TypeValue}
+// Pure structural identity: a matching persistent environment node names the
+// same immutable binding, not a guess that equal-looking FreeIds are equal.
+// Missing or out-of-range captures never count as the same.
+#[cfg(feature="diagnostics")]
+fn logos_result_nodes_equal(a:&Closure,b:&Closure,support:&[u64])->Option<bool>{
+    for index in support{
+        let left=a.env.lookup_with_node_id(*index)?.0;
+        let right=b.env.lookup_with_node_id(*index)?.0;
+        if left!=right{return Some(false);}
+    }
+    Some(true)
+}
+// Observe a *predictive* prerequisite: whether all bindings a prior type
+// closure actually reads are already reachable from the new caller's input
+// frame. The current result is not used in this computation. A positive
+// answer is a necessary structural condition, NOT a transported type proof.
+#[cfg(feature="diagnostics")]
+fn logos_result_node_membership_in_caller(
+    prior:&Closure,caller:&EnvFrame,support:&[u64],
+)->Option<(bool,bool)>{
+    let mut same_index=true;
+    let mut all_present=true;
+    for index in support{
+        let id=prior.env.lookup_with_node_id(*index)?.0;
+        if caller.lookup_with_node_id(*index).map(|(node,_)|node)!=Some(id){
+            same_index=false;
+        }
+        let mut found=false;
+        for current_index in 0..=512u64{
+            match caller.lookup_with_node_id(current_index){
+                Some((node,_))if node==id=>{found=true;break},
+                Some(_)=>{},
+                None=>break,
+            }
+        }
+        if !found{all_present=false;}
+    }
+    Some((same_index,all_present))
+}
+#[cfg(feature="diagnostics")]
+#[derive(Default)]
+struct LogosProjectionShadow{
+    seen:HashMap<LogosProjectionKey,LogosProjectionFact>,
+    observed:usize,complete:usize,unknown:usize,capacity_rejections:usize,
+    cross_frame_same_result:usize,cross_frame_different_result:usize,
+    same_frame_prior:usize,
+    prior_sort:usize,prior_closed_term:usize,prior_captured_term:usize,prior_pi:usize,
+    changed_only_term_capture:usize,changed_term_levels:usize,
+    changed_term_expression:usize,changed_nonterm_shape:usize,
+    capture_result_closed:usize,capture_result_open:usize,capture_result_unknown:usize,
+    capture_result_open_same_nodes:usize,capture_result_open_changed_nodes:usize,
+    prereuse_same_index_in_caller:usize,prereuse_member_only_in_caller:usize,
+    prereuse_result_binding_absent_in_caller:usize,
+    fast_source_binding_node_skips:usize,
+}
+#[cfg(feature="diagnostics")]
+impl LogosProjectionShadow{
+    fn observe<F:FnOnce(&Closure,&Closure)->Option<(bool,bool,bool,bool)>>(&mut self,key:LogosProjectionKey,
+        frame:u64,result:Option<&TypeValue>,capture_support:F)->bool{
+        self.observed+=1;
+        let Some(result)=result else{self.unknown+=1;return false;};
+        self.complete+=1;
+        if let Some(prior)=self.seen.get(&key){
+            if prior.frame==frame{self.same_frame_prior+=1;return false;}
+            if prior.result==*result{
+                self.cross_frame_same_result+=1;
+                match result{
+                    TypeValue::Sort(_)=>self.prior_sort+=1,
+                    TypeValue::Term(c)if c.env.id()==0=>self.prior_closed_term+=1,
+                    TypeValue::Term(_)=>self.prior_captured_term+=1,
+                    TypeValue::Pi{..}=>self.prior_pi+=1,
+                }
+                return true;
+            }
+            self.cross_frame_different_result+=1;
+            match (&prior.result,result){
+                (TypeValue::Term(a),TypeValue::Term(b))if a.expr==b.expr&&a.levels==b.levels=>{
+                    self.changed_only_term_capture+=1;
+                    match capture_support(a,b){
+                        Some((true,_,_,_))=>self.capture_result_closed+=1,
+                        Some((false,true,same_index,present))=>{
+                            self.capture_result_open+=1;
+                            self.capture_result_open_same_nodes+=1;
+                            if same_index{self.prereuse_same_index_in_caller+=1;}
+                            else if present{self.prereuse_member_only_in_caller+=1;}
+                            else{self.prereuse_result_binding_absent_in_caller+=1;}
+                        },
+                        Some((false,false,_,_))=>{
+                            self.capture_result_open+=1;
+                            self.capture_result_open_changed_nodes+=1;
+                        },
+                        None=>self.capture_result_unknown+=1,
+                    }
+                },
+                (TypeValue::Term(a),TypeValue::Term(b))if a.expr==b.expr=>self.changed_term_levels+=1,
+                (TypeValue::Term(_),TypeValue::Term(_))=>self.changed_term_expression+=1,
+                _=>self.changed_nonterm_shape+=1,
+            }
+            return false;
+        }
+        if self.seen.len()<20000{self.seen.insert(key,LogosProjectionFact{frame,result:result.clone()});}
+        else{self.capacity_rejections+=1;}
+        false
+    }
+}
