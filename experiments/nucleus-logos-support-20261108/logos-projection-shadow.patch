+#[cfg(all(test,feature="diagnostics"))]
+mod logos_projection_shadow_controls {
+    use super::*;
+    fn sort() -> TypeValue { TypeValue::Sort(LevelTerm::Zero) }
+    fn key(binding:u64, context:Vec<TypeValue>) -> LogosProjectionKey {
+        LogosProjectionKey { checker:1, source:ExprId(2157), binding_nodes:vec![binding],
+            context, flags:Some([3,5]), epoch:Some(7) }
+    }
+    #[test]
+    fn completed_exact_result_is_observed_across_different_full_frames() {
+        let mut shadow=LogosProjectionShadow::default();
+        let k=key(10,vec![sort()]);
+        assert!(!shadow.observe(k.clone(),31,Some(&sort())));
+        assert!(shadow.observe(k,32,Some(&sort())));
+        assert_eq!(shadow.cross_frame_same_result,1);
+    }
+    #[test]
+    fn changed_binding_or_context_never_counts_as_safe_reuse() {
+        let mut shadow=LogosProjectionShadow::default();
+        assert!(!shadow.observe(key(10,vec![sort()]),31,Some(&sort())));
+        assert!(!shadow.observe(key(11,vec![sort()]),32,Some(&sort())));
+        assert!(!shadow.observe(key(10,vec![TypeValue::Sort(crate::level::succ(LevelTerm::Zero))]),33,Some(&sort())));
+        assert_eq!(shadow.cross_frame_same_result,0);
+    }
+    #[test]
+    fn failed_derivations_and_changed_results_do_not_authorize_same_result() {
+        let mut shadow=LogosProjectionShadow::default();
+        let k=key(10,vec![sort()]);
+        assert!(!shadow.observe(k.clone(),31,None));
+        assert!(!shadow.observe(k.clone(),32,Some(&sort())));
+        let other=TypeValue::Sort(crate::level::succ(LevelTerm::Zero));
+        assert!(!shadow.observe(k,33,Some(&other)));
+        assert_eq!(shadow.cross_frame_same_result,0);
+        assert_eq!(shadow.cross_frame_different_result,1);
+        assert_eq!(shadow.changed_nonterm_shape,1);
+    }
+    #[test]
+    fn revocation_epoch_and_capability_configuration_are_separate() {
+        let mut shadow=LogosProjectionShadow::default();
+        let k=key(10,vec![sort()]);
+        assert!(!shadow.observe(k.clone(),31,Some(&sort())));
+        let mut newer=k.clone();newer.epoch=Some(8);
+        let mut altered=k;altered.flags=Some([3,6]);
+        assert!(!shadow.observe(newer,32,Some(&sort())));
+        assert!(!shadow.observe(altered,33,Some(&sort())));
+        assert_eq!(shadow.cross_frame_same_result,0);
+    }
+}
