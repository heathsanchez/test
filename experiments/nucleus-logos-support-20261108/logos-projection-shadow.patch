+#[cfg(feature="diagnostics")]
+#[derive(Clone,Debug,Eq,Hash,PartialEq)]
+struct LogosProjectionKey{
+    checker:usize,source:ExprId,binding_nodes:Vec<u64>,context:Vec<TypeValue>,
+    flags:Option<[u64;2]>,epoch:Option<u64>,
+}
+#[cfg(feature="diagnostics")]
+struct LogosProjectionFact{frame:u64,result:TypeValue}
+#[cfg(feature="diagnostics")]
+#[derive(Default)]
+struct LogosProjectionShadow{
+    seen:HashMap<LogosProjectionKey,LogosProjectionFact>,
+    observed:usize,complete:usize,unknown:usize,capacity_rejections:usize,
+    cross_frame_same_result:usize,cross_frame_different_result:usize,
+    same_frame_prior:usize,
+    prior_sort:usize,prior_closed_term:usize,prior_captured_term:usize,prior_pi:usize,
+    changed_only_term_capture:usize,changed_term_levels:usize,
+    changed_term_expression:usize,changed_nonterm_shape:usize,
+}
+#[cfg(feature="diagnostics")]
+impl LogosProjectionShadow{
+    fn observe(&mut self,key:LogosProjectionKey,frame:u64,result:Option<&TypeValue>)->bool{
+        self.observed+=1;
+        let Some(result)=result else{self.unknown+=1;return false;};
+        self.complete+=1;
+        if let Some(prior)=self.seen.get(&key){
+            if prior.frame==frame{self.same_frame_prior+=1;return false;}
+            if prior.result==*result{
+                self.cross_frame_same_result+=1;
+                match result{
+                    TypeValue::Sort(_)=>self.prior_sort+=1,
+                    TypeValue::Term(c)if c.env.id()==0=>self.prior_closed_term+=1,
+                    TypeValue::Term(_)=>self.prior_captured_term+=1,
+                    TypeValue::Pi{..}=>self.prior_pi+=1,
+                }
+                return true;
+            }
+            self.cross_frame_different_result+=1;
+            match (&prior.result,result){
+                (TypeValue::Term(a),TypeValue::Term(b))if a.expr==b.expr&&a.levels==b.levels=>self.changed_only_term_capture+=1,
+                (TypeValue::Term(a),TypeValue::Term(b))if a.expr==b.expr=>self.changed_term_levels+=1,
+                (TypeValue::Term(_),TypeValue::Term(_))=>self.changed_term_expression+=1,
+                _=>self.changed_nonterm_shape+=1,
+            }
+            return false;
+        }
+        if self.seen.len()<20000{self.seen.insert(key,LogosProjectionFact{frame,result:result.clone()});}
+        else{self.capacity_rejections+=1;}
+        false
+    }
+}
+#[cfg(feature="diagnostics")]
+impl Drop for LogosProjectionShadow{
+    fn drop(&mut self){if self.observed!=0{
+        eprintln!("NUCLEUS_LOGOS_PROJECTION_SHADOW:{}",serde_json::json!({
+            "diagnostic_only":true,"acceptance_authority":false,
+            "full_context_in_key":true,"checked_support_required":true,
+            "observed":self.observed,"complete":self.complete,"unknown":self.unknown,
+            "distinct_keys":self.seen.len(),"capacity_rejections":self.capacity_rejections,
+            "cross_frame_same_result":self.cross_frame_same_result,
+            "cross_frame_different_result":self.cross_frame_different_result,
+            "same_frame_prior":self.same_frame_prior,
+            "prior_sort":self.prior_sort,"prior_closed_term":self.prior_closed_term,
+            "prior_captured_term":self.prior_captured_term,"prior_pi":self.prior_pi,
+            "changed_only_term_capture":self.changed_only_term_capture,
+            "changed_term_levels":self.changed_term_levels,
+            "changed_term_expression":self.changed_term_expression,
+            "changed_nonterm_shape":self.changed_nonterm_shape,
+        }));
+    }}
+}
+#[cfg(feature="diagnostics")]
+thread_local!{static LOGOS_PROJECTION_SHADOW:RefCell<LogosProjectionShadow>=RefCell::new(LogosProjectionShadow::default());}
