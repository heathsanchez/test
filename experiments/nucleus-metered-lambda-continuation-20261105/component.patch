+thread_local!{static PROJECTION_CHAIN_ACTIVE:std::cell::Cell<bool>=const{std::cell::Cell::new(false)};}
+// Finite sufficient VALUE congruence only. This path starts no new Core
+// conversion or typing trial; non-structural bases require completed evidence.
+fn metered_projection_chain(checker:&TypeChecker<'_>,left:&Closure,right:&Closure,left_args:&[Closure],right_args:&[Closure],work:&mut usize,depth:usize,context:&[TypeValue])->bool{
+    if *work<256||depth!=context.len()||context.len()>64||context.iter().any(|x|!matches!(x,TypeValue::Term(_)))||checker.strict_source_origin_probe()||left_args.len()!=right_args.len(){return false}
+    if !PROJECTION_CHAIN_ACTIVE.try_with(|active|!active.replace(true)).unwrap_or(false){return false}
+    struct Trial;impl Drop for Trial{fn drop(&mut self){let _=PROJECTION_CHAIN_ACTIVE.try_with(|active|active.set(false));}}
+    let _trial=Trial;
+    // An opened binder changes Gamma, so memo identity MUST include the
+    // exact local scope. Separate sibling scopes never share unproved facts.
+    type Key=(crate::id::ExprId,u64,usize,crate::id::ExprId,u64,usize,usize);
+    fn key(a:&Closure,b:&Closure,scope:usize)->Key{(a.expr,a.env.id(),a.levels.identity(),b.expr,b.env.id(),b.levels.identity(),scope)}
+    fn pay(work:&mut usize,cost:usize)->bool{if *work<cost{return false}*work-=cost;true}
+    fn level_copy(level:&crate::level::LevelTerm,work:&mut usize)->Option<crate::level::LevelTerm>{
+        use crate::level::LevelTerm;let mut pending=vec![level];let(mut nodes,mut bytes)=(0usize,0usize);
+        while let Some(level)=pending.pop(){nodes=nodes.checked_add(1)?;if nodes>64||!pay(work,1){return None}
+            match level{LevelTerm::Zero=>{},LevelTerm::Param(s)=>{bytes=bytes.checked_add(s.len())?;if bytes>4096||!pay(work,s.len()){return None}},LevelTerm::Succ(x)=>pending.push(x),LevelTerm::Max(a,b)|LevelTerm::IMax(a,b)=>{pending.push(b);pending.push(a);}}
+        }
+        Some(level.clone())
+    }
+    fn level_equal(a:&crate::level::LevelTerm,b:&crate::level::LevelTerm,work:&mut usize)->bool{
+        let(Some(a),Some(b))=(level_copy(a,work),level_copy(b,work))else{return false};crate::level::level_equal_metered(a,b,work).is_proven()
+    }
+    enum Task{Enter(Closure,Closure,usize),Finish(Key),Neutral(Neutral,Neutral,usize)}
+    // Reverse release keeps ancestor owners alive while descendants drop.
+    struct Owners(Vec<(Closure,Closure)>);impl Drop for Owners{fn drop(&mut self){while let Some(pair)=self.0.pop(){drop(pair);}}}
+    let mut owners=Owners(Vec::new());let mut pending=Vec::new();let mut active=HashSet::new();let mut complete=HashSet::new();
+    if !pay(work,left_args.len().saturating_add(context.len()).saturating_add(1)){return false}
+    let mut scopes=vec![(depth,context.to_vec())];
+    for(a,b)in left_args.iter().zip(right_args){pending.push(Task::Enter(a.clone(),b.clone(),0));}
+    pending.push(Task::Enter(left.clone(),right.clone(),0));let machine=checker.machine();
+    while let Some(task)=pending.pop(){
+        if !pay(work,1){return false}
+        match task{
+            Task::Finish(k)=>{active.remove(&k);complete.insert(k);},
+            Task::Enter(a,b,scope)=>{
+                let k=key(&a,&b,scope);owners.0.push((a.clone(),b.clone()));
+                if complete.contains(&k){continue}
+                if !active.insert(k){return false}
+                if (a.expr,a.env.id(),a.levels.identity())==(b.expr,b.env.id(),b.levels.identity())
+                    ||checker.reuse_completed_source_capture_fact(&a,&b){active.remove(&k);complete.insert(k);continue}
+                let av=TypeValue::Term(a.clone());let bv=TypeValue::Term(b.clone());
+                // Query only an already completed ordinary root conversion in
+                // its original namespace; no reset or fresh recursive search.
+                let (local_depth,local_context)=&scopes[scope];
+                if let Some(fact)=checker.completed_core_conversion_key(&av,&bv,local_context,*local_depth,0,DeltaPolicy::GuardedSemanticFallback,*work)
+                    && checker.reuse_completed_core_conversion(&fact,local_context){active.remove(&k);complete.insert(k);continue}
+                let probe=(*work/2).min(16);if probe<16||!pay(work,2*probe){return false}
+                let a=machine.expose_for_conversion(a,Transparency::Reducible,probe);let b=machine.expose_for_conversion(b,Transparency::Reducible,probe);
+                let(Judgment::Proven{value:a,..},Judgment::Proven{value:b,..})=(a,b)else{return false};
+                pending.push(Task::Finish(k));
+                match(a,b){
+                    (Value::StuckProjection{type_name:x,index:i,structure:a,spine:aa},Value::StuckProjection{type_name:y,index:j,structure:b,spine:ba})if x==y&&i==j&&aa.len()==ba.len()=>{
+                        if !pay(work,aa.len().saturating_add(1)){return false}for(a,b)in aa.into_iter().zip(ba){pending.push(Task::Enter(a,b,scope));}pending.push(Task::Enter(a,b,scope));
+                    }
+                    (Value::Lam{domain:left_domain,body:left_body},Value::Lam{domain:right_domain,body:right_body})=>{
+                        // Mirror the ordinary kernel's lambda congruence:
+                        // prove the domains in Gamma first, then the bodies
+                        // opened by the same fresh local in Gamma,domain.
+                        // A same-shape shortcut without these two obligations
+                        // would be unsound. Neither obligation receives fuel.
+                        if *local_depth>=64||local_context.len()!=*local_depth{return false}
+                        let Some(free)=fresh_local(*local_depth)else{return false};
+                        if !source_opening_avoids_capture(checker,&left_body,free,work)
+                            ||!source_opening_avoids_capture(checker,&right_body,free,work){return false}
+                        if !pay(work,local_context.len().saturating_add(3)){return false}
+                        let mut body_context=local_context.clone();
+                        body_context.push(TypeValue::Term(left_domain.clone()));
+                        let next_scope=scopes.len();scopes.push((local_depth+1,body_context));
+                        pending.push(Task::Enter(left_body.under_free(free),right_body.under_free(free),next_scope));
+                        pending.push(Task::Enter(left_domain,right_domain,scope));
+                    }
+                    (Value::Neutral(a),Value::Neutral(b))=>pending.push(Task::Neutral(a,b,scope)),
+                    (Value::Sort(a),Value::Sort(b))=>if !level_equal(&a,&b,work){return false},
+                    (Value::NatLit(a),Value::NatLit(b))=>if !pay(work,a.limb_count().max(b.limb_count()))||a!=b{return false},
+                    _=>return false,
+                }
+            }
+            Task::Neutral(a,b,scope)=>{
+                if a.spine.len()!=b.spine.len()||!pay(work,a.spine.len()){return false}
+                match(a.head,b.head){
+                    (NeutralHead::Free(a),NeutralHead::Free(b))if a==b=>{},
+                    (NeutralHead::Const{name:a,levels:al},NeutralHead::Const{name:b,levels:bl})if a==b&&al.len()==bl.len()=>{
+                        for(a,b)in al.iter().zip(&bl){if !level_equal(a,b,work){return false}}
+                    }
+                    (NeutralHead::Projection{type_name:a,index:i,structure:x},NeutralHead::Projection{type_name:b,index:j,structure:y})if a==b&&i==j=>pending.push(Task::Neutral(*x,*y,scope)),
+                    _=>return false,
+                }
+                for(a,b)in a.spine.into_iter().zip(b.spine){pending.push(Task::Enter(a,b,scope));}
+            }
+        }
+    }
+    true
