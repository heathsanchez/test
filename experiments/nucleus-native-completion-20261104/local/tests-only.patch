+ fn nested_source()->(crate::parser::ResolvedExport,crate::syntax::InductiveBlock){
+  let(mut e,b)=source();
+  for(id,expr)in[(1010,Expr::Const{name:b.constructors[0].name,levels:vec![]}),(1011,Expr::Const{name:b.constructors[1].name,levels:vec![]}),(1012,Expr::App{fun:ExprId(1011),arg:ExprId(1010)}),(1013,Expr::Const{name:NameId(9002),levels:vec![]}),(1014,Expr::NatLit(BigNat::parse_decimal("1").unwrap())),(1015,Expr::App{fun:ExprId(1013),arg:ExprId(1014)}),(1016,Expr::App{fun:ExprId(1015),arg:ExprId(1012)}),(1017,Expr::Const{name:NameId(9001),levels:vec![]}),(1018,Expr::App{fun:ExprId(1017),arg:ExprId(1016)}),(1019,Expr::App{fun:ExprId(1018),arg:ExprId(1000)}),(1020,Expr::Const{name:NameId(9020),levels:vec![]}),(1021,Expr::Const{name:NameId(9010),levels:vec![]}),(1022,Expr::Lam{domain:ExprId(1020),body:ExprId(1021)}),(1023,Expr::Lam{domain:ExprId(1),body:ExprId(1022)}),(1024,Expr::Lam{domain:ExprId(1),body:ExprId(1020)})]{e.exprs.insert(ExprId(id),expr).unwrap();}
+  (e,b)
+ }
+ #[test]fn completed_rhs_finishes_actual_nested_sub_pred_equality_operands(){
+  let(e,b)=nested_source();let m=machine(&e,&b,true);let mut nat=m.nat_primitives.clone().unwrap();nat.sub=Some(NameId(9002));nat.beq=Some(NameId(9001));
+  let m=m.with_nat_primitives(Some(nat)).with_bool_primitives(Some(BoolPrimitives{false_ctor:NameId(9010),true_ctor:NameId(9011)}));
+  let mut n=replay(&b,predecessor(closure(1002)));n.spine=vec![closure(1024),closure(1019),closure(1023),closure(1000)];
+  let result=m.qualified_nested_recursor_result(&n,4096);
+  assert_eq!(result.proven_value(),Some(&Value::Neutral(Neutral{head:NeutralHead::Const{name:NameId(9011),levels:vec![]},spine:vec![]})),"the actual equation (1-(succ0))=0 is true: {result:?}");
+ }
+ #[test]fn warm_completed_result_cannot_replace_the_requested_principal_one_step_rhs(){
+  let(e,b)=nested_source();let m=machine(&e,&b,true);let mut nat=m.nat_primitives.clone().unwrap();nat.sub=Some(NameId(9002));let m=m.with_nat_primitives(Some(nat));
+  let mut n=replay(&b,predecessor(closure(1002)));n.spine[1]=closure(1016);n.spine[3]=closure(1000);
+  let cold=m.qualified_one_step_recursor_result(&n,4096);
+  assert!(matches!(cold.proven_value(),Some(Value::Neutral(v))if v.head==NeutralHead::Const{name:NameId(9000),levels:vec![]}));
+  assert_eq!(m.qualified_nested_recursor_result(&n,4096).proven_value(),Some(&Value::NatLit(BigNat::parse_decimal("0").unwrap())));
+  let warm=m.qualified_one_step_recursor_result(&n,4096);
+  assert!(matches!(warm.proven_value(),Some(Value::Neutral(v))if v.head==NeutralHead::Const{name:NameId(9000),levels:vec![]}),"completed memo must not cross the principal one-step boundary: {warm:?}");
+ }
