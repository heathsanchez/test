+    fn finish_native_value(&self,mut value:Value,transparency:Transparency,budget:usize)->Value {
+        if !self.native_completion.get() || self.exposure_fuel.get().is_none()
+            || self.resumable_native(&value).is_none() || self.exposure_depth.get()>=64 {return value;}
