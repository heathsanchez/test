+// Lean 4.34.1 kernel/level.cpp::is_not_zero, with explicit exhaustion.
+// A completed negative has the all-zero parameter valuation as a witness;
+// exhaustion is never evidence that a multi-constructor family is Prop.
+fn exported_level_nonzero_search(
+    export: &ResolvedExport,
+    level: LevelId,
+    depth: usize,
+    remaining: &mut usize,
+) -> Option<bool> {
+    if depth == 0 || *remaining == 0 {return None;}
+    *remaining -= 1;
+    match export.levels.get(level) {
+        Some(Level::Succ(_)) => Some(true),
+        Some(Level::Zero | Level::Param(_)) => Some(false),
+        Some(Level::IMax(_, right)) =>
+            exported_level_nonzero_search(export,*right,depth-1,remaining),
+        Some(Level::Max(left, right)) => {
+            let lhs=exported_level_nonzero_search(export,*left,depth-1,remaining);
+            if lhs==Some(true) {return Some(true);}
+            let rhs=exported_level_nonzero_search(export,*right,depth-1,remaining);
+            if rhs==Some(true) {Some(true)}
+            else if lhs==Some(false) && rhs==Some(false) {Some(false)}
+            else {None}
+        }
+        None => None,
+    }
+}
