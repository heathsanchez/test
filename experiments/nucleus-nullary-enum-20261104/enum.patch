+// The new envelope is closed, monomorphic, and contains only 3..=16
+// nullary alternatives. Binary enums retain their qualified primitive path.
+fn nullary_enum_scope(block:&InductiveBlock)->bool {
+    let ([inductive],constructors,[_])=(block.types.as_slice(),block.constructors.as_slice(),block.recursors.as_slice()) else{return false;};
+    inductive.num_params==0 && inductive.level_params.is_empty()
+        && (3..=16).contains(&constructors.len())
+        && constructors.iter().all(|constructor|constructor.num_fields==0)
+}
