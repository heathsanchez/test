+mod obligation_census_tests {
+    use super::*;
+    use crate::syntax::Name;
+    fn fixture()->ResolvedExport {
+        let mut e=crate::parser::parse(std::io::Cursor::new(include_bytes!("../tests/fixtures/good-beta-definition.ndjson"))).unwrap().resolve().unwrap();
+        e.exprs.insert(ExprId(100),Expr::BVar(99)).unwrap();
+        for id in 10..13 {e.names.insert(NameId(id),Name::Str{prefix:NameId(0),value:format!("census_{id}")}).unwrap();}
+        for id in 10..12 {e.declarations.push(Declaration::Definition{name:NameId(id),level_params:vec![],ty:ExprId(3),value:ExprId(100),preferred_for_reduction:true});}
+        e.declarations.push(Declaration::Definition{name:NameId(12),level_params:vec![],ty:ExprId(3),value:ExprId(2),preferred_for_reduction:true});e
+    }
+    #[test]fn census_exposes_later_failures_and_never_changes_authoritative_verdict(){
+        let e=fixture();let before=check_export(e.clone(),Limits::default());assert_ne!(before,Verdict::Accept);
+        let report=diagnostic_census(e.clone(),Limits::default(),8,64);
+        assert_eq!(report["diagnostic_only"],true);assert_eq!(report["whole_export_warrant"],"FORBIDDEN");
+        assert_eq!(report["failures"].as_array().unwrap().len(),2);
+        assert_eq!(report["assumed_declarations"],2);assert!(report["conditional_successes"].as_u64().unwrap()>0);
+        assert_eq!(report["finished_all_declarations"],true);
+        assert_eq!(before,check_export(e,Limits::default()));
+    }
+    #[test]fn census_limit_is_explicit_and_does_not_claim_complete_coverage(){
+        let report=diagnostic_census(fixture(),Limits::default(),1,64);
+        assert_eq!(report["failures"].as_array().unwrap().len(),1);
+        assert_eq!(report["finished_all_declarations"],false);
+        assert_eq!(report["stop_reason"],"failure-limit");
+    }
