+        let e=crate::parser::parse(std::io::Cursor::new(include_bytes!("../tests/fixtures/bad-orphan-recursor.ndjson"))).unwrap().resolve().unwrap();
+        let report=diagnostic_census(e,Limits::default(),8,64);
+        assert_eq!(report["finished_all_declarations"],false);
+        assert_eq!(report["assumed_declarations"],0);
+        assert_eq!(report["whole_export_warrant"],"FORBIDDEN");
+    }
