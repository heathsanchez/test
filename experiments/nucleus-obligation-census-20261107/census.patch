+use std::{io::{self,BufReader},process::ExitCode};
+fn main()->ExitCode{
+ let args:Vec<String>=std::env::args().collect();
+ if args.get(1).map(String::as_str)!=Some("--source-assumptions-only") {eprintln!("requires --source-assumptions-only; this executable cannot issue ACCEPT");return ExitCode::from(3);}
+ let number=|index:usize,default:usize|args.get(index).and_then(|s|s.parse::<usize>().ok()).unwrap_or(default);
+ let (steps,failures,window)=(number(2,262144),number(3,64),number(4,256));
+ std::thread::Builder::new().stack_size(64*1024*1024).spawn(move||{
+  match metatron_kernel::parser::parse(BufReader::new(io::stdin().lock())).and_then(|e|e.resolve()){
+   Ok(e)=>{println!("{}",metatron_kernel::checker::diagnostic_census(e,metatron_kernel::checker::Limits{judgment_steps:steps},failures,window));ExitCode::from(2)},
+   Err(error)=>{eprintln!("diagnostic parse error: {error}");ExitCode::from(3)}
+  }
+ }).unwrap().join().unwrap_or(ExitCode::from(3))
+}
