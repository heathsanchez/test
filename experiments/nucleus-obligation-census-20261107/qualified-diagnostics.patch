+//! Observation-only prototype of cross-route typing obligations.
+//! Metadata is never returned as a type, equality, or admission decision.
+use std::collections::{HashMap,HashSet,VecDeque};
+#[derive(Clone,Debug,Eq,PartialEq,Hash)]
+pub(crate) struct Key{pub expr:u64,pub env:u64,pub levels:String,pub context:String,pub strict:bool,pub policy:String,pub flags:Option<[u64;2]>,pub epoch:Option<u64>}
+pub(crate) struct Shadow{
+ pub enabled:bool,
+ active:HashMap<Key,usize>,completed:HashSet<Key>,order:VecDeque<Key>,
+ queries:usize,completed_hits:usize,active_hits:usize,
+ completed_hit_unresolved:usize,active_hit_unresolved:usize,untracked:usize,
+}
+impl Default for Shadow{fn default()->Self{Self{enabled:std::env::var_os("NUCLEUS_DIAGNOSTIC_SHARED_TYPING").is_some(),active:HashMap::new(),completed:HashSet::new(),order:VecDeque::new(),queries:0,completed_hits:0,active_hits:0,completed_hit_unresolved:0,active_hit_unresolved:0,untracked:0}}}
+impl Shadow{
+ pub fn begin(&mut self,key:Key){if let Some(n)=self.active.get_mut(&key){*n+=1;}else if self.active.len()<4096{self.active.insert(key,1);}else{self.untracked+=1;}}
+ pub fn finish(&mut self,key:Key,proven:bool){
+  if let Some(n)=self.active.get_mut(&key){*n-=1;if *n==0{self.active.remove(&key);}}
+  if proven&&!self.completed.contains(&key){if self.order.len()==4096{if let Some(old)=self.order.pop_front(){self.completed.remove(&old);}}self.order.push_back(key.clone());self.completed.insert(key);}
+ }
+ pub fn snapshot(&self,key:&Key)->(bool,bool){(self.completed.contains(key),self.active.contains_key(key))}
+ pub fn query(&mut self,matches:(bool,bool),proven:bool){
+  self.queries+=1;
+  if matches.0{self.completed_hits+=1;if !proven{self.completed_hit_unresolved+=1;}}
+  if matches.1{self.active_hits+=1;if !proven{self.active_hit_unresolved+=1;}}
+ }
+ pub fn report(&self)->serde_json::Value{serde_json::json!({"diagnostic_only":true,"acceptance_authority":false,"capacity":4096,"exact_source_queries":self.queries,"completed_ordinary_matches":self.completed_hits,"pending_ordinary_matches":self.active_hits,"completed_match_exact_unresolved":self.completed_hit_unresolved,"pending_match_exact_unresolved":self.active_hit_unresolved,"untracked_due_capacity":self.untracked})}
+}
+impl Drop for Shadow{fn drop(&mut self){if self.enabled&&self.queries>0{eprintln!("NUCLEUS_SHARED_TYPING_SHADOW:{}",self.report());}}}
+
+// Abort Debug formatting as soon as the metadata byte budget is exhausted.
+pub(crate) fn bounded_debug(value:&impl std::fmt::Debug)->Option<String>{
+ struct Sink(String);impl std::fmt::Write for Sink{fn write_str(&mut self,s:&str)->std::fmt::Result{if self.0.len()+s.len()>65536{return Err(std::fmt::Error);}self.0.push_str(s);Ok(())}}
+ let mut sink=Sink(String::new());std::fmt::write(&mut sink,format_args!("{value:?}")).ok()?;Some(sink.0)
+}
