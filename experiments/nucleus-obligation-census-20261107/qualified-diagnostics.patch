+/// Census only: failed source declarations may be assumed in a quarantined
+/// environment. The report can never authorize a theorem or an export.
+#[cfg(feature="diagnostics")]
+pub fn diagnostic_census(export:ResolvedExport,limits:Limits,max_failures:usize,max_after_first:usize)->serde_json::Value {
+    let _configuration=crate::run_flags::enter();
+    let mut state=crate::census::Census::new(export.declarations.len(),max_failures,max_after_first);
+    let terminal=check_export_with_policy_inner(export,limits,DeltaPolicy::GuardedSemanticFallback,Some(&mut state));
+    state.report(match terminal{Verdict::Accept=>"unexpected-terminal",Verdict::Reject=>"structural-or-metadata-rejection",Verdict::Unknown=>"unsupported-metadata-or-structural-obligation",Verdict::Error=>"process-error"})
+}
+fn census_boundary(census:&mut Option<&mut crate::census::Census>,export:&ResolvedExport,name:NameId,stage:&'static str,judgment:Judgment<()>)->Result<(),Verdict>{
+    if let Some(state)=census.as_deref_mut(){
+        state.boundary(name,trace_name(export,name),stage,&judgment);
+        if !judgment.is_proven(){state.attach_source(export);if state.at_failure_limit(){return Err(Verdict::Unknown);}}
+        // This permits further DIAGNOSTIC observations, not an admission
+        // in the ordinary checker. The containing API returns a report only.
+        Ok(())
+    }else{trace_verdict_boundary(export,name,stage,judgment)}
 }
 
