+//! Quarantined diagnostics. No value in this module is a kernel warrant.
+use std::collections::HashSet;
+use serde_json::{json,Value};
+use crate::{id::NameId,judgment::Judgment};
+pub(crate) struct Census {
+    pub(crate) total:usize,
+    pub(crate) visited:usize,
+    pub(crate) current:usize,
+    pub(crate) finished:bool,
+    pub(crate) stop:Option<&'static str>,
+    pub(crate) location:Option<Value>,
+    first_failure:Option<usize>,
+    max_failures:usize,
+    max_after_first:usize,
+    failures:Vec<Value>,
+    assumed:HashSet<NameId>,
+    checks:usize,
+    conditional_successes:usize,
+}
+impl Census {
+    pub(crate) fn new(total:usize,max_failures:usize,max_after_first:usize)->Self{
+        Self{total,visited:0,current:0,finished:false,stop:None,location:None,first_failure:None,max_failures,max_after_first,failures:vec![],assumed:HashSet::new(),checks:0,conditional_successes:0}
+    }
+    pub(crate) fn enter(&mut self,index:usize)->bool{
+        if self.failures.len()>=self.max_failures {self.stop=Some("failure-limit");return false;}
+        if self.first_failure.is_some_and(|first|index.saturating_sub(first)>=self.max_after_first){self.stop=Some("post-failure-window");return false;}
+        self.current=index;self.visited=index+1;true
+    }
+    pub(crate) fn at_failure_limit(&mut self)->bool{if self.failures.len()>=self.max_failures{self.stop=Some("failure-limit");true}else{false}}
+    pub(crate) fn boundary(&mut self,name:NameId,label:String,stage:&str,judgment:&Judgment<()>){
+        self.checks+=1;
+        let (outcome,reason)=match judgment {
+            Judgment::Proven{..}=>{if !self.assumed.is_empty(){self.conditional_successes+=1;}return;},
+            Judgment::Refuted{obstruction}=>("REFUTED",obstruction.0),
+            Judgment::Unknown{residual}=>("UNKNOWN",residual.0),
+        };
+        self.first_failure.get_or_insert(self.current);
+        self.failures.push(json!({"declaration_index":self.current,"name_id":name.0,"name":label,"stage":stage,"observed_judgment":outcome,"reason":reason,"prior_assumed_declarations":self.assumed.len(),"authority":"DIAGNOSTIC_SOURCE_ASSUMPTIONS_ONLY"}));
+        self.assumed.insert(name);
+    }
+    pub(crate) fn attach_source(&mut self,export:&crate::parser::ResolvedExport){
+        use crate::syntax::Declaration;
+        let roots=match export.declarations.get(self.current){
+            Some(Declaration::Definition{ty,value,..}|Declaration::Theorem{ty,value,..}|Declaration::Opaque{ty,value,..})=>Some((*ty,Some(*value))),
+            Some(Declaration::Axiom{ty,..})=>Some((*ty,None)),_=>None,
+        };
+        if let (Some((ty,body)),Some(row))=(roots,self.failures.last_mut()){
+            row["type_expr"]=json!(ty.0);row["body_expr"]=json!(body.map(|id|id.0));
+            eprintln!("NUCLEUS_CENSUS_OBSERVATION:{row}");
+        }
+    }
+    pub(crate) fn report(self,terminal:&str)->Value{
+        json!({"schema":"nucleus.obligation_census.v1","diagnostic_only":true,"whole_export_warrant":"FORBIDDEN","source_reference_status":"ASSUMED_ORIGINAL_SOURCE_NOT_REVERIFIED_BY_THIS_CENSUS","total_declarations":self.total,"visited_declarations":self.visited,"finished_all_declarations":self.finished,"stop_reason":self.stop.unwrap_or(if self.finished{"end-of-source"}else{terminal}),"stopping_declaration":if !self.finished&&self.stop.is_none(){self.location}else{None},"conditionality_policy":"CONSERVATIVE_PRIOR_FAILURE_CONTAMINATION_NOT_DEPENDENCY_COUNTS","scalar_checks":self.checks,"assumed_declarations":self.assumed.len(),"conditional_successes":self.conditional_successes,"failures":self.failures})
+    }
+}
