+#![cfg(feature="diagnostics")]
+use std::{io::Write,process::{Command,Stdio}};
+fn report(source:&str,focus:&str)->serde_json::Value{
+ let mut child=Command::new(env!("CARGO_BIN_EXE_nucleus-census")).args(["--source-assumptions-only","262144","64","256",focus]).stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::null()).spawn().unwrap();
+ child.stdin.take().unwrap().write_all(source.as_bytes()).unwrap();let out=child.wait_with_output().unwrap();assert_eq!(out.status.code(),Some(2));serde_json::from_slice(&out.stdout).unwrap()
+}
+#[test]fn focused_census_labels_assumed_scalar_prefix_without_issuing_a_verdict(){
+ let source=format!("{}{}",include_str!("fixtures/good-beta-definition.ndjson"),r#"{"in":10,"str":{"pre":0,"str":"bad"}}
+{"ie":100,"bvar":99}
+{"def":{"all":[10],"hints":"abbrev","levelParams":[],"name":10,"safety":"safe","type":3,"value":100}}
+"#);
+ assert_ne!(metatron_kernel::run(std::io::Cursor::new(source.clone())),metatron_kernel::verdict::Verdict::Accept);
+ assert!(!report(&source,"0")["failures"].as_array().unwrap().is_empty());
+ let r=report(&source,"99");assert!(r["failures"].as_array().unwrap().is_empty());assert!(r["assumed_prefix_checks"].as_u64().unwrap()>0);assert_eq!(r["whole_export_warrant"],"FORBIDDEN");assert_eq!(r["assumed_declarations"],2);
+}
+#[test]fn focused_census_cannot_bypass_structural_metadata(){let r=report(include_str!("fixtures/bad-orphan-recursor.ndjson"),"99");assert_eq!(r["finished_all_declarations"],false);assert_eq!(r["assumed_prefix_checks"],0);}
