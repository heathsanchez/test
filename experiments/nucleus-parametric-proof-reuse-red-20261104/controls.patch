  #[test]fn identical_substitution_allocation_does_not_equal_different_used_levels(){let(e,l,env)=fixture();let c=TypeChecker::new(&e,&l,&env);let map=LevelSubstitution::new(vec![(NameId(1),one()),(NameId(2),LevelTerm::Zero)]);let a=Closure::with_levels(ExprId(4),EnvFrame::empty(),map.clone());let b=Closure::with_levels(ExprId(5),EnvFrame::empty(),map);assert!(!c.instantiated_source_capture_congruence(&a,&b,&mut 256));}
  #[test]fn constant_universe_arguments_are_checked_without_renaming_constant_authority(){let(mut e,l,env)=fixture();for(id,name,level)in[(10,42,1),(11,42,2),(12,43,2)]{e.insert(ExprId(id),Expr::Const{name:NameId(name),levels:vec![LevelId(level)]}).unwrap();}let c=TypeChecker::new(&e,&l,&env);let a=term(10,1,one(),EnvFrame::empty());assert!(c.instantiated_source_capture_congruence(&a,&term(11,2,one(),EnvFrame::empty()),&mut 256));for b in[term(11,2,LevelTerm::Zero,EnvFrame::empty()),term(12,2,one(),EnvFrame::empty())]{assert!(!c.instantiated_source_capture_congruence(&a,&b,&mut 256));}}
  #[test]fn parametric_projection_templates_preserve_owner_field_and_actual_receiver(){let(mut e,l,env)=fixture();for(id,owner,index)in[(13,70,0),(14,70,0),(15,71,0),(16,70,1)]{e.insert(ExprId(id),Expr::Proj{type_name:NameId(owner),index,structure:ExprId(0)}).unwrap();}let c=TypeChecker::new(&e,&l,&env);let a=term(13,1,one(),EnvFrame::empty().extend_free(FreeId(7)));assert!(c.instantiated_source_capture_congruence(&a,&term(14,2,one(),EnvFrame::empty().extend_free(FreeId(7))),&mut 256));for b in[term(15,2,one(),EnvFrame::empty().extend_free(FreeId(7))),term(16,2,one(),EnvFrame::empty().extend_free(FreeId(7))),term(14,2,one(),EnvFrame::empty().extend_free(FreeId(8)))]{assert!(!c.instantiated_source_capture_congruence(&a,&b,&mut 256));}}
