+// Semantic contraction of an evaluated projected function. This is the same
+// eta law as eta_contract: compare the actual opened body to N x with N
+// fresh-free. Exact head/universe gates and mandatory ordinary prefix goals
+// preserve every source receiver and captured argument.
+fn evaluated_projected_eta(
+    checker: &TypeChecker<'_>, neutral: &Neutral, domain:&Closure, body: &Closure,
+    caller: &mut usize, depth: usize, context:&[TypeValue],
+    work:&mut Vec<(TypeValue,TypeValue,usize,Vec<TypeValue>)>,
+) -> bool {
+    if !matches!(&neutral.head, NeutralHead::Projection{..}) || *caller<128
+        || depth!=context.len() || context.len()>64
+        || context.iter().any(|t|!matches!(t,TypeValue::Term(_))) {return false;}
+    let grant=(*caller/4).min(1024);
+    *caller-=grant; // Failed attempts pay too; no fresh nested allowance.
+    let mut fuel=grant;
+    let Some(free)=fresh_local(depth)else{return false;};
+    if !source_opening_avoids_capture(checker,body,free,&mut fuel)
+        || !source_avoids_capture_uncached(checker,domain,0,free,&mut fuel)
+        || !neutral_avoids_free(checker,neutral,free,&mut fuel){return false;}
+    let exposed=checker.machine().expose_projection_for_conversion_metered(body.under_free(free),&mut fuel);
+    let Some(Value::Neutral(opened))=exposed.proven_value()else{return false;};
+    if opened.spine.len()!=neutral.spine.len()+1{return false;}
+    let Some(last)=opened.spine.last()else{return false;};
+    let argument=checker.machine().expose_projection_for_conversion_metered(last.clone(),&mut fuel);
+    if !matches!(argument.proven_value(),Some(Value::Neutral(n)) if matches!(&n.head,NeutralHead::Free(f) if *f==free)&&n.spine.is_empty()){return false;}
+    // The opened prefixes can depend on the fresh binder. Their equality
+    // remains an ordinary mandatory conversion goal in the actual extended
+    // source context; none is erased or typed in the old context.
+    if fuel<context.len()+1{return false;}fuel-=context.len()+1;
+    let mut extended=context.to_vec();extended.push(TypeValue::Term(domain.clone()));
+    neutral_eta_goals(neutral,opened,1,&mut fuel,depth+1,&extended,work)
+}
+
+fn neutral_avoids_free(checker:&TypeChecker<'_>,root:&Neutral,free:FreeId,fuel:&mut usize)->bool{
+    let mut pending=vec![root];
+    while let Some(n)=pending.pop(){
+        if *fuel==0{return false;}*fuel-=1;
+        match &n.head{
+            NeutralHead::Free(actual)if *actual==free=>return false,
+            NeutralHead::Projection{structure,..}=>pending.push(structure),
+            _=>{},
+        }
+        for arg in &n.spine{if !source_avoids_capture_uncached(checker,arg,0,free,fuel){return false;}}
+    }
+    true
+}
+
+fn neutral_eta_goals(left:&Neutral,right:&Neutral,drop_right:usize,fuel:&mut usize,
+    depth:usize,context:&[TypeValue],work:&mut Vec<(TypeValue,TypeValue,usize,Vec<TypeValue>)>,
+)->bool{
+    let mut goals=Vec::new();
+    let mut pending=vec![(left,right,drop_right)];
+    while let Some((a,b,drop))=pending.pop(){
+        if *fuel==0{return false;}*fuel-=1;
+        if b.spine.len().checked_sub(drop)!=Some(a.spine.len()){return false;}
+        match (&a.head,&b.head){
+            (NeutralHead::Free(x),NeutralHead::Free(y))if x==y=>{},
+            (NeutralHead::Const{name:x,levels:xs},NeutralHead::Const{name:y,levels:ys})if x==y&&xs.len()==ys.len()=>{
+                // Identity only: walk universe syntax iteratively within the
+                // same allowance; no deep derived equality or new level law.
+                if *fuel<xs.len(){return false;}*fuel-=xs.len();
+                let mut levels=xs.iter().zip(ys).collect::<Vec<_>>();
+                while let Some((x,y))=levels.pop(){
+                    if *fuel==0{return false;}*fuel-=1;
+                    use crate::level::LevelTerm::*;
+                    match (x,y){
+                        (Zero,Zero)=>{},(Param(a),Param(b))if a==b=>{},
+                        (Succ(a),Succ(b))=>levels.push((a,b)),
+                        (Max(a,b),Max(c,d))|(IMax(a,b),IMax(c,d))=>{levels.push((a,c));levels.push((b,d));},
+                        _=>return false,
+                    }
+                }
+            },
+            (NeutralHead::Projection{type_name:x,index:i,structure:xs},NeutralHead::Projection{type_name:y,index:j,structure:ys})if x==y&&i==j=>pending.push((xs,ys,0)),
+            _=>return false,
+        }
+        let Some(cost)=a.spine.len().checked_mul(context.len()+2)else{return false;};
+        if *fuel<cost{return false;}*fuel-=cost;
+        for(x,y)in a.spine.iter().zip(&b.spine){
+            goals.push((TypeValue::Term(x.clone()),TypeValue::Term(y.clone()),depth,context.to_vec()));
+        }
+    }
+    work.extend(goals); // Commit only after every head and universe gate.
+    true
+}
