 struct NeutralProjectionDepthScope<'a> { depth: &'a Cell<usize> }
 impl Drop for NeutralProjectionDepthScope<'_> { fn drop(&mut self) {self.depth.set(self.depth.get().saturating_sub(1));} }
+
+// A borrowed allowance returns only unused work and charges both outcomes.
+struct MeteredQuotientWork<'a>{fuel:&'a Cell<Option<usize>>,caller:&'a mut usize,parent:Option<usize>,grant:usize}
+impl Drop for MeteredQuotientWork<'_>{fn drop(&mut self){
+    let unused=self.fuel.get().unwrap_or(0).min(self.grant);
+    let spent=self.grant-unused;
+    *self.caller=self.caller.saturating_sub(spent);
+    self.fuel.set(self.parent.map(|work|work.saturating_sub(spent)));
+}}
 
 struct ConstructorFuelScope<'a> { fuel: &'a Cell<Option<usize>> }
 impl Drop for ConstructorFuelScope<'_> { fn drop(&mut self) { self.fuel.set(None); } }
