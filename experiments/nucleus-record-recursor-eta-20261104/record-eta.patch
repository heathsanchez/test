+    /// Typed eta followed by the original admitted recursor's source RHS.
+    /// This is reduction evidence only, never a typing certificate for a
+    /// motive or minor. Their source arguments remain checked by inference.
+    pub(crate) fn checked_record_recursor_eta(
+        &self, neutral:&Neutral, context:&[TypeValue], budget:&mut usize,
+    )->Option<Closure>{
+        if *budget<1024 || context.len()>32{return None;}
+        let NeutralHead::Const{name,levels}=&neutral.head else{return None};
+        let reduction=self.environment.recursor_reduction(*name)?;
+        let [rule]=reduction.rules.as_slice()else{return None};
+        if reduction.k || reduction.num_indices!=0 || reduction.level_params.len()!=levels.len()
+            || rule.num_params!=reduction.num_params || rule.num_fields>8{return None;}
+        let params=rule.num_params;let fields=rule.num_fields;
+        if params>8{return None;}
+        let prefix=params.checked_add(2)?;let required=prefix.checked_add(1)?;
+        if neutral.spine.len()!=required{return None;}
+        thread_local!{static ACTIVE:std::cell::Cell<bool>=const{std::cell::Cell::new(false)};}
+        if ACTIVE.with(|active|active.replace(true)){return None;}
+        struct Scope;impl Drop for Scope{fn drop(&mut self){ACTIVE.with(|a|a.set(false));}}
+        let _scope=Scope;
+        let allowance=(*budget/2).min(8192);*budget-=allowance;
+        let mut fuel=allowance;
+        // Reserve each nested trial from this one allowance before entry.
+        // Unused child allowance is deliberately not refunded.
+        fn reserve(fuel:&mut usize,cap:usize)->Option<usize>{
+            let grant=(*fuel).min(cap);if grant==0{return None;}*fuel-=grant;Some(grant)
+        }
+        let major=neutral.spine.last()?;
+        // Restrict this earned rule to actual lexical locals. Follow the
+        // source capture chain by borrow, charging frame traversal before
+        // lookup; never clone an arbitrary captured neutral to inspect it.
+        let mut captured=major.clone();
+        let free=loop{
+            if !take_step(&mut fuel){return None;}
+            let Expr::BVar(index)=self.expression(captured.expr)? else{return None};
+            let cost=usize::try_from(*index).ok()?.checked_add(1)?;
+            if fuel<cost{return None;}fuel-=cost;
+            match captured.env.lookup_binding_ref(*index)?{
+                EnvBinding::Free(free)=>break *free,
+                EnvBinding::Neutral(Neutral{head:NeutralHead::Free(free),spine})if spine.is_empty()=>break *free,
+                EnvBinding::Closure(next)=>captured=next.clone(),
+                _=>return None,
+            }
+        };
+        if !matches!(context.get(usize::try_from(free.0).ok()?),Some(TypeValue::Term(_))){return None;}
+        let actual=Neutral{head:NeutralHead::Free(free),spine:vec![]};
+        let mut major_fuel=reserve(&mut fuel,2048)?;
+        let TypeValue::Term(major_type)=self.infer_exact_closure_in_context(major,context,&mut major_fuel,0)? else{return None};
+        let mut formation_fuel=reserve(&mut fuel,1024)?;
+        let formed=self.infer_exact_closure_in_context(&major_type,context,&mut formation_fuel,0)?;
+        let formation=self.sort_level(Judgment::proven(formed,"record-eta-owner-formation"),reserve(&mut fuel,256)?);
+        let Judgment::Proven{value:sort,..}=formation else{return None};
+        fn nonzero(l:&LevelTerm,depth:usize,fuel:&mut usize)->bool{
+            if depth>=32 || !take_step(fuel){return false;}match l{LevelTerm::Succ(_)=>true,LevelTerm::Max(a,b)=>nonzero(a,depth+1,fuel)||nonzero(b,depth+1,fuel),LevelTerm::IMax(_,b)=>nonzero(b,depth+1,fuel),_=>false}
+        }
+        if !nonzero(&sort,0,&mut fuel){return None;}
+        let exposed=self.machine().expose_for_conversion(major_type,Transparency::Full,reserve(&mut fuel,512)?);
+        let Some(Value::Neutral(owner_type))=exposed.proven_value()else{return None};
+        let NeutralHead::Const{name:actual_owner,levels:owner_levels}=&owner_type.head else{return None};
+        let owner=*actual_owner;
+        let spec=self.environment.projection_spec(owner)?;
+        if !spec.eta_expandable || spec.constructor!=rule.constructor || spec.num_params!=params || spec.field_types.len()!=fields
+            || owner_type.spine.len()!=params || owner_levels.len()!=rule.constructor_level_params.len(){return None;}
+        fn charge_level(level:&LevelTerm,fuel:&mut usize,depth:usize)->bool{
+            if depth>=64 || !take_step(fuel){return false;}
+            match level{
+                LevelTerm::Succ(x)=>charge_level(x,fuel,depth+1),
+                LevelTerm::Max(a,b)|LevelTerm::IMax(a,b)=>charge_level(a,fuel,depth+1)&&charge_level(b,fuel,depth+1),
+                _=>true,
+            }
+        }
+        for(parameter,actual)in rule.constructor_level_params.iter().zip(owner_levels){
+            if !take_step(&mut fuel){return None;}
+            let i=reduction.level_params.iter().position(|p|p==parameter)?;
+            if !charge_level(&levels[i],&mut fuel,0)||!charge_level(actual,&mut fuel,0){return None;}
+            if !crate::level::level_equal(levels[i].clone(),actual.clone(),reserve(&mut fuel,64)?).is_proven(){return None;}
+        }
+        for(actual,expected)in owner_type.spine.iter().zip(&neutral.spine[..params]){
+            if !take_step(&mut fuel){return None;}
+            if !crate::convert::convert_with_policy_in_context(self,&TypeValue::Term(actual.clone()),&TypeValue::Term(expected.clone()),reserve(&mut fuel,256)?,crate::convert::DeltaPolicy::GuardedSemanticFallback,context.len(),context).is_proven(){return None;}
+        }
+        // A bounded search finds a real BVar(0) source carrier. It supplies
+        // no authority: its captured value is the typed actual projection.
+        let mut carrier=None;
+        for i in 0..256{if !take_step(&mut fuel){return None;}if matches!(self.expression(ExprId(i)),Some(Expr::BVar(0))){carrier=Some(ExprId(i));break;}}
+        let carrier=carrier?;
+        let mut arguments=neutral.spine[..prefix].to_vec();
+        for index in 0..fields{
+            if !take_step(&mut fuel){return None;}
+            arguments.push(Closure::new(carrier,EnvFrame::empty().extend_neutral(Neutral{head:NeutralHead::Projection{type_name:owner,index,structure:Box::new(actual.clone())},spine:vec![]})));
+        }
+        for level in levels{if !charge_level(level,&mut fuel,0){return None;}}
+        let substitution=reduction.level_params.iter().copied().zip(levels.iter().cloned()).collect();
+        let mut result=Closure::with_levels(rule.rhs,EnvFrame::empty(),LevelSubstitution::new(substitution));
+        for arg in arguments{
+            let mut lets=0;
+            loop{
+                if !take_step(&mut fuel){return None;}
+                match self.expression(result.expr){
+                    Some(Expr::Lam{body,..})=>{result=result.sibling(*body,result.env.extend(arg));break;},
+                    Some(Expr::Let{value,body,..}|Expr::LetNondep{value,body,..})if lets<16=>{let v=result.sibling(*value,result.env.clone());result=result.sibling(*body,result.env.extend(v));lets+=1;},
+                    _=>return None,
+                }
+            }
+        }
+        Some(result)
+    }
