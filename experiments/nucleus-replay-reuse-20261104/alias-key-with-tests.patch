+#[cfg(test)]
+mod replay_source_alias_guards {
+    use super::*;
+    use crate::level::{LevelTerm,succ};
+    fn tables()->(IdTable<ExprId,Expr>,IdTable<LevelId,Level>) {
+        let mut e=IdTable::default();let mut l=IdTable::default();
+        l.insert(LevelId(0),Level::Zero).unwrap();l.insert(LevelId(1),Level::Param(NameId(7))).unwrap();
+        for(id,expr)in[(0,Expr::BVar(0)),(1,Expr::Const{name:NameId(2),levels:vec![]}),
+            (2,Expr::Lam{domain:ExprId(0),body:ExprId(1)}),(3,Expr::Lam{domain:ExprId(0),body:ExprId(2)}),
+            (4,Expr::Sort(LevelId(1))),(5,Expr::BVar(u64::MAX))] {e.insert(ExprId(id),expr).unwrap();}
+        (e,l)
+    }
+    fn machine<'a>(e:&'a IdTable<ExprId,Expr>,l:&'a IdTable<LevelId,Level>)->Machine<'a> {
+        Machine::new(AuthorityId(1),e,l,HashMap::new()).with_exposure_cache(new_exposure_cache())
+            .with_recursor_reductions(HashMap::from([(NameId(1),RecursorReduction{k:false,num_params:0,num_indices:0,level_params:vec![],rules:vec![RecursorRule{constructor:NameId(2),constructor_level_params:vec![],num_params:0,num_fields:0,rhs:ExprId(3)}]})]))
+    }
+    fn key(machine:&Machine<'_>,closure:Closure)->Rc<ReplayKey> {
+        machine.exposure_fuel.set(Some(4096));
+        machine.completed_replay_key(NameId(1),&[],&vec![closure;3]).unwrap()
+    }
+    #[test]
+    fn actual_alias_bindings_reuse_one_completed_source_computation() {
+        let(e,l)=tables();let m=machine(&e,&l);let cache=m.exposure_cache.as_ref().unwrap();
+        let closed=Closure::new(ExprId(1),EnvFrame::empty());
+        let source=Neutral{head:NeutralHead::Const{name:NameId(1),levels:vec![]},spine:vec![closed;3]};
+        assert!(m.qualified_nested_recursor_result(&source,128).is_proven());
+        assert_eq!(cache.borrow().completed_replay_count,1);
+        let aliased=Neutral{head:source.head.clone(),spine:source.spine.iter().map(|c|Closure::new(ExprId(0),EnvFrame::empty().extend(c.clone()))).collect()};
+        assert_eq!(m.qualified_nested_recursor_result(&aliased,64).proven_value(),Some(&Value::Neutral(Neutral{head:NeutralHead::Const{name:NameId(2),levels:vec![]},spine:vec![]})));
+        assert_eq!(cache.borrow().completed_replay_count,1,"capture aliases must reuse the completed value, not publish a second computation");
+    }
+    #[test]
+    fn alias_keys_retain_the_bound_universe_map_and_separate_other_instances() {
+        let(e,l)=tables();let m=machine(&e,&l);
+        let zero=LevelSubstitution::new(vec![(NameId(7),LevelTerm::Zero)]);
+        let one=LevelSubstitution::new(vec![(NameId(7),succ(LevelTerm::Zero))]);
+        let actual=Closure::with_levels(ExprId(4),EnvFrame::empty(),zero);
+        let alias=Closure::with_levels(ExprId(0),EnvFrame::empty().extend(actual.clone()),one.clone());
+        assert!(key(&m,actual.clone()).exact==key(&m,alias).exact);
+        assert!(key(&m,actual).exact!=key(&m,Closure::with_levels(ExprId(4),EnvFrame::empty(),one)).exact);
+    }
+    #[test]
+    fn equal_numeric_free_ids_in_distinct_binding_scopes_never_merge() {
+        let(e,l)=tables();let m=machine(&e,&l);
+        let a=Closure::new(ExprId(0),EnvFrame::empty().extend_free(FreeId(5)));
+        let b=Closure::new(ExprId(0),EnvFrame::empty().extend_free(FreeId(5)));
+        assert!(key(&m,a).exact!=key(&m,b).exact);
+    }
+    #[test]
+    fn huge_indices_and_exhausted_key_work_decline_without_an_unpaid_walk() {
+        let(e,l)=tables();let m=machine(&e,&l);
+        let huge=Closure::new(ExprId(5),EnvFrame::empty().extend_free(FreeId(5)));
+        let exact=key(&m,huge.clone());assert_eq!(exact.exact.spine,vec![huge;3]);
+        assert!(m.exposure_fuel.get().unwrap()>4000);
+        let closed=Closure::new(ExprId(1),EnvFrame::empty());
+        let alias=Closure::new(ExprId(0),EnvFrame::empty().extend(closed));
+        m.exposure_fuel.set(Some(1));assert!(m.completed_replay_key(NameId(1),&[],&vec![alias;3]).is_none());
+    }
