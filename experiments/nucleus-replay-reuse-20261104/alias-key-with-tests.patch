+    // This follows exactly the evaluator's immutable BVar->Closure steps.
+    // Free/neutral/numeric bindings retain their source frame. Only syntax
+    // leaves with no term captures may discard an irrelevant ambient frame;
+    // the actual captured universe substitution is always retained.
+    // This canonicalizes a memo key, never a typing witness or a desired RHS.
+    fn replay_source_alias(&self,closure:&Closure)->Option<Closure> {
+        let mut current=closure.clone();let mut allowance=64usize;
+        loop {
+            if current.env.id()==0 || allowance==0 {return Some(current);}
+            if !self.reserve_replay_work(1) {return None;}
+            allowance-=1;
+            match self.expressions.get(current.expr) {
+                Some(Expr::BVar(index))=>{
+                    let Some(distance)=usize::try_from(*index).ok().and_then(|n|n.checked_add(1))else{return Some(current);};
+                    if distance>allowance {return Some(current);}
+                    if !self.reserve_replay_work(distance) {return None;}
+                    allowance-=distance;
+                    let Some(EnvBinding::Closure(bound))=current.env.lookup_binding_ref(*index)else{return Some(current);};
+                    current=bound.clone();
+                }
+                Some(Expr::Const{..}|Expr::Sort(_)|Expr::NatLit(_)|Expr::StrLit(_))=>{
+                    current.env=EnvFrame::empty();return Some(current);
+                }
+                _=>return Some(current),
+            }
+        }
+    }
