+// A deliberately finite, fail-closed continuation of source capture checking.
+// Its state is owned by one TypeChecker; a suspended walk is NEVER a warrant.
+// The unchanged ordinary source check remains authoritative outside the
+// experimental projection receiver path.
+pub(crate) struct ResumableSourceOpening {
+    root: Closure,
+    free: FreeId,
+    epoch: u64,
+    pending: Vec<SourceOpeningTask>,
+    visited: HashSet<(ExprId,u64,u64)>,
+    retries: u8,
+}
+
+// A complete syntactic-support certificate says precisely which bindings of
+// the enclosing environment can affect the source. A proof of absence of the
+// opened FreeId therefore transfers to a new environment ONLY if those actual
+// bindings are unchanged. Keep the original closure alive with each warrant.
+#[derive(Clone,Eq,PartialEq,Hash)]
+pub(crate) struct SourceOpeningFootprint {
+    source: ExprId,
+    levels: usize,
+    free: FreeId,
+    epoch: u64,
+    bindings: Vec<SourceCaptureToken>,
+}
+
+#[derive(Clone,Eq,PartialEq,Hash)]
+enum SourceCaptureToken {
+    Free(FreeId),
+    Closure(ExprId,u64,usize),
+    NatLit,
+}
+
+enum SourceOpeningTask {
+    Source(Closure,u64),
+    Scan {
+        support: Vec<u64>,
+        at: usize,
+        virtual_slots: u64,
+        traversed: u64,
+        cursor: EnvFrame,
+    },
+}
+
+enum OpeningProgress { Complete, Pending, Invalid }
+
+fn paid_step(work:&mut usize)->bool {
+    if *work==0{return false}*work-=1;true
+}
+
+fn complete_source_opening_footprint(
+    checker:&TypeChecker<'_>,body:&Closure,free:FreeId,epoch:u64,work:&mut usize,reserve:usize,
+)->Option<SourceOpeningFootprint>{
+    if !paid_step(work){return None}
+    let support=checker.complete_source_support(body.expr,work)?;
+    // Do not begin an optional long walk that cannot finish under the caller's
+    // paid allowance. The maximum selected source index bounds its traversal.
+    let scan=support.last().copied().unwrap_or(0);
+    let required=usize::try_from(scan).ok()?
+        .checked_add(support.len().checked_mul(2)?)?.checked_add(reserve)?;
+    if *work<required{return None}
+    let mut bindings=Vec::new();
+    let mut cursor=body.env.binding_refs();
+    let mut traversed=0u64;
+    for index in support {
+        if !paid_step(work){return None}
+        if index==0 {continue} // virtual binder introduced by opening
+        let target=index.checked_sub(1)?;
+        if target<traversed.saturating_sub(1){return None}
+        let mut selected=None;
+        while traversed<=target {
+            if !paid_step(work){return None}
+            selected=cursor.next();
+            if selected.is_none(){return None}
+            traversed=traversed.checked_add(1)?;
+        }
+        let token=match selected? {
+            EnvBinding::Free(id)=>SourceCaptureToken::Free(*id),
+            EnvBinding::Closure(c)=>SourceCaptureToken::Closure(c.expr,c.env.id(),c.levels.identity()),
+            EnvBinding::NatLit(_)=>SourceCaptureToken::NatLit,
+            EnvBinding::Neutral(_)=>return None, // no unproved neutral normalization
+        };
+        if !paid_step(work){return None} // retain and hash one actual token
+        bindings.push(token);
+    }
+    Some(SourceOpeningFootprint{source:body.expr,levels:body.levels.identity(),free,epoch,bindings})
+}
+
+impl ResumableSourceOpening {
+    fn new(body:&Closure,free:FreeId,epoch:u64)->Self{
+        Self {root:body.clone(),free,epoch,
+            pending:vec![SourceOpeningTask::Source(body.clone(),1)],
+            visited:HashSet::new(),retries:0}
+    }
+
+    fn same_key(&self,body:&Closure,free:FreeId,epoch:u64)->bool{
+        self.root.expr==body.expr && self.root.env.id()==body.env.id()
+            && self.root.levels.identity()==body.levels.identity()
+            && self.free==free && self.epoch==epoch
+    }
+
+    fn neutral_children(neutral:&Neutral,free:FreeId,work:&mut usize)->Result<Vec<Closure>,OpeningProgress>{
+        let mut pending=vec![neutral];
+        let mut children=Vec::new();
+        while let Some(node)=pending.pop(){
+            if !paid_step(work){return Err(OpeningProgress::Pending)}
+            match &node.head {
+                NeutralHead::Free(actual) if *actual==free=>return Err(OpeningProgress::Invalid),
+                NeutralHead::Projection{structure,..}=>pending.push(structure),
+                _=>{}
+            }
+            if *work<node.spine.len(){return Err(OpeningProgress::Pending)}
+            *work-=node.spine.len();
+            children.extend(node.spine.iter().cloned());
+        }
+        Ok(children)
+    }
+
+    fn advance(&mut self,checker:&TypeChecker<'_>,work:&mut usize)->OpeningProgress{
+        while let Some(task)=self.pending.pop(){
+            if self.pending.len()>4096||self.visited.len()>4096{return OpeningProgress::Invalid}
+            match task{
+                SourceOpeningTask::Source(source,virtual_slots)=>{
+                    if !paid_step(work){self.pending.push(SourceOpeningTask::Source(source,virtual_slots));return OpeningProgress::Pending}
+                    let key=(source.expr,source.env.id(),virtual_slots);
+                    if self.visited.contains(&key){continue}
+                    let Some(support)=checker.complete_source_support(source.expr,work) else{
+                        self.pending.push(SourceOpeningTask::Source(source,virtual_slots));
+                        return OpeningProgress::Pending;
+                    };
+                    if !paid_step(work){self.pending.push(SourceOpeningTask::Source(source,virtual_slots));return OpeningProgress::Pending}
+                    self.visited.insert(key);
+                    self.pending.push(SourceOpeningTask::Scan {support,at:0,virtual_slots,traversed:0,cursor:source.env});
+                }
+                SourceOpeningTask::Scan{support,mut at,virtual_slots,mut traversed,cursor}=>{
+                    if at>=support.len(){continue}
+                    let requested=support[at];
+                    if requested<virtual_slots{
+                        if !paid_step(work){
+                            self.pending.push(SourceOpeningTask::Scan{support,at,virtual_slots,traversed,cursor});
+                            return OpeningProgress::Pending;
+                        }
+                        at+=1;
+                        self.pending.push(SourceOpeningTask::Scan{support,at,virtual_slots,traversed,cursor});
+                        continue;
+                    }
+                    let needed=requested-virtual_slots;
+                    if traversed>needed{return OpeningProgress::Invalid}
+                    // Read exactly one immutable node and save the cursor.
+                    // Non-selected captured values need not be inspected.
+                    if !paid_step(work){
+                        self.pending.push(SourceOpeningTask::Scan{support,at,virtual_slots,traversed,cursor});
+                        return OpeningProgress::Pending;
+                    }
+                    let Some((binding,parent))=cursor.head_binding()else{return OpeningProgress::Invalid};
+                    let selected=traversed==needed;
+                    let mut children=Vec::new();
+                    if selected{
+                        match binding{
+                            EnvBinding::Free(actual) if *actual==self.free=>return OpeningProgress::Invalid,
+                            EnvBinding::Closure(captured)=>children.push(captured.clone()),
+                            EnvBinding::Neutral(neutral)=>match Self::neutral_children(neutral,self.free,work){
+                                Ok(found)=>children=found,
+                                Err(OpeningProgress::Pending)=>{
+                                    self.pending.push(SourceOpeningTask::Scan{support,at,virtual_slots,traversed,cursor});
+                                    return OpeningProgress::Pending;
+                                }
+                                Err(other)=>return other,
+                            },
+                            _=>{},
+                        }
+                    }
+                    if *work<children.len(){
+                        self.pending.push(SourceOpeningTask::Scan{support,at,virtual_slots,traversed,cursor});
+                        return OpeningProgress::Pending;
+                    }
+                    *work-=children.len();
+                    let next=parent.clone();
+                    traversed+=1;
+                    if selected{at+=1}
+                    self.pending.push(SourceOpeningTask::Scan{support,at,virtual_slots,traversed,cursor:next});
+                    for child in children.into_iter().rev(){
+                        self.pending.push(SourceOpeningTask::Source(child,0));
+                    }
+                }
+            }
+        }
+        OpeningProgress::Complete
+    }
+}
+
+fn source_opening_avoids_capture_resumable(
+    checker:&TypeChecker<'_>,body:&Closure,free:FreeId,work:&mut usize,
+)->bool{
+    if !paid_step(work){return false}
+    if checker.has_source_opening_proof(body,free){return true}
+    let Some(epoch)=checker.source_reuse_epoch()else{return false};
+    // Completed source support is sufficient to form an observational key:
+    // only the actual captures the source can reference are compared. A key
+    // hit is a previously FULLY checked absence proof; partial walks cannot
+    // populate this cache, and unknown neutral captures never join a key.
+    let prefix=(body.expr,body.levels.identity(),free,epoch);
+    let previously_certified=checker.source_opening_footprint_prefixes.borrow().contains(&prefix);
+    let footprint=if previously_certified && *work>=16 {
+        complete_source_opening_footprint(checker,body,free,epoch,work,0)
+    }else{None};
+    if let Some(key)=footprint.as_ref(){
+        let known=checker.source_opening_footprints.borrow().contains_key(key);
+        if known && *work>=key.bindings.len().saturating_add(1) {
+            *work-=key.bindings.len().saturating_add(1);
+            checker.retain_source_opening_proof(body,free);
+            return true;
+        }
+    }
+    let mut entries=checker.resumed_source_openings.borrow_mut();
+    let mut existing=None;
+    for (i,entry) in entries.iter().enumerate(){
+        if !paid_step(work){return false}
+        if entry.same_key(body,free,epoch){existing=Some(i);break}
+    }
+    let index=if let Some(index)=existing{index}else{
+        if entries.len()>=64{return false}
+        if !paid_step(work){return false}
+        entries.push(ResumableSourceOpening::new(body,free,epoch));
+        entries.len()-1
+    };
+    let state=&mut entries[index];
+    state.retries=state.retries.saturating_add(1);
+    let result=state.advance(checker,work);
+    match result{
+        OpeningProgress::Complete=>{
+            entries.swap_remove(index);
+            drop(entries);
+            checker.retain_source_opening_proof(body,free);
+            let completed_footprint=footprint.or_else(||{
+                // Speculative memo construction must not consume the tight
+                // remainder needed to finish a current congruence trial.
+                if *work>=128 {complete_source_opening_footprint(checker,body,free,epoch,work,64)}
+                else {None}
+            });
+            if let Some(key)=completed_footprint {
+                let mut proofs=checker.source_opening_footprints.borrow_mut();
+                if proofs.len()<4096 {
+                    proofs.entry(key).or_insert_with(||body.clone());
+                    checker.source_opening_footprint_prefixes.borrow_mut().insert(prefix);
+                }
+            }
+            true
+        }
+        OpeningProgress::Invalid=>{entries.swap_remove(index);false}
+        OpeningProgress::Pending=>{
+            if entries[index].retries==u8::MAX{entries.swap_remove(index);}
+            false
+        }
+    }
+}
