+ fn source_opening_two_paid_visits_must_resume_without_minting_proof() {
+     let _scope=crate::run_flags::enter();
+     let (mut e,l,environment)=fixture();
+     // Under the virtual binder, BVar(201) selects capture index 200.
+     e.insert(ExprId(30),Expr::BVar(201)).unwrap();
+     let checker=TypeChecker::new(&e,&l,&environment);
+     let mut safe_env=crate::value::EnvFrame::empty();
+     for _ in 0..201 { safe_env=safe_env.extend_free(crate::value::FreeId(1)); }
+     let safe=Closure::new(ExprId(30),safe_env);
+     let mut first=128;
+     assert!(!source_opening_avoids_capture_resumable(&checker,&safe,crate::value::FreeId(0),&mut first),
+         "a partial traversal must not mint a capture warrant");
+     let mut none=0;
+     assert!(!source_opening_avoids_capture_resumable(&checker,&safe,crate::value::FreeId(0),&mut none),
+         "a zero-work revisit must not complete an unfinished check");
+     let mut second=128;
+     assert!(source_opening_avoids_capture_resumable(&checker,&safe,crate::value::FreeId(0),&mut second),
+         "verified earlier steps must survive an exhausted caller allowance");
+     let mut malicious_env=crate::value::EnvFrame::empty().extend_free(crate::value::FreeId(0));
+     for _ in 0..200 { malicious_env=malicious_env.extend_free(crate::value::FreeId(1)); }
+     let malicious=Closure::new(ExprId(30),malicious_env);
+     let mut mal_first=128;
+     assert!(!source_opening_avoids_capture_resumable(&checker,&malicious,crate::value::FreeId(0),&mut mal_first));
+     let mut mal_second=128;
+     assert!(!source_opening_avoids_capture_resumable(&checker,&malicious,crate::value::FreeId(0),&mut mal_second),
+         "completed absence for a different environment is never evidence");
+     let mut other_free=4096;
+     assert!(!source_opening_avoids_capture_resumable(&checker,&safe,crate::value::FreeId(1),&mut other_free),
+         "an actual captured Free(1) must not be mistaken for safe Free(0)");
+ }
+ #[test]
+ fn source_support_footprint_reuses_only_referenced_capture_across_distinct_frames() {
+     let _scope=crate::run_flags::enter();
+     let (mut expressions,levels,environment)=fixture();
+     // The root source references only its head capture; a different tail
+     // must not change the proved absence of Free(0) in that capture.
+     expressions.insert(ExprId(30),Expr::BVar(1)).unwrap();
+     expressions.insert(ExprId(31),Expr::BVar(200)).unwrap();
+     let checker=TypeChecker::new(&expressions,&levels,&environment);
+     let mut inner=crate::value::EnvFrame::empty();
+     for _ in 0..201 {inner=inner.extend_free(FreeId(1));}
+     let shared=Closure::new(ExprId(31),inner);
+     let a=Closure::new(ExprId(30),crate::value::EnvFrame::empty().extend(shared.clone()));
+     let b=a.sibling(ExprId(30),crate::value::EnvFrame::empty().extend_free(FreeId(0)).extend(shared));
+     assert_ne!(a.env.id(),b.env.id());
+     let mut first=1024;
+     assert!(source_opening_avoids_capture_resumable(&checker,&a,FreeId(0),&mut first));
+     let mut reused=24;
+     assert!(source_opening_avoids_capture_resumable(&checker,&b,FreeId(0),&mut reused),
+         "a complete support fingerprint should transfer across an unrelated enclosing binding");
+     let mut none=0;
+     assert!(!source_opening_avoids_capture_resumable(&checker,&b,FreeId(0),&mut none),
+         "even a completed support footprint requires a caller work unit");
+     let distinct_level_owner=Closure::new(ExprId(30),b.env.clone());
+     let mut different_levels=24;
+     assert!(!source_opening_avoids_capture_resumable(&checker,&distinct_level_owner,FreeId(0),&mut different_levels),
+         "a different level-instance identity cannot borrow the cached proof");
+     let mut harmful=crate::value::EnvFrame::empty().extend_free(FreeId(0));
+     for _ in 0..200 { harmful=harmful.extend_free(FreeId(1)); }
+     let changed=a.sibling(ExprId(30),crate::value::EnvFrame::empty()
+         .extend(Closure::new(ExprId(31),harmful)));
+     let mut negative=1024;
+     assert!(!source_opening_avoids_capture_resumable(&checker,&changed,FreeId(0),&mut negative),
+         "a changed referenced closure must not reuse the unrelated certified wrapper");
+     let mut changed_free=1024;
+     assert!(!source_opening_avoids_capture_resumable(&checker,&b,FreeId(1),&mut changed_free),
+         "the capture fingerprint is specific to the exact opened FreeId");
+ }
+ #[test]
+ fn lambda_receiver_reuses_paid_opening_across_trials() {
+     let _scope=crate::run_flags::enter();
+     let (mut e,l,environment)=fixture();
+     e.insert(ExprId(30),Expr::BVar(401)).unwrap();
+     e.insert(ExprId(42),Expr::Lam{domain:ExprId(0),body:ExprId(30)}).unwrap();
+     e.insert(ExprId(43),Expr::Lam{domain:ExprId(0),body:ExprId(30)}).unwrap();
+     let checker=TypeChecker::new(&e,&l,&environment);
+     let mut captured=crate::value::EnvFrame::empty();
+     for _ in 0..401{captured=captured.extend_free(crate::value::FreeId(1));}
+     let left=Closure::new(ExprId(42),captured.clone());
+     let right=Closure::new(ExprId(43),captured);
+     let mut first=320;
+     assert!(!metered_projection_chain(&checker,&left,&right,&[],&[],&mut first,0,&[]),
+         "the first partial source opening must remain unknown");
+     let mut eventually=false;
+     for _ in 0..3{
+         let mut allowance=320;
+         if metered_projection_chain(&checker,&left,&right,&[],&[],&mut allowance,0,&[]){eventually=true;break}
+     }
+     assert!(eventually,
+         "four separately bounded lambda trials must share paid capture progress");
+ }
