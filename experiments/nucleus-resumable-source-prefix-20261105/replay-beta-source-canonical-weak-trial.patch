+    // This is the *actual* evaluator beta step (see expose_uncached_internal):
+    // a BVar bound to an immutable source Closure is a transparent reference
+    // to precisely that Closure. It is not a guessed constructor, a proof of
+    // arbitrary term equality, or a conversion of rigid Free/Neutral locals.
+    // Limit and charge every hop under the caller's finite work owner.
+    fn canonical_replay_beta_closure(&self,mut closure:Closure)->Option<(Closure,usize)> {
+        let mut hops=0usize;
+        while let Some(Expr::BVar(index))=self.expressions.get(closure.expr) {
+            let Some(EnvBinding::Closure(bound))=closure.env.lookup(*index) else {break;};
+            if hops>=256 || !self.reserve_replay_work(1){return None;}
+            closure=bound;
+            hops+=1;
+        }
+        Some((closure,hops))
+    }
