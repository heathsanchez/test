+        machine.exposure_fuel.set(Some(160));
+        assert!(machine.completed_replay_key(NameId(1),&[],&spine).is_some(),
+            "immutable recursor certificate must not be independently copied/hashed for every exact source key");
+        machine.exposure_fuel.set(None);
+    }
