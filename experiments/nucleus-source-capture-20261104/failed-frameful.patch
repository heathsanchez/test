+// Minimum external term bindings needed by an immutable source expression.
+// A completed zero is a sufficient syntactic proof of capture independence.
+// Missing syntax, overflow, cycles/depth and exhausted work never grant zero.
+fn source_binding_need(expressions:&IdTable<ExprId,Expr>,authority:AuthorityId,
+    expression:ExprId,known:&HashMap<(AuthorityId,ExprId),u64>,
+    completed:&mut HashMap<ExprId,u64>,work:&mut usize,depth:usize)->Option<u64> {
+    if *work==0 || depth>=128{return None;} *work-=1;
+    if let Some(need)=known.get(&(authority,expression)).or_else(||completed.get(&expression)){return Some(*need);}
+    let need=match expressions.get(expression)? {
+        Expr::BVar(index)=>index.checked_add(1)?,
+        Expr::NatLit(_)|Expr::StrLit(_)|Expr::Sort(_)|Expr::Const{..}=>0,
+        Expr::App{fun,arg}=>{
+            let a=source_binding_need(expressions,authority,*fun,known,completed,work,depth+1)?;
+            a.max(source_binding_need(expressions,authority,*arg,known,completed,work,depth+1)?)
+        }
+        Expr::Lam{domain,body}|Expr::Pi{domain,body}=>{
+            let a=source_binding_need(expressions,authority,*domain,known,completed,work,depth+1)?;
+            a.max(source_binding_need(expressions,authority,*body,known,completed,work,depth+1)?.saturating_sub(1))
+        }
+        Expr::Let{ty,value,body}|Expr::LetNondep{ty,value,body}=>{
+            let a=source_binding_need(expressions,authority,*ty,known,completed,work,depth+1)?;
+            let b=source_binding_need(expressions,authority,*value,known,completed,work,depth+1)?;
+            a.max(b).max(source_binding_need(expressions,authority,*body,known,completed,work,depth+1)?.saturating_sub(1))
+        }
+        Expr::Proj{structure,..}=>source_binding_need(expressions,authority,*structure,known,completed,work,depth+1)?,
+    };
+    completed.insert(expression,need);Some(need)
+}
