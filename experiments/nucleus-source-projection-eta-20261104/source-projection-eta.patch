+    fn checked_source_projection_template(&self,owner:NameId,index:usize,fuel:&mut usize)->Option<ExprId>{
+        fn inspect(checker:&TypeChecker<'_>,declaration:NameId,owner:NameId,index:usize,fuel:&mut usize)->Option<ExprId>{
+            if !take_step(fuel){return None;}
+            let mut expression=checker.environment.get(declaration)?.value?;
+            let mut lambdas=0;
+            for _ in 0..16{
+                if !take_step(fuel){return None;}
+                match checker.expression(expression)?{
+                    Expr::Lam{body,..}=>{lambdas+=1;expression=*body;},
+                    Expr::Proj{type_name,index:actual_index,structure}if lambdas>0&&*type_name==owner&&usize::try_from(*actual_index).ok()==Some(index)=>{
+                        if !take_step(fuel){return None;}
+                        return matches!(checker.expression(*structure),Some(Expr::BVar(0))).then_some(expression);
+                    },
+                    _=>return None,
+                }
+            }
+            None
+        }
+        if let Some((declaration,expression))=self.environment.cached_source_projection_template(owner,index){
+            if inspect(self,declaration,owner,index,fuel)==Some(expression){return Some(expression);}
+        }
+        // This is candidate discovery only. Numeric proximity never licenses
+        // a field: each hit must be an admitted declaration with the exact
+        // literal owner/index/BVar(0) body. Unknown searches retain no absence.
+        for offset in 0..2048u64{
+            if !take_step(fuel){return None;}
+            let declaration=NameId(owner.0.checked_add(offset)?);
+            if let Some(expression)=inspect(self,declaration,owner,index,fuel){
+                self.environment.retain_source_projection_template(owner,index,declaration,expression,fuel);
+                return Some(expression);
+            }
+        }
+        None
+    }
+    /// Reduce the receiver of one actual registered source projection by
+    /// typed record eta/iota, then select only that original field.
+    pub(crate) fn checked_record_eta_projection(
+        &self, neutral:&Neutral, context:&[TypeValue], budget:&mut usize,
+    )->Option<Closure>{
+        let NeutralHead::Projection{type_name,index,structure}=&neutral.head else{return None};
+        if !neutral.spine.is_empty(){return None;}
+        let spec=self.environment.projection_spec(*type_name)?;
+        if *index>=spec.field_types.len() || spec.field_types.len()>8 || spec.num_params>8{return None;}
+        let rhs=self.checked_record_recursor_eta(structure,context,budget)?;
+        let grant=(*budget/4).min(1024);if grant==0{return None;}*budget-=grant;
+        let exposed=self.machine().expose_for_conversion(rhs,Transparency::Full,grant);
+        let Judgment::Proven{value:Value::Neutral(actual),..}=exposed else{return None};
+        let NeutralHead::Const{name,levels}=&actual.head else{return None};
+        if *name!=spec.constructor || actual.spine.len()!=spec.num_params+spec.field_types.len()
+            || self.environment.get(*name)?.level_params.len()!=levels.len(){return None;}
+        // Move the original field closure; do not reconstruct a value from
+        // the expected result or clone an arbitrary neutral receiver.
+        actual.spine.into_iter().nth(spec.num_params+*index)
     }
 
