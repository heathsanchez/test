+    pub(crate) fn retain_source_projection_template(&self,owner:NameId,index:usize,declaration:NameId,expression:ExprId,fuel:&mut usize){
+        let mut facts=self.source_projection_templates.borrow_mut();
+        let new=!facts.contains_key(&(owner,index));
+        if new&&facts.len()>=512{return;}
+        // Cache retention is optional. Pay a conservative table-growth
+        // allowance before allocation; never let memo growth grant work.
+        let cost=if new&&facts.len()==facts.capacity(){facts.capacity().saturating_mul(2).saturating_add(8)}else{1};
+        if *fuel<cost{return;}*fuel-=cost;
+        facts.insert((owner,index),(declaration,expression));
     }
 
