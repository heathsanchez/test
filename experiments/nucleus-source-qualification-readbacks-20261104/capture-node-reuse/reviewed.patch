+#[cfg(test)]
+mod capture_node_reuse_controls {
+ use super::*;
+ use crate::{environment::Environment,id::{IdTable,LevelId},syntax::Level,value::EnvFrame};
+ fn fixture()->(IdTable<ExprId,Expr>,IdTable<LevelId,Level>,Environment){
+  let mut e=IdTable::default();let mut l=IdTable::default();l.insert(LevelId(0),Level::Zero).unwrap();
+  e.insert(ExprId(0),Expr::Sort(LevelId(0))).unwrap();e.insert(ExprId(1),Expr::BVar(1)).unwrap();e.insert(ExprId(2),Expr::BVar(0)).unwrap();(e,l,Environment::empty())
+ }
+ #[test]fn completed_inner_capture_fact_serves_a_distinct_opening_root(){
+  let(e,l,env)=fixture();let c=TypeChecker::new(&e,&l,&env);
+  let captured=Closure::new(ExprId(2),EnvFrame::empty().extend_free(FreeId(9)));
+  let a=Closure::new(ExprId(1),EnvFrame::empty().extend(captured.clone()));
+  let b=Closure::new(ExprId(1),EnvFrame::empty().extend(captured));assert_ne!(a.env.id(),b.env.id());
+  assert!(!source_opening_avoids_capture(&c,&b,FreeId(0),&mut 5));
+  assert!(source_opening_avoids_capture(&c,&a,FreeId(0),&mut 128));
+  let mut work=5;assert!(source_opening_avoids_capture(&c,&b,FreeId(0),&mut work),"reuse the completed shared inner fact, not the different outer opening");assert_eq!(work,0);
+ }
+ #[test]fn opening_virtual_binder_fact_never_becomes_an_inner_capture_fact(){
+  let(e,l,env)=fixture();let c=TypeChecker::new(&e,&l,&env);
+  let inner=Closure::new(ExprId(2),EnvFrame::empty().extend_free(FreeId(0)));
+  assert!(source_opening_avoids_capture(&c,&inner,FreeId(0),&mut 128));
+  let outer=Closure::new(ExprId(1),EnvFrame::empty().extend(inner));
+  assert!(!source_opening_avoids_capture(&c,&outer,FreeId(0),&mut 128));
+ }
+ #[test]fn completed_inner_fact_does_not_cross_free_identity(){
+  let(e,l,env)=fixture();let c=TypeChecker::new(&e,&l,&env);
+  let inner=Closure::new(ExprId(2),EnvFrame::empty().extend_free(FreeId(9)));
+  for free in[0,9]{let outer=Closure::new(ExprId(1),EnvFrame::empty().extend(inner.clone()));assert_eq!(source_opening_avoids_capture(&c,&outer,FreeId(free),&mut 128),free==0);}
+ }
