+mod nested_projection_receiver_controls {
+ use super::*;
+ fn fixture()->(IdTable<ExprId,Expr>,IdTable<LevelId,Level>){
+  let mut e=IdTable::default();let mut l=IdTable::default();l.insert(LevelId(0),Level::Zero).unwrap();
+  for(id,x)in[(0,Expr::BVar(0)),(1,Expr::Sort(LevelId(0))),(2,Expr::Const{name:NameId(91),levels:vec![]}),(3,Expr::Proj{type_name:NameId(99),index:0,structure:ExprId(2)}),(4,Expr::Proj{type_name:NameId(100),index:0,structure:ExprId(3)}),(5,Expr::App{fun:ExprId(4),arg:ExprId(0)}),(6,Expr::Proj{type_name:NameId(100),index:1,structure:ExprId(3)}),(7,Expr::Const{name:NameId(92),levels:vec![]}),(8,Expr::Proj{type_name:NameId(100),index:0,structure:ExprId(7)})]{e.insert(ExprId(id),x).unwrap();}
+  for(id,x)in[(9,Expr::Const{name:NameId(90),levels:vec![]}),(10,Expr::Const{name:NameId(101),levels:vec![]}),(11,Expr::App{fun:ExprId(10),arg:ExprId(2)}),(12,Expr::App{fun:ExprId(9),arg:ExprId(11)}),(13,Expr::Proj{type_name:NameId(99),index:0,structure:ExprId(12)}),(14,Expr::Proj{type_name:NameId(100),index:0,structure:ExprId(13)}),(15,Expr::App{fun:ExprId(14),arg:ExprId(0)}),(16,Expr::Proj{type_name:NameId(100),index:0,structure:ExprId(10)})]{e.insert(ExprId(id),x).unwrap();}(e,l)
+ }
+ fn machine<'a>(e:&'a IdTable<ExprId,Expr>,l:&'a IdTable<LevelId,Level>)->Machine<'a>{
+  Machine::new(AuthorityId(0),e,l,HashMap::from([(NameId(92),DefinitionBody{value:ExprId(8),preferred_for_reduction:false,level_params:vec![]})]))
+   .with_projection_specs(HashMap::from([(NameId(99),ProjectionSpec{constructor:NameId(90),num_params:0,field_types:vec![ProjectionFieldType::Derived(ExprId(1))],eta_expandable:false}),(NameId(100),ProjectionSpec{constructor:NameId(101),num_params:0,field_types:vec![ProjectionFieldType::Derived(ExprId(1))],eta_expandable:false})]))
+ }
+ #[test]fn nested_source_neutral_projection_keeps_both_owners_and_actual_pending_spine(){
+  let(e,l)=fixture();let m=machine(&e,&l);let frame=EnvFrame::empty().extend_free(FreeId(7));let mut work=1024;let result=m.expose_projection_for_conversion_metered(Closure::new(ExprId(5),frame.clone()),&mut work);
+  let Some(Value::Neutral(n))=result.proven_value()else{panic!("nested neutral projection lost: {result:?}")};
+  assert!(matches!(&n.head,NeutralHead::Projection{type_name:NameId(100),index:0,structure}if matches!(&structure.head,NeutralHead::Projection{type_name:NameId(99),index:0,structure}if matches!(&structure.head,NeutralHead::Const{name:NameId(91),levels}if levels.is_empty()))));
+  assert_eq!(n.spine,vec![Closure::new(ExprId(0),frame)]);assert!(work>0&&work<1024);assert_eq!(m.exposure_fuel.get(),None);
+ }
+ #[test]fn nested_receiver_cannot_borrow_from_an_exhausted_or_smaller_parent(){
+  let(e,l)=fixture();for parent in[0,1]{let m=machine(&e,&l);m.exposure_fuel.set(Some(parent));let mut work=1024;assert!(m.expose_projection_for_conversion_metered(Closure::new(ExprId(4),EnvFrame::empty()),&mut work).is_unknown());assert_eq!(work,1024-parent);assert_eq!(m.exposure_fuel.get(),Some(0));}
+ }
+ #[test]fn nested_projection_out_of_range_never_becomes_a_neutral_field(){
+  let(e,l)=fixture();let m=machine(&e,&l);let mut work=1024;assert!(m.expose_projection_for_conversion_metered(Closure::new(ExprId(6),EnvFrame::empty()),&mut work).is_unknown());assert!(work<1024);assert_eq!(m.exposure_fuel.get(),None);
+ }
+ #[test]fn cyclic_nested_receiver_stays_incomplete_and_restores_its_owner(){
+  let(e,l)=fixture();let m=machine(&e,&l);let mut work=1024;assert!(m.expose_projection_for_conversion_metered(Closure::new(ExprId(8),EnvFrame::empty()),&mut work).is_unknown());assert!(work<1024);assert_eq!(m.exposure_fuel.get(),None);assert_eq!(m.neutral_projection_depth.get(),0);
+ }
+ #[test]fn actual_nested_constructor_fields_are_selected_instead_of_synthesizing_a_neutral(){
+  let(e,l)=fixture();let m=machine(&e,&l);let frame=EnvFrame::empty().extend_free(FreeId(7));let mut work=1024;let result=m.expose_projection_for_conversion_metered(Closure::new(ExprId(15),frame.clone()),&mut work);
+  assert!(matches!(result.proven_value(),Some(Value::Neutral(n))if matches!(&n.head,NeutralHead::Const{name:NameId(91),levels}if levels.is_empty())&&n.spine==vec![Closure::new(ExprId(0),frame)]));assert!(work<1024);assert_eq!(m.exposure_fuel.get(),None);assert_eq!(m.neutral_projection_depth.get(),0);
+ }
