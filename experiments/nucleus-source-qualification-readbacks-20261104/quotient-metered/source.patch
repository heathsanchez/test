+  b"succ"=>Level::Succ(LevelId(c.num()?)),b"param"=>Level::Param(NameId(c.num()?)),
+  b"max"|b"imax"=>{let(a,b)=c.pair()?;if tag==b"max"{Level::Max(LevelId(a),LevelId(b))}else{Level::IMax(LevelId(a),LevelId(b))}},_=>return None,
