+    // Diagnostic-only conservative whole-capture envelope. Uses an isolated
+    // checker so no unpaid source facts enter the measured checker.
+    #[cfg(feature="diagnostics")]
+    pub(crate) fn diagnostic_capture_envelope(&self,body:&Closure)->(bool,Option<u64>,usize,usize,&'static str){
+        let probe=TypeChecker::new(self.expressions,self.levels,self.environment);
+        let mut work=65536usize;let mut pending=vec![(body.clone(),1u64)];let mut closures=std::collections::HashSet::new();let mut frames=HashMap::new();let mut max_free:Option<u64>=None;let mut count=0usize;let mut bindings=0usize;
+        while let Some((source,virtual_slots))=pending.pop(){
+            if work==0{return(false,max_free,count,bindings,"diagnostic-cap");}work-=1;
+            if !closures.insert((source.expr,source.env.id(),source.levels.identity(),virtual_slots)){continue;}
+            count+=1;
+            let Some(support)=probe.complete_source_support(source.expr,&mut work)else{return(false,max_free,count,bindings,"source-support");};
+            let len=if let Some(len)=frames.get(&source.env.id()){*len}else{
+                let mut len=0u64;
+                for binding in source.env.binding_refs(){
+                    if work==0{return(false,max_free,count,bindings,"diagnostic-cap");}work-=1;bindings+=1;len+=1;
+                    match binding{
+                        EnvBinding::Free(f)=>max_free=Some(max_free.map_or(f.0,|m|m.max(f.0))),
+                        EnvBinding::Closure(c)=>pending.push((c.clone(),0)),
+                        EnvBinding::NatLit(_)=>{},
+                        EnvBinding::Neutral(n)=>{
+                            let mut neutrals=vec![n];while let Some(n)=neutrals.pop(){
+                                if work==0{return(false,max_free,count,bindings,"diagnostic-cap");}work-=1;
+                                match &n.head{
+                                    NeutralHead::Free(f)=>max_free=Some(max_free.map_or(f.0,|m|m.max(f.0))),
+                                    NeutralHead::Projection{structure,..}=>neutrals.push(structure),
+                                    NeutralHead::Const{..}=>{},
+                                }
+                                pending.extend(n.spine.iter().map(|c|(c.clone(),0)));
+                            }
+                        }
+                    }
+                }
+                frames.insert(source.env.id(),len);len
+            };
+            let Some(bound)=len.checked_add(virtual_slots)else{return(false,max_free,count,bindings,"scope-overflow");};
+            if support.last().is_some_and(|i|*i>=bound){return(false,max_free,count,bindings,"out-of-scope-capture");}
+        }
+        (true,max_free,count,bindings,"complete")
+    }
