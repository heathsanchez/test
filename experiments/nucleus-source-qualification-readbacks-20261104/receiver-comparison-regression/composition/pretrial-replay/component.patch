+/// The existing universe calculus, charged to the caller's remaining work.
+pub(crate) fn level_equal_metered(left: LevelTerm, right: LevelTerm, remaining: &mut usize) -> Judgment<()> {
+    let mut budget = Budget::new(*remaining);
+    let result = level_equal_with_budget(left, right, &mut budget);
+    *remaining = budget.remaining;
+    result
