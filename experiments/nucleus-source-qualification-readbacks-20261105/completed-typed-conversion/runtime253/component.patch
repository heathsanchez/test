+#[derive(Clone,Eq,PartialEq,Hash)]
+struct CompletedTypedConversionKey{
+ left:(ExprId,u64),right:(ExprId,u64),context_len:usize,strict:bool,flags:[u64;2],epoch:u64,fallback:bool,
+}
+impl CompletedTypedConversionKey{fn set(&self)->usize{use std::hash::{Hash,Hasher};let mut h=std::collections::hash_map::DefaultHasher::new();self.hash(&mut h);(h.finish()as usize)%32}}
+// This namespace contains typed VALUE equality, never inferred types or
+// unscoped source congruence. Owners pin every environment and universe map.
+struct CompletedTypedConversionFact{key:CompletedTypedConversionKey,left:Closure,right:Closure,context:Vec<Closure>}
+impl CompletedTypedConversionFact{
+ fn same(a:&Closure,b:&Closure,work:&mut usize)->bool{
+  take_step(work)&&(a.expr,a.env.id())==(b.expr,b.env.id())&&TypeChecker::exact_source_levels(&a.levels,&b.levels,work)
+ }
+ fn matches(&self,left:&Closure,right:&Closure,context:&[TypeValue],work:&mut usize)->bool{
+  self.context.len()==context.len()&&Self::same(&self.left,left,work)&&Self::same(&self.right,right,work)
+   &&self.context.iter().zip(context).all(|(a,b)|matches!(b,TypeValue::Term(b)if Self::same(a,b,work)))
+ }
+ fn relinquishable(&self)->bool{crate::value::captures_reclaimable(std::iter::once(&self.left).chain(std::iter::once(&self.right)).chain(self.context.iter()))}
+}
+struct CompletedTypedConversionMemo{slots:Box<[Option<CompletedTypedConversionFact>]>,hand:[u8;32]}
+impl Default for CompletedTypedConversionMemo{fn default()->Self{Self{slots:std::iter::repeat_with(||None).take(128).collect::<Vec<_>>().into_boxed_slice(),hand:[0;32]}}}
