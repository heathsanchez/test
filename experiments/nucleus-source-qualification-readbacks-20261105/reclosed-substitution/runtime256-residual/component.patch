+    // Pure syntax congruence after actual capture substitution. Intrinsic
+    // binders and ambient free variables have disjoint identities. No cached
+    // raw-closure fact is consulted under a virtual binder.
+    pub(crate)fn reclosed_source_congruence(&self,left:&Closure,right:&Closure,remaining:&mut usize)->bool{
+        enum Head{Bound(u64),Free(FreeId),Nat(crate::nat::BigNat),Node(Closure,u64)}
+        fn debit(work:&mut usize,cost:usize)->bool{if *work<cost{return false}*work-=cost;true}
+        fn expose(c:&TypeChecker,mut term:Closure,mut intrinsic:u64,depth:u64,work:&mut usize)->Option<Head>{
+            if intrinsic>depth{return None}
+            loop{
+                if !take_step(work){return None}
+                match c.expressions.get(term.expr)?{
+                    Expr::BVar(index)if *index<intrinsic=>return Some(Head::Bound(depth.checked_sub(1+index)?)),
+                    Expr::BVar(index)=>{
+                        let index=index.checked_sub(intrinsic)?;
+                        let cost=usize::try_from(index).ok()?.checked_add(1)?;
+                        if !debit(work,cost){return None}
+                        match term.env.lookup_binding_ref(index)?{
+                            EnvBinding::Free(f)=>return Some(Head::Free(*f)),
+                            EnvBinding::Neutral(Neutral{head:NeutralHead::Free(f),spine})if spine.is_empty()=>return Some(Head::Free(*f)),
+                            EnvBinding::Closure(child)=>{term=child.clone();intrinsic=0;},
+                            EnvBinding::NatLit(n)=>{if !debit(work,n.limb_count()){return None}return Some(Head::Nat(n.clone()))},
+                            _=>return None,
+                        }
+                    }
+                    Expr::NatLit(n)=>{if !debit(work,n.limb_count()){return None}return Some(Head::Nat(n.clone()))},
+                    _=>return Some(Head::Node(term,intrinsic)),
+                }
+            }
+        }
+        let mut pending=vec![(left.clone(),0u64,right.clone(),0u64,0u64)];
+        while let Some((left,kl,right,kr,depth))=pending.pop(){
+            if !take_step(remaining){return false}
+            let(Some(a),Some(b))=(expose(self,left,kl,depth,remaining),expose(self,right,kr,depth,remaining))else{return false};
+            match(a,b){
+                (Head::Bound(a),Head::Bound(b))if a==b=>{},
+                (Head::Free(a),Head::Free(b))if a==b=>{},
+                (Head::Nat(a),Head::Nat(b))=>{if !debit(remaining,a.limb_count().max(b.limb_count()))||a!=b{return false}},
+                (Head::Node(a,ka),Head::Node(b,kb))=>{
+                    let(Some(x),Some(y))=(self.expressions.get(a.expr),self.expressions.get(b.expr))else{return false};
+                    let mut push=|x,y,ka,kb,depth|pending.push((a.sibling(x,a.env.clone()),ka,b.sibling(y,b.env.clone()),kb,depth));
+                    match(x,y){
+                        (Expr::Sort(x),Expr::Sort(y))=>if !self.exact_instantiated_source_level(*x,&a.levels,*y,&b.levels,remaining){return false},
+                        (Expr::Const{name:x,levels:xs},Expr::Const{name:y,levels:ys})if x==y&&xs.len()==ys.len()=>{
+                            for(x,y)in xs.iter().zip(ys){if !self.exact_instantiated_source_level(*x,&a.levels,*y,&b.levels,remaining){return false}}
+                        }
+                        (Expr::App{fun:x,arg:u},Expr::App{fun:y,arg:v})=>{push(*u,*v,ka,kb,depth);push(*x,*y,ka,kb,depth);},
+                        (Expr::Lam{domain:x,body:u},Expr::Lam{domain:y,body:v})
+                        |(Expr::Pi{domain:x,body:u},Expr::Pi{domain:y,body:v})=>{
