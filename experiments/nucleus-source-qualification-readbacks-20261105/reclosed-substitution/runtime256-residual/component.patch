+                            push(*u,*v,ka1,kb1,next);push(*x,*y,ka,kb,depth);
+                        }
+                        (Expr::Let{ty:x,value:u,body:m},Expr::Let{ty:y,value:v,body:n})
+                        |(Expr::LetNondep{ty:x,value:u,body:m},Expr::LetNondep{ty:y,value:v,body:n})=>{
+                            let(Some(next),Some(ka1),Some(kb1))=(depth.checked_add(1),ka.checked_add(1),kb.checked_add(1))else{return false};
+                            push(*m,*n,ka1,kb1,next);push(*u,*v,ka,kb,depth);push(*x,*y,ka,kb,depth);
+                        }
+                        (Expr::Proj{type_name:x,index:i,structure:u},Expr::Proj{type_name:y,index:j,structure:v})if x==y&&i==j=>push(*u,*v,ka,kb,depth),
+                        (Expr::StrLit(x),Expr::StrLit(y))=>if !debit(remaining,x.len().max(y.len()))||x!=y{return false},
+                        _=>return false,
+                    }
                 }
                 _=>return false,
             }
