+    pub(crate)fn completed_core_conversion_key(&self,left:&TypeValue,right:&TypeValue,context:&[TypeValue],depth:usize,congruence_depth:usize,policy:crate::convert::DeltaPolicy,budget:usize)->Option<CompletedCoreConversionKey>{
