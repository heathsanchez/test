+    pub(crate)fn reuse_completed_core_conversion(&self,key:&CompletedCoreConversionKey,context:&[TypeValue])->bool{
+        let table=self.completed_core_conversion.borrow();
+        table.slots[key.set()*4..key.set()*4+4].iter().any(|slot|slot.as_ref().is_some_and(|fact|&fact.key==key&&fact.same_context(context)))
+    }
+    pub(crate)fn retain_completed_core_conversion(&self,key:CompletedCoreConversionKey,left:&TypeValue,right:&TypeValue,context:&[TypeValue]){
