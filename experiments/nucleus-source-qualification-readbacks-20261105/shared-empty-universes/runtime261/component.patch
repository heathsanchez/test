+        let mut table=self.completed_core_conversion.borrow_mut();let set=key.set();let start=table.hand[set]as usize;
+        for offset in 0..4{
+            let within=(start+offset)%4;let index=set*4+within;
+            if table.slots[index].as_ref().is_none_or(CompletedCoreConversionFact::relinquishable){
+                let context=context.iter().map(|x|{let TypeValue::Term(x)=x else{unreachable!()};x.clone()}).collect();
+                table.slots[index]=Some(CompletedCoreConversionFact{key,left:left.clone(),right:right.clone(),context});
+                table.hand[set]=((within+1)%4)as u8;break;
+            }
+        }
+    }
