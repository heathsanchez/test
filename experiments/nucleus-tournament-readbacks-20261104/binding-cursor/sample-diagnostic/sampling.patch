+// Diagnostic sampling only; never contributes a judgment or changes fuel.
+pub(crate) fn pulse(tag: &str) {
+    if DECLARATIONS.get() != 3106 {return;}
+    thread_local! {
+        static N:Cell<u64>=const{Cell::new(0)};
+        static LAST:std::cell::RefCell<Option<std::time::Instant>>=const{std::cell::RefCell::new(None)};
+    }
+    let n=N.get()+1;N.set(n);if n%4096!=0{return;}
+    LAST.with(|last|{
+        let mut last=last.borrow_mut();
+        if last.is_none_or(|t|t.elapsed().as_secs()>=5){
+            *last=Some(std::time::Instant::now());
+            eprintln!("NUCLEUS_SAMPLE:tag={tag}:n={n}:backtrace={}",std::backtrace::Backtrace::force_capture());
+        }
+    });
+}
