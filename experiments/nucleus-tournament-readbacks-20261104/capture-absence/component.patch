+ fn fixture()->(IdTable<ExprId,Expr>,IdTable<LevelId,Level>,Environment){let mut e=IdTable::default();for(id,x)in[(0,Expr::BVar(0)),(1,Expr::BVar(1)),(2,Expr::Pi{domain:ExprId(1),body:ExprId(1)}),(3,Expr::BVar(2)),(4,Expr::Pi{domain:ExprId(1),body:ExprId(3)}),(5,Expr::Lam{domain:ExprId(0),body:ExprId(5)})]{e.insert(ExprId(id),x).unwrap();}(e,IdTable::default(),Environment::empty())}
+ fn chain(free:u64)->Closure{let mut c=Closure::new(ExprId(0),EnvFrame::empty().extend_free(FreeId(free)));for _ in 0..12{c=Closure::new(ExprId(0),EnvFrame::empty().extend(c));}c}
+ #[test]fn completed_shared_capture_proofs_reuse_across_distinct_root_bodies(){let(e,l,env)=fixture();let c=TypeChecker::new(&e,&l,&env);let frame=EnvFrame::empty().extend(chain(9));let first=Closure::new(ExprId(1),frame.clone());let second=Closure::new(ExprId(4),frame);assert!(crate::convert::source_opening_avoids_capture(&c,&first,FreeId(0),&mut 4096));assert!(crate::convert::source_opening_avoids_capture(&c,&second,FreeId(0),&mut 32));}
+ #[test]fn a_used_captured_free_cannot_be_hidden_by_an_opened_virtual_slot(){let(e,l,env)=fixture();let c=TypeChecker::new(&e,&l,&env);let frame=EnvFrame::empty().extend(chain(0));let internal=Closure::new(ExprId(0),frame.clone());assert!(crate::convert::source_opening_avoids_capture(&c,&internal,FreeId(0),&mut 128));let used=Closure::new(ExprId(4),frame);assert!(!crate::convert::source_opening_avoids_capture(&c,&used,FreeId(0),&mut 4096));}
+ #[test]fn unknown_or_cyclic_captured_syntax_never_earns_absence(){let(e,l,env)=fixture();let c=TypeChecker::new(&e,&l,&env);for value in[Closure::new(ExprId(999),EnvFrame::empty()),Closure::new(ExprId(5),EnvFrame::empty())]{let body=Closure::new(ExprId(1),EnvFrame::empty().extend(value));for _ in 0..2{assert!(!crate::convert::source_opening_avoids_capture(&c,&body,FreeId(0),&mut 128));}}let body=Closure::new(ExprId(4),EnvFrame::empty().extend(chain(9)));assert!(!crate::convert::source_opening_avoids_capture(&c,&body,FreeId(0),&mut 0));}
+ #[test]fn capture_absence_facts_do_not_cross_checker_source_scope(){let(e,l,env)=fixture();let c=TypeChecker::new(&e,&l,&env);let frame=EnvFrame::empty().extend(chain(9));let first=Closure::new(ExprId(1),frame.clone());assert!(crate::convert::source_opening_avoids_capture(&c,&first,FreeId(0),&mut 4096));let other=TypeChecker::new(&e,&l,&env);let second=Closure::new(ExprId(4),frame);assert!(!crate::convert::source_opening_avoids_capture(&other,&second,FreeId(0),&mut 32));}
