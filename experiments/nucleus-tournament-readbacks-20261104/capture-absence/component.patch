+    pub(crate) fn has_closed_capture_absence(&self,source:&Closure,free:FreeId)->bool{
+        self.closed_capture_absence.borrow().contains_key(&(source.expr,source.env.id(),source.levels.identity(),free))
+    }
+
+    pub(crate) fn retain_closed_capture_absence(&self,source:&Closure,free:FreeId,budget:&mut usize){
+        let key=(source.expr,source.env.id(),source.levels.identity(),free);
+        let mut facts=self.closed_capture_absence.borrow_mut();
+        if facts.contains_key(&key)||facts.len()>=8192{return;}
+        let cost=if facts.len()==facts.capacity(){facts.capacity().saturating_mul(2).saturating_add(8)}else{1};
+        if *budget<cost{return;}*budget-=cost;
+        facts.insert(key,source.clone());
+    }
