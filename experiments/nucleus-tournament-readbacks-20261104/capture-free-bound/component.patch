+    fn capture_bound_slot(source:&Closure)->usize{
+        // Indexing is independent of allocator addresses. The complete
+        // owning key, including level allocation identity, is checked below.
+        let mixed=source.expr.0.wrapping_mul(0x9e3779b97f4a7c15)
+            ^source.env.id().wrapping_mul(0xbf58476d1ce4e5b9);
+        let mixed=(mixed^(mixed>>30)).wrapping_mul(0x94d049bb133111eb);
+        ((mixed^(mixed>>31))as usize)&(CAPTURE_BOUND_SLOTS-1)
+    }
+
+    pub(crate) fn completed_capture_bound(&self,source:&Closure,query:FreeId)->Option<Option<FreeId>>{
+        let facts=self.captured_source_bounds.borrow();let slot=Self::capture_bound_slot(source);
+        for offset in 0..4{
+            if let Some(fact)=&facts[(slot+offset)&(CAPTURE_BOUND_SLOTS-1)]
+                && fact.source.expr==source.expr && fact.source.env.id()==source.env.id()
+                && fact.source.levels.identity()==source.levels.identity()
+                && (query==fact.excluded||fact.upper.is_none_or(|bound|query.0>bound.0))
+            {return Some(fact.upper);}
+        }
+        None
+    }
+
+    pub(crate) fn retain_completed_capture_bound(&self,source:&Closure,upper:Option<FreeId>,excluded:FreeId,budget:&mut usize){
+        if *budget==0{return;}*budget-=1;
+        let mut facts=self.captured_source_bounds.borrow_mut();let slot=Self::capture_bound_slot(source);let mut empty=None;
+        for offset in 0..4{
+            let i=(slot+offset)&(CAPTURE_BOUND_SLOTS-1);
+            match &facts[i]{
+                Some(fact)if fact.source.expr==source.expr&&fact.source.env.id()==source.env.id()&&fact.source.levels.identity()==source.levels.identity()=>return,
+                None if empty.is_none()=>empty=Some(i),
+                _=>{},
+            }
+        }
+        if let Some(i)=empty{facts[i]=Some(CompletedCaptureBound{source:source.clone(),upper,excluded});}
+    }
