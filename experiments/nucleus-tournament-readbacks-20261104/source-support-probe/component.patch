+
+#[derive(Default,Debug)]
+struct SourceReuseProbe { calls:u64,local_misses:u64,prior_other_checker_positive_misses:u64,finished_calls:u64,completed:std::collections::HashMap<crate::id::ExprId,usize> }
+thread_local!{static SOURCE_REUSE:std::cell::RefCell<SourceReuseProbe>=std::cell::RefCell::new(SourceReuseProbe::default());}
+pub(crate) fn new_source_checker()->usize {use std::sync::atomic::{AtomicUsize,Ordering};static EPOCH:AtomicUsize=AtomicUsize::new(1);EPOCH.fetch_add(1,Ordering::Relaxed)}
+pub(crate) fn source_support_begin(expr:crate::id::ExprId,local_hit:bool,epoch:usize){SOURCE_REUSE.with(|s|{let mut s=s.borrow_mut();s.calls+=1;if !local_hit{s.local_misses+=1;if s.completed.get(&expr).is_some_and(|e|*e!=epoch){s.prior_other_checker_positive_misses+=1;}}});}
+pub(crate) fn source_support_finish(expr:crate::id::ExprId,epoch:usize){SOURCE_REUSE.with(|s|{let mut s=s.borrow_mut();s.finished_calls+=1;if s.completed.len()<65536{s.completed.entry(expr).or_insert(epoch);}});}
+pub(crate) fn report_source_reuse(){SOURCE_REUSE.with(|s|{let s=s.borrow();eprintln!("NUCLEUS_SOURCE_REUSE_PROBE:calls={}:local_misses={}:prior_other_checker_positive_misses={}:finished_calls={}:retained_positive_roots={}",s.calls,s.local_misses,s.prior_other_checker_positive_misses,s.finished_calls,s.completed.len());});}
