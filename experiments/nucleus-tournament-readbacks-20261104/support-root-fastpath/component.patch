+#[cfg(test)]
+mod completed_support_allocation_tests {
+    use super::*;
+    use std::alloc::{GlobalAlloc,Layout,System};
+    use std::cell::Cell;
+    thread_local!{static TRACK:Cell<bool>=const{Cell::new(false)};static ALLOCS:Cell<usize>=const{Cell::new(0)};}
+    struct CountingSystem;
+    fn allocation(){let _=TRACK.try_with(|t|if t.get(){let _=ALLOCS.try_with(|c|c.set(c.get()+1));});}
+    // Test-only instrumentation delegates every allocation unchanged to System.
+    unsafe impl GlobalAlloc for CountingSystem {
+        unsafe fn alloc(&self,l:Layout)->*mut u8{allocation();unsafe{System.alloc(l)}}
+        unsafe fn alloc_zeroed(&self,l:Layout)->*mut u8{allocation();unsafe{System.alloc_zeroed(l)}}
+        unsafe fn realloc(&self,p:*mut u8,l:Layout,n:usize)->*mut u8{allocation();unsafe{System.realloc(p,l,n)}}
+        unsafe fn dealloc(&self,p:*mut u8,l:Layout){unsafe{System.dealloc(p,l)}}
+    }
+    #[global_allocator]static ALLOCATOR:CountingSystem=CountingSystem;
+    fn counted<T>(f:impl FnOnce()->T)->(T,usize){
+        struct Stop;impl Drop for Stop{fn drop(&mut self){TRACK.set(false);}}
+        ALLOCS.set(0);TRACK.set(true);let stop=Stop;let result=f();drop(stop);(result,ALLOCS.get())
+    }
+    fn fixture()->(IdTable<ExprId,Expr>,IdTable<LevelId,crate::syntax::Level>,Environment){
+        let mut e=IdTable::default();let mut l=IdTable::default();l.insert(LevelId(0),crate::syntax::Level::Zero).unwrap();
+        e.insert(ExprId(0),Expr::BVar(0)).unwrap();e.insert(ExprId(1),Expr::BVar(1)).unwrap();e.insert(ExprId(2),Expr::App{fun:ExprId(0),arg:ExprId(1)}).unwrap();e.insert(ExprId(3),Expr::Sort(LevelId(0))).unwrap();(e,l,Environment::empty())
+    }
+    #[test]fn completed_source_support_hit_has_only_result_allocation(){
+        let(e,l,env)=fixture();let c=TypeChecker::new(&e,&l,&env);assert_eq!(c.complete_source_support(ExprId(2),&mut 1024),Some(vec![0,1]));
+        let mut fuel=4;let(result,allocations)=counted(||c.complete_source_support(ExprId(2),&mut fuel));
+        assert_eq!(result,Some(vec![0,1]));assert_eq!(fuel,1);assert!(allocations<=1,"completed fact allocated {allocations} times");
+    }
+    #[test]fn closed_source_support_hit_allocates_nothing(){
+        let(e,l,env)=fixture();let c=TypeChecker::new(&e,&l,&env);assert_eq!(c.complete_source_support(ExprId(3),&mut 1024),Some(vec![]));
+        let mut fuel=1;let(result,allocations)=counted(||c.complete_source_support(ExprId(3),&mut fuel));
+        assert_eq!(result,Some(vec![]));assert_eq!(fuel,0);assert_eq!(allocations,0,"closed completed fact needs no heap work");
+    }
+    #[test]fn completed_paired_support_hit_has_only_result_allocation(){
+        let(mut e,l,env)=fixture();e.insert(ExprId(4),Expr::BVar(0)).unwrap();e.insert(ExprId(5),Expr::BVar(1)).unwrap();e.insert(ExprId(6),Expr::App{fun:ExprId(4),arg:ExprId(5)}).unwrap();let c=TypeChecker::new(&e,&l,&env);
+        assert_eq!(c.complete_paired_source_support(ExprId(2),ExprId(6),&mut 1024),Some(vec![(0,0),(1,1)]));
+        let mut fuel=4;let(result,allocations)=counted(||c.complete_paired_source_support(ExprId(2),ExprId(6),&mut fuel));
+        assert_eq!(result,Some(vec![(0,0),(1,1)]));assert_eq!(fuel,1);assert!(allocations<=1,"completed pair allocated {allocations} times");
+    }
+    #[test]fn closed_paired_support_hit_allocates_nothing(){
+        let(mut e,l,env)=fixture();e.insert(ExprId(7),Expr::Sort(LevelId(0))).unwrap();let c=TypeChecker::new(&e,&l,&env);assert_eq!(c.complete_paired_source_support(ExprId(3),ExprId(7),&mut 1024),Some(vec![]));
+        let mut fuel=1;let(result,allocations)=counted(||c.complete_paired_source_support(ExprId(3),ExprId(7),&mut fuel));assert_eq!(result,Some(vec![]));assert_eq!(fuel,0);assert_eq!(allocations,0);
+    }
