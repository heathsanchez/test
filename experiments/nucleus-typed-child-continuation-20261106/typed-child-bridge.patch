+// A source substitution equality is established from its *complete* set of
+// actually used captures. Neither identical AST text nor a successful type
+// comparison alone authorizes a value equality: each differing captured
+// value must receive an independent value-conversion proof in the real Γ.
+fn checked_used_source_capture_congruence(
+    checker:&TypeChecker<'_>,left:&Closure,right:&Closure,
+    context:&[TypeValue],allowance:usize,
+)->Judgment<()> {
+    if left.expr!=right.expr || left.levels!=right.levels {
+        return Judgment::unknown("nonidentical-source-substitution-schema");
+    }
+    let mut remaining=allowance;
+    let Some(support)=checker.complete_source_support(left.expr,&mut remaining)else{
+        return Judgment::unknown("source-substitution-support-incomplete");
+    };
+    #[cfg(feature="diagnostics")]
+    if left.expr.0==600 && context.len()==2
+        && crate::run_flags::present(crate::run_flags::Flag::TraceFailedReceiverCaptures){
+        for index in &support {
+            eprintln!("NUCLEUS_SOURCE_USED_CAPTURE_SCHEMA:expr={:?}:index={index}:left={:?}:right={:?}:remaining={remaining}",
+                left.expr,left.env.lookup_binding_ref(*index),right.env.lookup_binding_ref(*index));
+        }
+    }
+    for index in support {
+        let Some(fee)=usize::try_from(index).ok()
+            .and_then(|n|n.checked_add(1)).and_then(|n|n.checked_mul(2))else{
+            return Judgment::unknown("source-substitution-index-overflow");
+        };
+        if remaining<fee{return Judgment::unknown("source-substitution-lookup-budget");}
+        remaining-=fee;
+        let (Some(a),Some(b))=(left.env.lookup_binding_ref(index),right.env.lookup_binding_ref(index))else{
+            return Judgment::unknown("source-substitution-missing-binding");
+        };
+        match(a,b){
+            (EnvBinding::Free(a),EnvBinding::Free(b))if a==b=>{},
+            (EnvBinding::Neutral(a),EnvBinding::Neutral(b))if a==b=>{},
+            (EnvBinding::NatLit(a),EnvBinding::NatLit(b))if a==b=>{
+                let fee=a.limb_count().max(b.limb_count());
+                if remaining<fee{return Judgment::unknown("source-substitution-nat-budget");}
+                remaining-=fee;
+            },
+            (EnvBinding::Closure(a),EnvBinding::Closure(b))=>{
+                if a.expr==b.expr && a.env==b.env && a.levels==b.levels{continue;}
+                let mut proven=false;
+                for bound in [128usize,16384usize] {
+                    if remaining<bound{continue;}
+                    remaining-=bound;
+                    let judgment=checker.checked_source_conversion(a,b,context,bound);
+                    #[cfg(feature="diagnostics")]
+                    if left.expr.0==600&&crate::run_flags::present(crate::run_flags::Flag::TraceFailedReceiverCaptures){
+                        eprintln!("NUCLEUS_SOURCE_USED_CAPTURE:expr={:?}:index={index}:ctx={}:budget={bound}:result={judgment:?}",left.expr,context.len());
+                    }
+                    if judgment.is_proven(){proven=true;break;}
+                }
+                if !proven{return Judgment::unknown("source-substitution-unproven-used-capture");}
+            },
+            _=>return Judgment::unknown("source-substitution-incompatible-capture-kinds"),
+        }
+    }
+    Judgment::proven((),"checked-complete-source-substitution-congruence")
+}
