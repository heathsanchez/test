+#[derive(Clone,Eq,PartialEq,Hash)]
+struct ExactTypingKey{source:(ExprId,u64,usize),strict:bool,flags:[u64;2],epoch:u64}
+impl ExactTypingKey{
+ fn set(&self)->usize{use std::hash::{Hash,Hasher};let mut h=std::collections::hash_map::DefaultHasher::new();self.hash(&mut h);(h.finish()as usize)%2048}
+}
+struct ExactTypingFact{key:ExactTypingKey,_source:Closure,context:Vec<Closure>,result:TypeValue}
+impl ExactTypingFact{
+ fn same_context(&self,context:&[TypeValue])->bool{
+  self.context.len()==context.len()&&self.context.iter().zip(context).all(|(old,new)|matches!(new,TypeValue::Term(new)if(old.expr,old.env.id(),old.levels.identity())==(new.expr,new.env.id(),new.levels.identity())))
+ }
+
+ fn roots(&self)->Vec<&Closure>{
+  fn append<'a>(v:&'a TypeValue,out:&mut Vec<&'a Closure>){match v{TypeValue::Term(t)=>out.push(t),TypeValue::Pi{domain,body,..}=>{append(domain,out);append(body,out);},TypeValue::Sort(_)=>{}}}
+  let mut out=Vec::with_capacity(self.context.len()+65);out.push(&self._source);out.extend(self.context.iter());append(&self.result,&mut out);out
+ }
+ fn relinquishable(&self)->bool{
+  // Borrow every source/result/Γ leaf. No temporary strong owners are created.
+  let roots=self.roots();roots.iter().all(|root|{
+   let env_refs=roots.iter().filter(|c|c.env.id()==root.env.id()).count();
+   let level_refs=roots.iter().filter(|c|c.levels.identity()==root.levels.identity()).count();
+   (root.env.id()==0||root.env.strong_owners()>env_refs)
+    &&(root.levels.is_empty_instance()||root.levels.strong_owners()>level_refs)
+  })
+ }
+
+}
+struct ExactTypingMemo{slots:Box<[Option<ExactTypingFact>]>,hand:[u8;2048]}
+impl Default for ExactTypingMemo{
+ fn default()->Self{Self{slots:std::iter::repeat_with(||None).take(8192).collect::<Vec<_>>().into_boxed_slice(),hand:[0;2048]}}
+}
+impl ExactTypingMemo{fn clear(&mut self){for slot in self.slots.iter_mut(){*slot=None;}self.hand.fill(0);}}
