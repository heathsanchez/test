+// Completed virtual binders remain exact, with bounded cloning/reclamation of
+// their representation. Closure leaves share and pin actual immutable graphs.
+fn bounded_typing_result(value:&TypeValue)->bool{
+ fn step(nodes:&mut usize)->bool{if *nodes==0{false}else{*nodes-=1;true}}
+ fn level(v:&LevelTerm,nodes:&mut usize,bytes:&mut usize)->bool{
+  if !step(nodes){return false;}
+  match v{LevelTerm::Zero=>true,LevelTerm::Succ(v)=>level(v,nodes,bytes),LevelTerm::Max(a,b)|LevelTerm::IMax(a,b)=>level(a,nodes,bytes)&&level(b,nodes,bytes),LevelTerm::Param(s)=>{if s.len()>*bytes{false}else{*bytes-=s.len();true}}}
+ }
+ fn ty(v:&TypeValue,nodes:&mut usize,bytes:&mut usize)->bool{
+  if !step(nodes){return false;}
+  match v{TypeValue::Term(_)=>true,TypeValue::Sort(v)=>level(v,nodes,bytes),TypeValue::Pi{domain,body,..}=>ty(domain,nodes,bytes)&&ty(body,nodes,bytes)}
+ }
+ ty(value,&mut 64,&mut 4096)
+}
