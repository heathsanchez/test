+// Prove a bounded destruction set without changing ownership. Root counts and
+// newly removed parent/value edges are joined before any allocation is freed.
+pub(crate)fn captures_reclaimable<'a>(roots:impl Iterator<Item=&'a Closure>)->bool{
+ #[derive(Clone,Copy)]enum Allocation<'a>{Env(&'a EnvFrame),Levels(&'a LevelSubstitution)}
+ impl Allocation<'_>{
+  fn same(self,other:Self)->bool{match(self,other){(Self::Env(a),Self::Env(b))=>Rc::ptr_eq(&a.0,&b.0),(Self::Levels(a),Self::Levels(b))=>Rc::ptr_eq(&a.0,&b.0),_=>false}}
+  fn owners(self)->usize{match self{Self::Env(v)=>Rc::strong_count(&v.0),Self::Levels(v)=>Rc::strong_count(&v.0)}}
+ }
+ #[derive(Clone,Copy)]struct Removal<'a>{allocation:Allocation<'a>,removed:usize,expanded:bool}
+ struct Plan<'a>{records:[Option<Removal<'a>>;326],len:usize,nodes:usize,bytes:usize}
+ impl<'a>Plan<'a>{
+  fn add(&mut self,allocation:Allocation<'a>)->bool{
+   // Empty payloads have no graph edges. Their fixed headers are covered by
+   // the bounded root/edge count, rather than by the nontrivial-node allowance.
+   match allocation{Allocation::Env(v)if matches!(v.0.as_ref(),EnvNode::Empty)=>return true,Allocation::Levels(v)if v.0.entries.is_empty()=>return true,_=>{}}
+   for i in 0..self.len{if self.records[i].unwrap().allocation.same(allocation){self.records[i].as_mut().unwrap().removed+=1;return true;}}
+   if self.len==self.records.len(){return false;}self.records[self.len]=Some(Removal{allocation,removed:1,expanded:false});self.len+=1;true
+  }
+  fn closure(&mut self,c:&'a Closure)->bool{self.add(Allocation::Env(&c.env))&&self.add(Allocation::Levels(&c.levels))}
+  fn expand(&mut self,allocation:Allocation<'a>)->bool{
+   if self.nodes==0{return false;}self.nodes-=1;
+   match allocation{
+    Allocation::Levels(v)=>v.bounded_reclamation(&mut self.nodes,&mut self.bytes),
+    Allocation::Env(v)=>match v.0.as_ref(){
+     EnvNode::Empty=>true,
+     EnvNode::Extend{parent,value,..}=>self.add(Allocation::Env(parent))&&match value{
+      EnvBinding::Closure(c)=>self.closure(c),EnvBinding::Free(_)=>true,
+      // No unbounded neutral spine or native payload is discharged here.
+      EnvBinding::Neutral(_)|EnvBinding::NatLit(_)=>false,
+     },
+    },
+   }
+  }
+  fn finish(&mut self)->bool{
+   loop{
+    let mut progress=false;
+    for i in 0..self.len{
+     let record=self.records[i].unwrap();let owners=record.allocation.owners();
+     if record.removed>owners{return false;}
+     if !record.expanded&&record.removed==owners{
+      self.records[i].as_mut().unwrap().expanded=true;
+      if !self.expand(record.allocation){return false;}progress=true;
+     }
+    }
+    if !progress{return true;}
+   }
+  }
+ }
+ let mut plan=Plan{records:[None;326],len:0,nodes:64,bytes:4096};let mut count=0;
+ for root in roots{count+=1;if count>66||!plan.closure(root){return false;}}
+ plan.finish()
+}
