+#[cfg(test)]
+mod record_universe_bounds {
+    use super::*;
+    fn evaluate(level:&LevelTerm,u:u32,v:u32)->u32 {
+        match level {
+            LevelTerm::Zero=>0,
+            LevelTerm::Param(name)=>if name=="u" {u} else {v},
+            LevelTerm::Succ(a)=>evaluate(a,u,v)+1,
+            LevelTerm::Max(a,b)=>evaluate(a,u,v).max(evaluate(b,u,v)),
+            LevelTerm::IMax(a,b)=>if evaluate(b,u,v)==0 {0} else {evaluate(a,u,v).max(evaluate(b,u,v))},
+        }
+    }
+    #[test]
+    fn evaluation_field_fits_both_owner_universes_but_not_a_smaller_carrier() {
+        let u=LevelTerm::param("u");let v=LevelTerm::param("v");
+        let field=LevelTerm::IMax(Box::new(u.clone()),Box::new(v.clone()));
+        let carrier=crate::level::max(crate::level::max(crate::level::succ(LevelTerm::Zero),u.clone()),v);
+        assert!(!crate::level::level_equal(crate::level::max(field.clone(),carrier.clone()),carrier.clone(),4096).is_proven());
+        assert!(record_field_sort_fits(field.clone(),&carrier,4096));
+        assert!(!record_field_sort_fits(field.clone(),&LevelTerm::Zero,4096));
+        assert!(!record_field_sort_fits(field.clone(),&crate::level::succ(LevelTerm::Zero),4096));
+        assert!(!record_field_sort_fits(field,&u,4096));
+    }
+    #[test]
+    fn imax_upper_bound_remains_conservative_under_nesting_and_zero_valuations() {
+        let mut terms=vec![LevelTerm::Zero,LevelTerm::param("u"),LevelTerm::param("v")];
+        for _ in 0..2 {
+            let previous=terms.clone();
+            for a in &previous {terms.push(crate::level::succ(a.clone()));
+                for b in &previous {terms.push(LevelTerm::IMax(Box::new(a.clone()),Box::new(b.clone())));terms.push(LevelTerm::Max(Box::new(a.clone()),Box::new(b.clone())));}}
+        }
+        for term in terms {
+            let upper=record_universe_upper_bound(&term,128,&mut 4096).unwrap();
+            for u in 0..=4 {for v in 0..=4 {assert!(evaluate(&term,u,v)<=evaluate(&upper,u,v));}}
+        }
+    }
+    #[test]
+    fn upper_bound_exhaustion_never_supplies_a_witness() {
+        let term=LevelTerm::IMax(Box::new(LevelTerm::param("u")),Box::new(LevelTerm::param("v")));
+        assert!(record_universe_upper_bound(&term,128,&mut 2).is_none());
+        assert!(record_universe_upper_bound(&term,1,&mut 4096).is_none());
+        assert!(!record_field_sort_fits(term,&LevelTerm::Zero,0));
+    }
