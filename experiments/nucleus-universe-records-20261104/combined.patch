+// A sufficient pointwise upper bound: imax(a,b) is 0 when b=0,
+// and max(a,b) otherwise. Succ and max are monotone, so replacing
+// every imax by max preserves an upper bound under every valuation.
+// Exhaustion declines this extra proof route; it never supplies evidence.
+fn record_universe_upper_bound(level:&LevelTerm,depth:usize,remaining:&mut usize)->Option<LevelTerm> {
+    if depth==0 || *remaining==0 {return None;}
+    *remaining-=1;
+    Some(match level {
+        LevelTerm::Zero=>LevelTerm::Zero,
+        LevelTerm::Param(name)=>LevelTerm::Param(name.clone()),
+        LevelTerm::Succ(inner)=>crate::level::succ(record_universe_upper_bound(inner,depth-1,remaining)?),
+        LevelTerm::Max(a,b)|LevelTerm::IMax(a,b)=>crate::level::max(
+            record_universe_upper_bound(a,depth-1,remaining)?,
+            record_universe_upper_bound(b,depth-1,remaining)?),
+    })
+}
