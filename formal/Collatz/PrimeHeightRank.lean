/-- Primitive height given a certified exact prime order. -/
def strippedHeight (x : Int) (p k : Nat) : Nat := Nat.log2 (x.natAbs / p^k)+1
/-- Exact anchoring: the positive floor budget must first pay accumulated height. -/
theorem affineBudget_debt_identity (A B P L x y : Int)
    (heq : P*y=A*x+B) : affineBudget A B P L-A*(x-L)=P*(L-y) := by
  simp only [affineBudget, Int.sub_mul, Int.mul_sub]
  omega
theorem affineBudget_anchored_exit_iff (A B P L x y : Int)
    (hP : 0 < P) (heq : P*y=A*x+B) :
    y < L ↔ A*(x-L) < affineBudget A B P L := by
  have hid := affineBudget_debt_identity A B P L x y heq
  constructor
  · intro hy
    have hp : 0 < P*(L-y) := Int.mul_pos hP (by omega)
    omega
  · intro hb
    by_cases hy : y < L
    · exact hy
    · have hp : P*(L-y) ≤ 0 := Int.mul_nonpos_of_nonneg_of_nonpos (by omega) (by omega)
      omega
#print axioms affineBudget_debt_identity
#print axioms affineBudget_anchored_exit_iff
