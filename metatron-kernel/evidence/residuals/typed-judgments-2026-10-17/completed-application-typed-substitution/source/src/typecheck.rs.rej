+#[cfg(test)]
+mod application_judgment_scope_boundary {
+ use super::*;
+ #[test] fn ordinary_numeric_binder_inference_is_not_strict_source_authority(){
+  let mut e=IdTable::default();let mut l=IdTable::default();l.insert(LevelId(0),Level::Zero).unwrap();l.insert(LevelId(1),Level::Succ(LevelId(0))).unwrap();for(i,n)in[(0,Expr::Sort(LevelId(1))),(1,Expr::Const{name:NameId(1),levels:vec![]}),(2,Expr::Const{name:NameId(2),levels:vec![]}),(3,Expr::Pi{domain:ExprId(1),body:ExprId(1)}),(4,Expr::BVar(0)),(5,Expr::App{fun:ExprId(2),arg:ExprId(4)})]{e.insert(ExprId(i),n).unwrap();}
+  let env=Environment::empty().extend(NameId(1),crate::environment::ConstantDecl::axiom(vec![],ExprId(0))).unwrap().extend(NameId(2),crate::environment::ConstantDecl::axiom(vec![],ExprId(3))).unwrap();let c=TypeChecker::new(&e,&l,&env).strict_certificate_probe();let gamma=vec![TypeValue::Term(c.closure(ExprId(1),EnvFrame::empty()))];let ambient=EnvFrame::empty().extend_free(FreeId(0));
+  assert!(c.infer_in(ExprId(5),&gamma,&ambient,&mut 4096,&mut HashMap::new()).is_proven());assert!(c.consume_checked_application(&c.closure(ExprId(5),ambient),&gamma,&mut 4096).is_none(),"a bare numeric context lookup must not be promoted into checked original binder authority");
+ }
+}
