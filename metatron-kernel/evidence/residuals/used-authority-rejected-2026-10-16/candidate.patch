+#[cfg(test)]
+mod used_authority_certificate_controls {
+ use super::*;
+ fn fixture()->(IdTable<ExprId,Expr>,IdTable<LevelId,Level>,Environment){
+  let mut e=IdTable::default();e.insert(ExprId(0),Expr::BVar(0)).unwrap();e.insert(ExprId(1),Expr::Sort(LevelId(0))).unwrap();let mut l=IdTable::default();l.insert(LevelId(0),Level::Zero).unwrap();(e,l,Environment::empty())
+ }
+ #[test] fn complete_authority_reuses_only_validated_actual_dependencies(){
+  let(e,l,env)=fixture();let c=TypeChecker::new(&e,&l,&env);let owner=EnvFrame::empty().extend_free(FreeId(0));let mut domain=TypeValue::Sort(LevelTerm::Zero);for _ in 0..24 {domain=TypeValue::Pi{domain:Box::new(TypeValue::Sort(LevelTerm::Zero)),body:Box::new(domain),binder:FreeId(0),binder_owner:None};}
+  c.checked_binding_lineage.borrow_mut().insert(owner.id(),Some(CheckedBinderWitness{domain,protected_prefix:Rc::new(vec![])}));let source=c.closure(ExprId(0),owner.clone());assert!(c.source_used_capture_authority_available(&source,&mut 4096));assert!(c.source_used_capture_authority_available(&source,&mut 8),"completed exact authority predicate can be replayed from fully revalidated immutable ledger reads");
+  c.checked_binding_lineage.borrow_mut().insert(owner.id(),None);assert!(!c.source_used_capture_authority_available(&source,&mut 4096));assert!(!c.source_used_capture_authority_available(&source,&mut 0));
+ }
+ #[test] fn absent_to_witness_and_replaced_witness_introduce_new_obligations(){
+  let(e,l,env)=fixture();let c=TypeChecker::new(&e,&l,&env);let owner=EnvFrame::empty().extend_free(FreeId(0));let q=EnvFrame::empty().extend_free(FreeId(9));let source=c.closure(ExprId(0),owner.clone());assert!(c.source_used_capture_authority_available(&source,&mut 4096));
+  let witness=CheckedBinderWitness{domain:TypeValue::Term(c.closure(ExprId(1),q.clone())),protected_prefix:Rc::new(vec![])};c.checked_binding_lineage.borrow_mut().insert(owner.id(),Some(witness));c.checked_binding_lineage.borrow_mut().insert(q.id(),None);assert!(!c.source_used_capture_authority_available(&source,&mut 4096),"absent lineage cannot be treated as permanently dependency free");
+  c.checked_binding_lineage.borrow_mut().remove(&q.id());assert!(c.source_used_capture_authority_available(&source,&mut 4096));let other=EnvFrame::empty().extend_free(FreeId(10));let witness=CheckedBinderWitness{domain:TypeValue::Term(c.closure(ExprId(1),other.clone())),protected_prefix:Rc::new(vec![])};c.checked_binding_lineage.borrow_mut().insert(owner.id(),Some(witness));c.checked_binding_lineage.borrow_mut().insert(other.id(),None);assert!(!c.source_used_capture_authority_available(&source,&mut 4096),"changed original witness must invalidate prior completion");
+ }
