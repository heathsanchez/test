#!/usr/bin/env bash
set -u

if [ "$#" -gt 1 ]; then
  echo "usage: nucleus-semantic-closure [INPUT]" >&2
  exit 3
fi

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
NUCLEUS="${NUCLEUS_BIN:-$ROOT/target/release/metatron-kernel}"
FLASH="${FLASH_BIN:-$ROOT/../mathgraph-fallback/target/release/sokonanoda}"
FLASH_CONFIG="${FLASH_CONFIG:-$ROOT/../mathgraph-fallback/config.json}"

tmp=""
if [ "$#" -eq 1 ]; then
  input="$1"
else
  tmp="$(mktemp)"
  trap 'rm -f "$tmp"' EXIT
  cat >"$tmp"
  input="$tmp"
fi

"$NUCLEUS" <"$input" >/dev/null 2>/dev/null
nucleus_rc=$?

# Current-Arena bounded authority:
#   0 = qualified native ACCEPT
#   1 = qualified native REJECT
# Only epistemically incomplete outcomes are delegated.
case "$nucleus_rc" in
  0) exit 0 ;;
  1) exit 1 ;;
  2|3) ;;
  *) ;;
esac

"$FLASH" "$FLASH_CONFIG" <"$input" >/dev/null 2>/dev/null
flash_rc=$?
case "$flash_rc" in
  0) exit 0 ;;
  *) exit 1 ;;
esac
