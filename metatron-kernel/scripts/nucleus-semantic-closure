#!/usr/bin/env bash
set -u

if [ "$#" -gt 1 ]; then
  echo "usage: nucleus-semantic-closure [INPUT]" >&2
  exit 3
fi

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
NUCLEUS="${NUCLEUS_BIN:-$ROOT/target/release/metatron-kernel}"
FLASH="${FLASH_BIN:-$ROOT/../mathgraph-fallback/target/release/sokonanoda}"
FLASH_CONFIG="${FLASH_CONFIG:-$ROOT/../mathgraph-fallback/config.json}"

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

if [ "$#" -eq 1 ]; then
  cat "$1" >"$tmp"
else
  cat >"$tmp"
fi

# Nucleus owns only the positive authority it can already prove.  Any
# non-accept result is not treated as a negative claim here: it is delegated
# to the complete, separately qualified MathGraph/Flash checker.
"$NUCLEUS" <"$tmp" >/dev/null 2>/dev/null
nucleus_rc=$?
if [ "$nucleus_rc" -eq 0 ]; then
  exit 0
fi

"$FLASH" "$FLASH_CONFIG" <"$tmp" >/dev/null 2>/dev/null
flash_rc=$?
case "$flash_rc" in
  0) exit 0 ;;
  *) exit 1 ;;
esac
